#!/usr/bin/env bash

trap 'exit 130' INT

if [[ "${1-}" == "unit-tests" ]]; then
    shift
    exec dune exec --profile=dev tests/unit/unit_tests.exe -- -runner sequential "$@"
fi

if [ "$#" -ne 0 ]; then
    echo "Usage: ./run-tests [unit-tests [<unit test options>]]" >&2
    exit 1
fi

status=0
for suite in tests/*.tests; do
    echo "./test-harness $suite"
    if ! ./test-harness "$suite"; then
        status=1
    fi
done

for script in tests/*.testscript; do
    echo "Running $script"
    if ! "$script"; then
        echo "$script failed" >&2
        status=1
    fi
done

exit "$status"
