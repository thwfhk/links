(executable
 (name worker)
 (modes byte)
 (libraries links.core lwt js_of_ocaml js_of_ocaml-lwt))

; Use the same registered example paths as the public source catalogue.
(rule
 (target example-file-args)
 (action
  (with-stdout-to %{target}
   (run sed -En
    "s|^(examples/([-[:alnum:]_]+/)*[-[:alnum:]_]+\\.links)$|--file=../../\\1:/static/smalllinks/\\1|p"
    %{dep:../../tests/typecheck_examples.tests}))))

(rule
 (target worker.js)
 (deps
  (source_tree ../../lib/stdlib)
  (source_tree ../../examples))
 (action
  (run %{bin:js_of_ocaml} compile
   --file %{dep:../../prelude.links}:/static/smalllinks/lib/prelude.links
   --file %{dep:../../lib/comprehension.links}:/static/smalllinks/lib/comprehension.links
   --file ../../lib/stdlib=links:/static/smalllinks/lib/stdlib
   %{read-lines:example-file-args}
   -o %{target} %{dep:worker.bc})))

; Legacy directory targets keep the project's Dune 2.7 language version.
(rule
 (targets worker-wasm.js worker-wasm.assets)
 (deps
  (source_tree ../../lib/stdlib)
  (source_tree ../../examples)
  wasm-startup.js)
 (action
  (progn
   (run %{bin:wasm_of_ocaml} compile
    --effects=disabled
    --file %{dep:../../prelude.links}:/static/smalllinks/lib/prelude.links
    --file %{dep:../../lib/comprehension.links}:/static/smalllinks/lib/comprehension.links
    --file ../../lib/stdlib=links:/static/smalllinks/lib/stdlib
    %{read-lines:example-file-args}
    -o worker-wasm.js %{dep:worker.bc})
   (no-infer
    (with-stdout-to worker-wasm-startup.js
     (run cat wasm-startup.js worker-wasm.js)))
   (run mv worker-wasm-startup.js worker-wasm.js))))
