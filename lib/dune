(install
  (section lib)
  (files prelude.links comprehension.links)
  (package links))

(rule
  (targets prelude.links)
  (deps    %{project_root}/prelude.links)
  (action (copy %{deps} %{targets})))

(alias
  (name runtime-data)
  (deps prelude.links comprehension.links (glob_files stdlib/*.links)))
