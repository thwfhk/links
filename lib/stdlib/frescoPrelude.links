# Staged collection prelude for the Fresco frontend.

sig assert : modal [Wild] ((Bool, String) -> ())
fun assert(ok, msg) {
  if (not(ok)) debug("assertion failed: " ^^ msg) else ()
}

sig ignore : forall a. (a) -> ()
fun ignore (_) { () }

sig println : modal [Wild] ((String) -> ())
fun println(msg) {
  print(msg ^^ "\n")
}

sig concatMap : forall a, b. ((a) -> List b, List a) -> List b
fun concatMap(f, l) {
  switch (l) {
    case [] -> []
    case hd::tl -> f(hd) ++ concatMap(f, tl)
  }
}

sig map : forall a, b. ((a) -> b, List a) -> List b
fun map(f, l) {
  switch (l) {
    case []     -> []
    case hd::tl -> f(hd) :: map(f,tl)
  }
}

sig filter : forall a. ((a) -> Bool, List a) -> List a
fun filter(p, l) {
  concatMap (fun (x) {if(p(x)) [x] else []}, l)
}

sig iter : forall a, b. ((a) -> b, List a) -> ()
fun iter(f, xs) {
  switch (xs) {
    case [] -> ()
    case x :: xs -> ignore(f(x)); iter(f, xs)
  }
}

# TBD: rename this 'sortOn' to follow Haskell usage?
sig sortBy : forall a, b. modal [Wild] (((a) -> b, List a) -> List a)
fun sortBy (f, l) {
  switch (l) {
    case [] -> []
    case x::xs -> {
      var lt = filter (fun (y) {f(y) < f(x)}, xs);
      var ge = filter (fun (y) {f(y) >= f(x)}, xs);
      sortBy(f, lt) ++ [x] ++ sortBy(f, ge)
    }
  }
}

sig sortByBase : forall a, b::Row(Unl,Base). ((a) -> (| b), List a) -> List a
fun sortByBase(f, l) {
  switch (l) {
    case [] -> []
    case x::xs -> {
      var lt = filter (fun (y) {f(y) < f(x)}, xs);
      var ge = filter (fun (y) {f(y) >= f(x)}, xs);
      sortByBase(f, lt) ++ [x] ++ sortByBase(f, ge)
    }
  }
}

sig all : forall a. ((a) -> Bool, List a) -> Bool
fun all(p, l) {
   switch (l) {
     case []    -> true
     case x::xs -> p(x) && all(p, xs)
   }
}

sig and : (List Bool) -> Bool
fun and(l) {
  all(fun(x) { x }, l)
}

sig or : (List Bool) -> Bool
fun or(l) {
   switch (l) {
     case [] -> false
     case x::xs -> x || or(xs)
   }
}

sig any : forall a. ((a) -> Bool, List a) -> Bool
fun any(p, l) {
   switch (l) {
     case [] -> false
     case x::xs -> p(x) || any(p, xs)
   }
}

sig the : forall a. modal [Wild] ((List a) -> a)
fun the(l) {
  var x = hd(l);
  if (all(fun (y) { x == y }, l))
    x
  else
    error("list argument to 'the' had varying values.")
}

sig elem : forall a. modal [Wild] ((a, List a) -> Bool)
fun elem(x, l) {
  not(l==[]) && (x == hd(l) || x `elem` tl(l))
}

sig odd : (Int) -> Bool
fun odd(i)  { i `mod` 2 == 1 }
sig even : (Int) -> Bool
fun even(i) { i `mod` 2 == 0 }

sig intRange : (Int, Int) -> List Int
fun intRange(m,n) {
  sig intRangeAux : (Int, Int, List Int) -> List Int
  fun intRangeAux(m,n,result) {
    if (m == n) m::result
    else intRangeAux(m, n-1, n::result)
  }
  if (m > n) [] else intRangeAux(m,n,[])
}

#fun null(l) { l == [] }

# return element at index i of xs
sig selectElem : forall a. modal [Wild] ((List a, Int) -> a)
fun selectElem(xs, i) {
  hd(drop(i, xs))
}

# infix operator for 'selectElem'
sig !! : forall a. modal [Wild] ((List a, Int) -> a)
op xs !! n { selectElem(xs, n) }

# swap all instances of x1 and x2 in xs
sig swap : forall a. (List a, a, a) -> List a
fun swap(xs, x1, x2) {
 for (x <- xs) {
  if (x == x1) [x2]
  else if (x == x2) [x1]
  else [x]
 }
}

sig fold_left : forall a, b. ((b, a) -> b, b, List a) -> b
fun fold_left(p, u, l) {
  switch (l) {
    case [] -> u
    case x::xs -> fold_left(p, p(u, x), xs)
  }
}

sig fold_left1 : forall a. modal [Wild] (((a, a) -> a, List a) -> a)
fun fold_left1(p, l) {
  fold_left(p, hd(l), tl(l))
}

sig fold_right : forall a, b. ((a, b) -> b, b, List a) -> b
fun fold_right(f, u, l) {
  switch (l) {
    case [] -> u
    case x::xs -> f(x, fold_right(f,u,xs))
  }
}

sig fold_right1 : forall a. modal [Wild] (((a, a) -> a, List a) -> a)
fun fold_right1(f, l) {
  fold_right(f, hd(l), tl(l))
}

sig unzip : forall a, b. (List (a, b)) -> (List a, List b)
fun unzip(l) {
  switch (l) {
    case [] -> ([], [])
    case (a,b)::xs -> {
     var (c,d) = unzip(xs);
     (a :: c, b :: d)
    }
  }
}

sig zip : forall a, b. modal [Wild] ((List a, List b) -> List (a, b))
fun zip(l, r) {
  switch ((l, r)) {
    case ([], []) -> []
    case (lh::lt, rh::rt) ->
        (lh, rh) :: zip (lt, rt)
    case (_, _) -> []
  }
}

sig replicate : forall a. (Int, a) -> List a
fun replicate(n, item) {
  if (n <= 0) []
  else item :: replicate(n-1, item)
}

sig flip : forall a::Any, b::Any, c::Any. ((a, b) -> c) -> (b, a) -> c
fun flip(f) {
  fun(x,y) { f(y,x) }
}

sig curry : forall a, b, c. ((a, b) -> c) -> (a) -> (b) -> c
fun curry(f) {
  fun (x)(y) { f(x,y) }
}

sig uncurry : forall a::Any, b::Any, c::Any. ((a) -> (b) -> c) -> (a, b) -> c
fun uncurry(f) {
  fun (x, y) { f(x)(y) }
}

sig compose : forall a::Any, b::Any, c::Any. ((b) -> c, (a) -> b) -> (a) -> c
fun compose(f, g) {
  fun (x) { f(g(x)) }
}

sig id : forall a::Any. (a) -> a
fun id(x) { x }

sig first : forall a::Any, r::Row. ((1:a | r)) -> a
fun first(p)   { p.1 }
sig second : forall a::Any, r::Row. ((2:a | r)) -> a
fun second(p)  { p.2 }
sig third : forall a::Any, r::Row. ((3:a | r)) -> a
fun third(p)   { p.3 }
sig fourth : forall a::Any, r::Row. ((4:a | r)) -> a
fun fourth(p)  { p.4 }
sig fifth : forall a::Any, r::Row. ((5:a | r)) -> a
fun fifth(p)   { p.5 }
sig sixth : forall a::Any, r::Row. ((6:a | r)) -> a
fun sixth(p)   { p.6 }
sig seventh : forall a::Any, r::Row. ((7:a | r)) -> a
fun seventh(p) { p.7 }
sig eighth : forall a::Any, r::Row. ((8:a | r)) -> a
fun eighth(p)  { p.8 }
sig ninth : forall a::Any, r::Row. ((9:a | r)) -> a
fun ninth(p)   { p.9 }
sig tenth : forall a::Any, r::Row. ((10:a | r)) -> a
fun tenth(p)   { p.10 }

sig product : (List Int) -> Int
fun product(ns) {
  fold_left((*), 1, ns)
}

sig mapi : forall a, b. ((a, Int) -> b, List a) -> List b
fun mapi(f, xs) {
  sig mi : (Int, List a) -> List b
  fun mi(i, xs) {
    switch (xs) {
      case []    -> []
      case x::xs -> f(x, i) :: mi(i+1, xs)
    }
  }
  mi(0, xs)
}

sig substAt : forall a. modal [Wild] ((List a, Int, a) -> List a)
fun substAt(xs, i, y) {
  switch (xs) {
    case [] -> []
    case x::xs -> if (i <= 0) {y :: xs}
                  else {x :: substAt(xs, i-1, y)}
  }
}

sig reverse : forall a. (List a) -> List a
fun reverse(l) {
  sig aux : (List a, List a) -> List a
  fun aux(l,o) {
    switch (l) {
      case [] -> o
      case x::xs -> aux(xs, x::o)
    }
  }
  aux(l, [])
}

sig concat : forall a. (List (List a)) -> List a
fun concat(list) {
  switch (list) {
    case [] -> []
    case (x::xs) -> x ++ concat(xs)
  }
}

sig join : forall a. (List a, List (List a)) -> List a
fun join(glue,list) {
  switch (list) {
    case [] -> []
    case [x] -> x
    case (x::xs) -> x ++ glue ++ join(glue,xs)
  }
}

sig span : forall a. modal [Wild] (((a) -> Bool, List a) -> (List a, List a))
fun span(p, xs) {
  sig go : (List a, List a, (a) -> Bool) -> (List a, List a)
  fun go(acc, xs, p) {
    switch(xs) {
      case [] -> (acc, [])
      case x :: xs ->
        if (p(x)) {
          go(x :: acc, xs, p)
        } else {
          (reverse(acc), x :: xs)
        }
    }
  }
  go([], xs, p)
}

sig takeWhile : forall a. modal [Wild] (((a) -> Bool, List a) -> List a)
fun takeWhile(pred, list) {
  first(span(pred, list))
}

sig dropWhile : forall a. modal [Wild] (((a) -> Bool, List a) -> List a)
fun dropWhile(pred, list) {
  second(span(pred, list))
}

sig abs : (Int) -> Int
fun abs(i) {
  if (i < 0) -i else i
}

sig init : forall a. modal [Wild] ((List a) -> List a)
fun init(list) {
  switch (list) {
    case [y] -> []
    case (h::t) -> h::init(t)
  }
}

sig curtail : forall a. modal [Wild] ((List a) -> List a)
fun curtail(list) { init(list) }

sig last : forall a. modal [Wild] ((List a) -> a)
fun last(list) {
  switch (list) {
    case [x] -> x
    case (h::t) -> last(t)
  }
}

sig intercalate : forall a. (List a, List (List a)) -> List a
fun intercalate(bone, rushes) {
  switch (rushes) {
    case [] -> []
    case [x] -> x
    case x::xs -> x ++ bone ++ intercalate(bone, xs)
  }
}

sig unlines : modal [Wild] ((List String) -> String)
fun unlines(ws) {
  implode(intercalate(explode("\n"), map(explode, ws)))
}

sig unwords : modal [Wild] ((List String) -> String)
fun unwords(ws) {
  implode(intercalate(explode(" "), map(explode, ws)))
}
