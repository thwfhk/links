# Staged collection prelude for the Fresco frontend.

sig assert : modal [Wild] ((Bool, String) -> ())
fun assert(ok, msg) {
  if (not(ok)) debug("assertion failed: " ^^ msg) else ()
}

sig ignore : forall a. (a) -> ()
fun ignore (_) { () }

sig println : modal [Wild] ((String) -> ())
fun println(msg) {
  print(msg ^^ "\n")
}

sig concatMap : forall a, b. ((a) -> List b, List a) -> List b
fun concatMap(f, l) {
  switch (l) {
    case [] -> []
    case hd::tl -> f(hd) ++ concatMap(f, tl)
  }
}

sig map : forall a, b. ((a) -> b, List a) -> List b
fun map(f, l) {
  switch (l) {
    case []     -> []
    case hd::tl -> f(hd) :: map(f,tl)
  }
}

sig filter : forall a. ((a) -> Bool, List a) -> List a
fun filter(p, l) {
  concatMap (fun (x) {if(p(x)) [x] else []}, l)
}

sig iter : forall a, b. ((a) -> b, List a) -> ()
fun iter(f, xs) {
  switch (xs) {
    case [] -> ()
    case x :: xs -> ignore(f(x)); iter(f, xs)
  }
}

# TBD: rename this 'sortOn' to follow Haskell usage?
sig sortBy : forall a, b. modal [Wild] (((a) -> b, List a) -> List a)
fun sortBy (f, l) {
  switch (l) {
    case [] -> []
    case x::xs -> {
      var lt = filter (fun (y) {f(y) < f(x)}, xs);
      var ge = filter (fun (y) {f(y) >= f(x)}, xs);
      sortBy(f, lt) ++ [x] ++ sortBy(f, ge)
    }
  }
}

sig sortByBase : forall a, b::Row(Unl,Base). ((a) -> (| b), List a) -> List a
fun sortByBase(f, l) {
  switch (l) {
    case [] -> []
    case x::xs -> {
      var lt = filter (fun (y) {f(y) < f(x)}, xs);
      var ge = filter (fun (y) {f(y) >= f(x)}, xs);
      sortByBase(f, lt) ++ [x] ++ sortByBase(f, ge)
    }
  }
}

sig all : forall a. ((a) -> Bool, List a) -> Bool
fun all(p, l) {
   switch (l) {
     case []    -> true
     case x::xs -> p(x) && all(p, xs)
   }
}

sig and : (List Bool) -> Bool
fun and(l) {
  all(fun(x) { x }, l)
}

sig or : (List Bool) -> Bool
fun or(l) {
   switch (l) {
     case [] -> false
     case x::xs -> x || or(xs)
   }
}

sig any : forall a. ((a) -> Bool, List a) -> Bool
fun any(p, l) {
   switch (l) {
     case [] -> false
     case x::xs -> p(x) || any(p, xs)
   }
}

sig the : forall a. modal [Wild] ((List a) -> a)
fun the(l) {
  var x = hd(l);
  if (all(fun (y) { x == y }, l))
    x
  else
    error("list argument to 'the' had varying values.")
}

sig elem : forall a. modal [Wild] ((a, List a) -> Bool)
fun elem(x, l) {
  not(l==[]) && (x == hd(l) || x `elem` tl(l))
}

sig odd : (Int) -> Bool
fun odd(i)  { i `mod` 2 == 1 }
sig even : (Int) -> Bool
fun even(i) { i `mod` 2 == 0 }

sig intRange : (Int, Int) -> List Int
fun intRange(m,n) {
  sig intRangeAux : (Int, Int, List Int) -> List Int
  fun intRangeAux(m,n,result) {
    if (m == n) m::result
    else intRangeAux(m, n-1, n::result)
  }
  if (m > n) [] else intRangeAux(m,n,[])
}

#fun null(l) { l == [] }

# return element at index i of xs
sig selectElem : forall a. modal [Wild] ((List a, Int) -> a)
fun selectElem(xs, i) {
  hd(drop(i, xs))
}

# infix operator for 'selectElem'
sig !! : forall a. modal [Wild] ((List a, Int) -> a)
op xs !! n { selectElem(xs, n) }

# swap all instances of x1 and x2 in xs
sig swap : forall a. (List a, a, a) -> List a
fun swap(xs, x1, x2) {
 for (x <- xs) {
  if (x == x1) [x2]
  else if (x == x2) [x1]
  else [x]
 }
}

sig fold_left : forall a, b. ((b, a) -> b, b, List a) -> b
fun fold_left(p, u, l) {
  switch (l) {
    case [] -> u
    case x::xs -> fold_left(p, p(u, x), xs)
  }
}

sig fold_left1 : forall a. modal [Wild] (((a, a) -> a, List a) -> a)
fun fold_left1(p, l) {
  fold_left(p, hd(l), tl(l))
}

sig fold_right : forall a, b. ((a, b) -> b, b, List a) -> b
fun fold_right(f, u, l) {
  switch (l) {
    case [] -> u
    case x::xs -> f(x, fold_right(f,u,xs))
  }
}

sig fold_right1 : forall a. modal [Wild] (((a, a) -> a, List a) -> a)
fun fold_right1(f, l) {
  fold_right(f, hd(l), tl(l))
}

sig unzip : forall a, b. (List (a, b)) -> (List a, List b)
fun unzip(l) {
  switch (l) {
    case [] -> ([], [])
    case (a,b)::xs -> {
     var (c,d) = unzip(xs);
     (a :: c, b :: d)
    }
  }
}

sig zip : forall a, b. modal [Wild] ((List a, List b) -> List (a, b))
fun zip(l, r) {
  switch ((l, r)) {
    case ([], []) -> []
    case (lh::lt, rh::rt) ->
        (lh, rh) :: zip (lt, rt)
    case (_, _) -> []
  }
}

sig replicate : forall a. (Int, a) -> List a
fun replicate(n, item) {
  if (n <= 0) []
  else item :: replicate(n-1, item)
}

sig flip : forall a::Any, b::Any, c::Any. ((a, b) -> c) -> (b, a) -> c
fun flip(f) {
  fun(x,y) { f(y,x) }
}

sig curry : forall a, b, c. ((a, b) -> c) -> (a) -> (b) -> c
fun curry(f) {
  fun (x)(y) { f(x,y) }
}

sig uncurry : forall a::Any, b::Any, c::Any. ((a) -> (b) -> c) -> (a, b) -> c
fun uncurry(f) {
  fun (x, y) { f(x)(y) }
}

sig compose : forall a::Any, b::Any, c::Any. ((b) -> c, (a) -> b) -> (a) -> c
fun compose(f, g) {
  fun (x) { f(g(x)) }
}

sig id : forall a::Any. (a) -> a
fun id(x) { x }

sig first : forall a::Any, r::Row. ((1:a | r)) -> a
fun first(p)   { p.1 }
sig second : forall a::Any, r::Row. ((2:a | r)) -> a
fun second(p)  { p.2 }
sig third : forall a::Any, r::Row. ((3:a | r)) -> a
fun third(p)   { p.3 }
sig fourth : forall a::Any, r::Row. ((4:a | r)) -> a
fun fourth(p)  { p.4 }
sig fifth : forall a::Any, r::Row. ((5:a | r)) -> a
fun fifth(p)   { p.5 }
sig sixth : forall a::Any, r::Row. ((6:a | r)) -> a
fun sixth(p)   { p.6 }
sig seventh : forall a::Any, r::Row. ((7:a | r)) -> a
fun seventh(p) { p.7 }
sig eighth : forall a::Any, r::Row. ((8:a | r)) -> a
fun eighth(p)  { p.8 }
sig ninth : forall a::Any, r::Row. ((9:a | r)) -> a
fun ninth(p)   { p.9 }
sig tenth : forall a::Any, r::Row. ((10:a | r)) -> a
fun tenth(p)   { p.10 }

sig product : (List Int) -> Int
fun product(ns) {
  fold_left((*), 1, ns)
}

sig mapi : forall a, b. ((a, Int) -> b, List a) -> List b
fun mapi(f, xs) {
  sig mi : (Int, List a) -> List b
  fun mi(i, xs) {
    switch (xs) {
      case []    -> []
      case x::xs -> f(x, i) :: mi(i+1, xs)
    }
  }
  mi(0, xs)
}

sig substAt : forall a. modal [Wild] ((List a, Int, a) -> List a)
fun substAt(xs, i, y) {
  switch (xs) {
    case [] -> []
    case x::xs -> if (i <= 0) {y :: xs}
                  else {x :: substAt(xs, i-1, y)}
  }
}

sig reverse : forall a. (List a) -> List a
fun reverse(l) {
  sig aux : (List a, List a) -> List a
  fun aux(l,o) {
    switch (l) {
      case [] -> o
      case x::xs -> aux(xs, x::o)
    }
  }
  aux(l, [])
}

sig concat : forall a. (List (List a)) -> List a
fun concat(list) {
  switch (list) {
    case [] -> []
    case (x::xs) -> x ++ concat(xs)
  }
}

sig join : forall a. (List a, List (List a)) -> List a
fun join(glue,list) {
  switch (list) {
    case [] -> []
    case [x] -> x
    case (x::xs) -> x ++ glue ++ join(glue,xs)
  }
}

sig span : forall a. modal [Wild] (((a) -> Bool, List a) -> (List a, List a))
fun span(p, xs) {
  sig go : (List a, List a, (a) -> Bool) -> (List a, List a)
  fun go(acc, xs, p) {
    switch(xs) {
      case [] -> (acc, [])
      case x :: xs ->
        if (p(x)) {
          go(x :: acc, xs, p)
        } else {
          (reverse(acc), x :: xs)
        }
    }
  }
  go([], xs, p)
}

sig takeWhile : forall a. modal [Wild] (((a) -> Bool, List a) -> List a)
fun takeWhile(pred, list) {
  first(span(pred, list))
}

sig dropWhile : forall a. modal [Wild] (((a) -> Bool, List a) -> List a)
fun dropWhile(pred, list) {
  second(span(pred, list))
}

sig abs : (Int) -> Int
fun abs(i) {
  if (i < 0) -i else i
}

sig init : forall a. modal [Wild] ((List a) -> List a)
fun init(list) {
  switch (list) {
    case [y] -> []
    case (h::t) -> h::init(t)
  }
}

sig curtail : forall a. modal [Wild] ((List a) -> List a)
fun curtail(list) { init(list) }

sig last : forall a. modal [Wild] ((List a) -> a)
fun last(list) {
  switch (list) {
    case [x] -> x
    case (h::t) -> last(t)
  }
}

sig intercalate : forall a. (List a, List (List a)) -> List a
fun intercalate(bone, rushes) {
  switch (rushes) {
    case [] -> []
    case [x] -> x
    case x::xs -> x ++ bone ++ intercalate(bone, xs)
  }
}

sig unlines : modal [Wild] ((List String) -> String)
fun unlines(ws) {
  implode(intercalate(explode("\n"), map(explode, ws)))
}

sig unwords : modal [Wild] ((List String) -> String)
fun unwords(ws) {
  implode(intercalate(explode(" "), map(explode, ws)))
}

typename Maybe (a::Any) = [|Nothing | Just:a|];

sig isJust : forall a. (Maybe(a)) -> Bool
fun isJust(x) {
  switch (x) {
    case Just (x) -> true
    case Nothing -> false
  }
}

sig search : forall a. modal [Wild] (((a) -> Bool, List a) -> Maybe(a))
fun search(p,l) {
  switch (l) {
    case [] -> Nothing
    case x::xs -> if (p(x)) Just(x)
                  else search(p,xs)
  }
}

sig find : forall a. modal [Wild] (((a) -> Bool, List a) -> a)
fun find(p,l) {
  switch (l) {
    case [] -> error("Not_found")
    case x::xs -> if (p(x)) x
                  else find(p,xs)
  }
}

sig fromJust : forall a. modal [Wild] ((Maybe(a)) -> a)
fun fromJust(x) {
  switch (x) {
    case Just (x) -> x
    case Nothing -> error ("fromJust failed")
  }
}

sig fromMaybe : forall a. (Maybe(a), a) -> a
fun fromMaybe(x, y) {
  switch (x) {
    case Just (x) -> x
    case Nothing -> y
  }
}


sig empty : forall a. (List a) -> Bool
fun empty(l) {
  switch (l) {
    case [] -> true
    case _ -> false
  }
}

sig sum : (List Int) -> Int
fun sum(ns) {
  switch (ns) {
    case [] -> 0
    case n::ns -> n + sum(ns)
  }
}

sig sumF : (List Float) -> Float
fun sumF(ns) {
  switch (ns) {
    case [] -> 0.0
    case n::ns -> n +. sumF(ns)
  }
}

sig avg : (List Int) -> Float
fun avg(l) {
  switch (l) {
    case [] -> 0.0
    case n::ns -> intToFloat(sum(l)) /. intToFloat(length(l))
  }
}

sig avgF : (List Float) -> Float
fun avgF(l) {
  switch (l) {
    case [] -> 0.0
    case n::ns -> sumF(l) /. intToFloat(length(l))
  }
}

# Returns the minimum of a and b.
sig minimum : forall a. (a, a) -> a
fun minimum(a,b) {
  if (a < b) { a }
  else { b }
}

# Returns the maximum of a and b.
sig maximum : forall a. (a, a) -> a
fun maximum(a,b) {
  if (a > b) { a }
  else { b }
}

sig max_list : (List Int) -> Int
fun max_list(ns) {
  switch (ns) {
    case [] -> min_int
    case n::ns -> maximum(n, max_list(ns))
 }
}

sig maxF_list : (List Float) -> Float
fun maxF_list(ns) {
  switch (ns) {
    case [] -> neg_infinity
    case n::ns -> maximum(n, maxF_list(ns))
  }
}

sig min_list : (List Int) -> Int
fun min_list(ns) {
  switch (ns) {
    case [] -> max_int
    case n::ns -> minimum(n, min_list(ns))
  }
}

sig minF_list : (List Float) -> Float
fun minF_list(ns) {
  switch (ns) {
    case [] -> infinity
    case n::ns -> minimum(n, minF_list(ns))
  }
}

# association lists
# TBD: memassoc is an old LISP word. Perhaps a more modern name would fit better?
sig memassoc : forall a, b. modal [Wild] ((a, List (a,b)) -> Bool)
fun memassoc(x,l) {
  switch (l) {
    case []    -> false
    case (k,v)::xs -> k == x || memassoc(x, xs)
  }
}

sig lookup : forall a, b. modal [Wild] ((a, List (a,b)) -> Maybe(b))
fun lookup(x,l) {
  switch (l) {
    case [] -> Nothing
    case (a,b)::xs -> if (a == x) Just(b)
                      else lookup(x,xs)
  }
}

sig assoc : forall b. modal [Wild] ((String, List (String,b)) -> b)
fun assoc(x,l) {
  switch (l) {
    case []    -> error("Not found " ^^ x)
    case (k,v)::xs -> if (k == x) v
                      else assoc(x, xs)
  }
}

sig assocDefault : forall b. modal [Wild] ((String, List (String,b), b) -> b)
fun assocDefault(x,l,d) {
  switch (l) {
    case []    -> d
    case (k,v)::xs -> if (k == x) v
                      else assocDefault(x, xs, d)
  }
}

sig removeAssoc : forall a, b. modal [Wild] ((a, List (a,b)) -> List (a,b))
fun removeAssoc(x,l) {
  switch (l) {
    case [] -> []
    case (k,v)::xs -> if(k == x) xs
                      else (k,v)::removeAssoc(x, xs)
  }
}

sig assocAll : forall b. modal [Wild] ((String, List (String,b)) -> List b)
fun assocAll(x,l) {
  switch (l) {
    case []    -> []
    case (k,v)::xs -> if (k == x)
                        (v::assocAll(x,xs))
                      else
                        assocAll(x,xs)
  }
}

sig isInt : (String) -> Bool
fun isInt (x) { x =~ /-?[0-9]+$/ }

sig isFloat : (String) -> Bool
fun isFloat (x) { x =~ /-?[0-9]+(\.[0-9]+)?$/ }

sig concatMapKey : forall a, c, d. ((a) -> List c, List (a,List d)) -> List c
fun concatMapKey(f, l) {
  for (x <- l) f(x.1)
}

sig lookupG : forall a, b. (a,List (a,List b)) -> List b
fun lookupG(x,l) {
  switch (l) {
    case [] -> []
    case (a,b)::xs -> if (a == x) b
                      else lookupG(x,xs)
  }
}

sig aggBy : forall a, b, d. (List (a,List b), (List b) -> d) -> List (a,d)
fun aggBy(q, agg) {
  concatMapKey(fun (k) {
    [(k, agg(lookupG(k, q)))]
    }, q)
}

typename Either(a::Any,b::Any) = [|Left:a | Right:b|];
typename Zero = [||];
typename Pid(a::Type(Any,Any,Abs)) = Process(a);

sig pureE : forall a. (a) -> Maybe(a)
fun pureE(x) { Just(x) }

sig applyE : forall a, b. (Maybe((a) -> b), Maybe(a)) -> Maybe(b)
fun applyE(f, x) {
  switch ((f, x)) {
    case (Just(f), Just(x)) -> Just(f(x))
    case (_      , _      ) -> Nothing
  }
}

sig $ : forall a, c. ((a) -> c, a) -> c
op f $ x { f(x) }

sig lf : forall a, b. ((a) -> b) -> (a) -@ b
fun lf(f) {
  linfun(x) {
    f(x)
  }
}

infixr 9 -<-;
sig -<- : forall a, b, c. ((a) -> b, (c) -> a) -> (c) -> b
op f -<- g {
  fun(x) { f(g(x)) }
}

infixr 9 ->-;
sig ->- : forall a, b, c. ((a) -> b, (b) -> c) -> (a) -> c
op f ->- g {
  g -<- f
}

## Utility functions
# Returns Just the index of x in xs if x is an element in xs, otherwise Nothing.
sig elemIndex : forall a. modal [Wild] ((a, List a) -> Maybe(Int))
fun elemIndex(x, xs) {
  var n = fold_left(fun(acc, y) {
    switch (acc) {
       case (n,Just(i)) -> (n,Just(i))
       case (n,Nothing) -> if (x == y) { (n, Just(n)) } else { (n+1,Nothing) }
    }
  }, (0,Nothing), xs);

  second(n)
}

####

sig partition : forall a. modal [Wild] (((a) -> Bool, List a) -> (List a, List a))
fun partition(pred, xs) {
  sig go : (List a, List a, List a) -> (List a, List a)
  fun go(ayes, noes, xs) {
    switch(xs) {
      case [] -> (ayes, noes)
      case x :: xs ->
        if (pred(x)) {
          go(x :: ayes, noes, xs)
        } else {
          go(ayes, x :: noes, xs)
        }
    }
  }
  go([], [], xs)
}

sig groupByFlat : forall a, c. ((a) -> c, List a) -> List (c, List a)
fun groupByFlat(project, ts) {
  for(t <- ts)
    [(project(t),for (u <- ts) where (project(t) == project(u)) [u])]
}

# Operations on (ASCII) characters
sig isLower : (Char) -> Bool
fun isLower(ch) {
  var c = ord(ch);
  (97 <= c && c <= 122) # ord('a') = 97, ord('z') = 122
}

sig isUpper : (Char) -> Bool
fun isUpper(ch) {
  var c = ord(ch);
  (65 <= c && c <= 90) # ord('A') = 65, ord('Z') = 90
}

sig isAlpha : (Char) -> Bool
fun isAlpha(ch) {
  isLower(ch) || isUpper(ch)
}

sig isDigit : (Char) -> Bool
fun isDigit(ch) {
  var c = ord(ch);
  (48 <= c && c <= 57)
}

sig isAlnum : (Char) -> Bool
fun isAlnum(ch) {
 isAlpha(ch) || isDigit(ch)
}

sig isXDigit : (Char) -> Bool
fun isXDigit(ch) {
  isDigit(ch)
  || ({ var c = ord(ch);
        (65 <= c && c <= 70)        # ord('F') = 70
        || (97 <= c && c <= 102) }) # ord('f') = 102
}

sig isBlank : (Char) -> Bool
fun isBlank(ch) {
  var c = ord(ch);
  c == 32 || c == 9 # ord(' ') = 32, ord('\t') = 9
}

# Implements the behaviour of Char.uppercase_ascii in OCaml.
sig toUpper : (Char) -> Char
fun toUpper(ch) {
  if (isLower(ch)) {
    chr(ord(ch) - 32)
  } else ch
}

# Implements the behaviour of Char.lowercase_ascii in OCaml.
sig toLower : (Char) -> Char
fun toLower(ch) {
  if (isUpper(ch)) {
    chr(ord(ch) + 32)
  } else ch
}

### Date / Time functions

# UTC Time Accessors

sig utcYear : (DateTime) -> Int
fun utcYear(dt) { dateYear(dt, 0) }

sig utcDay : (DateTime) -> Int
fun utcDay(dt) { dateDay(dt, 0) }

sig utcMonth : (DateTime) -> Int
fun utcMonth(dt) { dateMonth(dt, 0) }

sig utcHours : (DateTime) -> Int
fun utcHours(dt) { dateHours(dt, 0) }

sig utcMinutes : (DateTime) -> Int
fun utcMinutes(dt) { dateMinutes(dt) }

sig utcSeconds : (DateTime) -> Int
fun utcSeconds(dt) { dateSeconds(dt) }

sig utcMilliseconds : (DateTime) -> Int
fun utcMilliseconds(dt) { dateMilliseconds(dt) }

# Local time accessors (Note that these are impure since we use utcOffset() to
# get the currently-set UTC offset to convert from UTC to local time)

sig localYear : modal [Wild] ((DateTime) -> Int)
fun localYear(dt) { dateYear(dt, utcOffset()) }

sig localDay : modal [Wild] ((DateTime) -> Int)
fun localDay(dt) { dateDay(dt, utcOffset()) }

sig localMonth : modal [Wild] ((DateTime) -> Int)
fun localMonth(dt) { dateMonth(dt, utcOffset()) }

sig localHours : modal [Wild] ((DateTime) -> Int)
fun localHours(dt) { dateHours(dt, utcOffset()) }

sig localMinutes : modal [Wild] ((DateTime) -> Int)
fun localMinutes(dt) { dateMinutes(dt) }

sig localSeconds : modal [Wild] ((DateTime) -> Int)
fun localSeconds(dt) { dateSeconds(dt) }

sig localMilliseconds : (DateTime) -> Int
fun localMilliseconds(dt) { dateMilliseconds(dt) }

# Default serialisation of DTs at the moment is in local time,
# so `showLocal` is just a specialisation of the default `show`
# function.
sig showLocal : modal [Wild] ((DateTime) -> String)
fun showLocal(dt) {
    show(dt)
}

#### SESSION TYPING STUFF ####
sig fork : forall s::Type(Any,Session,Abs).
  modal [Wild] ((modal [Wild] ((s) -> ())) -> ~s)
fun fork(f) {
  var ap = new();
  var _ = spawnAngel { f(accept(ap)) };
  request(ap)
}

sig linFork : forall s::Type(Any,Session,Abs).
  modal [Wild] ((modal [Wild] ((s) -@ ())) -> ~s)
fun linFork(f) {
  var ap = new();
  var _ = spawnAngel { f(accept(ap)) };
  request(ap)
}

sig reproduce : forall s::Type(Any,Session,Abs).
  modal [Wild] ((AP(s), modal [Wild] ((s) -> ())) -> ())
fun reproduce(ap, f) {
  var x = accept(ap);
  var _ = spawn { f(x) };
  reproduce(ap, f)
}

sig connect : forall s::Type(Any,Session,Abs), a::Type(Unl,Any,Any).
  modal [Wild] ((modal [Wild] ((s) -> ()), (~s) -> a) -> a)
fun connect(f, g) {
  var ap = new();
  var done = new();
  var _ = spawn {
    f(accept(ap));
    close(send((), accept(done)))
  };
  var result = g(request(ap));
  var (_, s) = receive(request(done));
  close(s);
  result
}

### sessions with split ends ###
typename EndBang = !().End;
typename EndQuery = ?().End;

sig wait : modal [Wild] ((EndQuery) -> ())
fun wait(s) {
  var (_, s) = receive(s);
  close(s)
}

sig closeBang : modal [Wild] ((EndBang) -> ())
fun closeBang(s) {
  close(send((), s))
}

sig makeEndBang : modal [Wild] (() -> EndBang)
fun makeEndBang() {
  var ap = new();
  var _ = spawn {
    var c = accept(ap);
    wait(c)
  };
  request(ap)
}

sig linkSync : forall s::Type(Any,Session,Any).
  modal [Wild] ((s, ~s) -> EndBang)
fun linkSync(s, c) {
  link(s, c);
  makeEndBang()
}

sig forkSync : forall s::Type(Any,Session,Abs).
  modal [Wild] ((modal [Wild] ((s) -> EndBang)) -> ~s)
fun forkSync(f) {
  var ap = new();
  var _ = spawn {
    var c = accept(ap);
    var c = f(c);
    closeBang(c)
  };
  request(ap)
}

sig linForkSync : forall s::Type(Any,Session,Abs).
  modal [Wild] ((modal [Wild] ((s) -@ EndBang)) -> ~s)
fun linForkSync(f) {
  var ap = new();
  var _ = spawn {
    var c = accept(ap);
    var c = f(c);
    closeBang(c)
  };
  request(ap)
}

sig runSync : forall a::Type(Unl,Any,Abs).
  modal [Wild] ((modal [Wild] ((!a.EndBang) -> EndBang)) -> a)
fun runSync(f) {
  var c = forkSync(f);
  var (v, c) = receive(c);
  wait(c);
  v
}
