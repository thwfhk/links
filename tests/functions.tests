Linearity (1)
fun (x, y) {(x, y)}
stdout : fun : (a::Any, b::Any) -> (a::Any, b::Any)

Linearity (2)
fun (x) {fun (y) {(x, y)}}
stdout : fun : (a) -> (b::Any) -> (a, b::Any)

Linearity (3) (#795)
fun (x)(y) {(x, y)}
stdout : fun : (a) -> (b::Any) -> (a, b::Any)

Linearity (4)
linfun (x){ linfun (y) {(x, y)}}
stdout : fun : (a::Any) -@ (b::Any) -@ (a::Any, b::Any)

Linearity (5)
linfun (x)(y) {(x, y)}
stdout : fun : (a::Any) -@ (b::Any) -@ (a::Any, b::Any)

Linearity (6) (#797)
fun f(x)(y) {(x, y)} f
stdout : fun : [] ((a) -> (b::Any) -> (a, b::Any))

Linearity (7) (#797)
fun f(x)(y) {f(x)(y)} f
stdout : fun : [] ((_) -> (_::Any) -> _::Any)

Linearity (8) (#797)
linfun f(x)(y) {(x, y)} f
stdout : fun : [] ((a::Any) -@ (b::Any) -@ (a::Any, b::Any))

