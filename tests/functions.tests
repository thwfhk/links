# Deferred: construction and returned calls have independent contexts.
Linearity (7) (#797)
fun f(x)(y) {f(x)(y)} f
stdout : fun : (_) -> (_::Any) ~> _::Any
args : --set=fresco=false

Linearity (8) (#797)
linfun f(x)(y) {(x, y)} f
stdout : fun : (a::Any) -@ (b::Any) -@ (a::Any, b::Any)
args : --fresco

Linearity (9) - linear recursive functions should be disallowed
sig f:forall a::Any,b::Any.(a)-@b linfun f(x) {f(x)} f
stderr : @.*Type error: Type does not satisfy its kind or usage requirement.*In expression: linfun f.*
exit : 1
args : --fresco

A monomorphic local function can use a persistent inferred function
{var f=id(id); sig g:(Int)->Int fun g(x){f(x)} g(42)}
stdout : 42 : Int
args : --fresco

An ordinary nested closure cannot capture a linear argument
(fun(x){fun(y){(x,y)}})(linfun(){42})
exit : 1
stderr : @.*Type error: Type does not satisfy its kind or usage requirement.*
args : --fresco

An ordinary curried closure cannot capture a linear argument
(fun(x)(y){(x,y)})(linfun(){42})
exit : 1
stderr : @.*Type error: Type does not satisfy its kind or usage requirement.*
args : --fresco

An ordinary named curried closure cannot capture a linear argument
fun pair(x)(y){(x,y)} pair(linfun(){42})
exit : 1
stderr : @.*Type error: Type does not match the required type \(consistency\).*In expression: pair\.
args : --fresco

A linear curried closure retains a linear captured argument
var pair=linfun(x){linfun(y){(x,y)}}; var inner=pair(linfun(){42}); switch(inner(())){case(k,()) -> k()}
stdout : 42 : Int
args : --fresco

Tuple aliases and identities retain linear field types
typename Bar(a::Any,b::Any,c::Any)=(a,b,c); sig identity:forall a::Any,b::Any,c::Any.(Bar(a,b,c))->Bar(a,b,c) fun identity(x){x} var result=identity((linfun(){42},true,"two")); switch(result){case(k,b,s) -> (k(),b,s)}
stdout : (42, true, "two") : (Int, Bool, String)
args : --fresco
