Base row types
fun (rows : List (id:Int|r::Base)) { for (x <- rows) where (x.id == 42) [x] }
stdout : fun : (List (id:Int|a::Base)) -> List (id:Int|a::Base)

Onetuple with unit
(1=())
stdout : (1 = ()) : (1:())

Alias record functional update
tests/roundtrip/record_update.links
filemode : true
stdout : (q = [3, 1, 2]) : Q

Recursive interface in an absolute modality
effect Rec { Then : ([Rec] (() -> ())) => (); } sig work : [Rec] (() -> ()) fun work() { do Then(work) } work
stdout : fun : [Rec] (() -> ())

A pure failure can use the empty context
fun f() { error("") } f
stdout : fun : [] (() -> _)

Nested list and modal element types retain parentheses with the roundtrip printer
sig f : (List (List ([] (Int -> Int)))) -> List (List ([] (Int -> Int))) fun f(xs) { xs } ~f
args : --set=types_pretty_printer_engine=roundtrip
stdout : fun : [] ((List (List ([] ((Int) -> Int)))) -> List (List ([] ((Int) -> Int))))

Nested list and modal element types retain parentheses with the old printer
sig f : (List (List ([] (Int -> Int)))) -> List (List ([] (Int -> Int))) fun f(xs) { xs } ~f
args : --set=types_pretty_printer_engine=old
stdout : fun : [] ((List (List ([] ((Int) -> Int)))) -> List (List ([] ((Int) -> Int))))

Recursive list element types retain parentheses with the roundtrip printer
sig f : () -> List (mu t. (|Leaf|More:t|)) fun f() { [] } ~f
args : --set=types_pretty_printer_engine=roundtrip
stdout : fun : [] (() -> List (mu a.(|Leaf|More:a|)))

Recursive list element types retain parentheses with the old printer
sig f : () -> List (mu t. (|Leaf|More:t|)) fun f() { [] } ~f
args : --set=types_pretty_printer_engine=old
stdout : fun : [] (() -> List (mu a . (|Leaf|More:a|)))

A shadowed type alias expands with the roundtrip printer
typename T = Int; var x = (1 : T); typename T = Bool; x
args : --set=types_pretty_printer_engine=roundtrip
stdout : 1 : Int

A shadowed type alias expands with the old printer
typename T = Int; var x = (1 : T); typename T = Bool; x
args : --set=types_pretty_printer_engine=old
stdout : 1 : Int

A bare primitive name cannot name an opened alias with the roundtrip printer
module M { typename Int = Bool; } open M; var x = (true : M.Int); module M { typename Int = String; } x
args : --set=types_pretty_printer_engine=roundtrip
stdout : true : Bool

A bare primitive name cannot name an opened alias with the old printer
module M { typename Int = Bool; } open M; var x = (true : M.Int); module M { typename Int = String; } x
args : --set=types_pretty_printer_engine=old
stdout : true : Bool

Shadowed aliases in a type error with the roundtrip printer
typename T = Int; sig f : T -> T fun f(x) { x } typename T = Bool; sig g : T -> T fun g(x) { x } if (true) f else g
args : --set=types_pretty_printer_engine=roundtrip
exit : 1
stderr : @.*Type error: Expected \[\] \(\(Int\) -> Int\), got \[\] \(\(T\) -> T\)\nIn expression: if \(true\) f else g\..*

Shadowed aliases in a type error with the old printer
typename T = Int; sig f : T -> T fun f(x) { x } typename T = Bool; sig g : T -> T fun g(x) { x } if (true) f else g
args : --set=types_pretty_printer_engine=old
exit : 1
stderr : @.*Type error: Expected \[\] \(\(Int\) -> Int\), got \[\] \(\(T\) -> T\)\nIn expression: if \(true\) f else g\..*

A shadowed non-regular recursive alias with the roundtrip printer
typename Expr(a::Abs) = (|Leaf:a|More:Expr(List(a))|); sig f : () -> Expr(Int) fun f() { Leaf(1) } typename Expr(a::Abs) = Bool; ~f
args : --set=types_pretty_printer_engine=roundtrip
stdout : @fun : .*Leaf:Int.*Expr.*out of scope.*

A shadowed non-regular recursive alias with the old printer
typename Expr(a::Abs) = (|Leaf:a|More:Expr(List(a))|); sig f : () -> Expr(Int) fun f() { Leaf(1) } typename Expr(a::Abs) = Bool; ~f
args : --set=types_pretty_printer_engine=old
stdout : @fun : .*Leaf:Int.*Expr.*out of scope.*

Printing a shadowed recursive alias stops when its arguments duplicate types
typename Pair(a::Abs) = (a,a); typename Expr(a::Abs) = (|Leaf:a|More:Expr(Pair(a))|); sig f : () -> Expr(Int) fun f() { Leaf(1) } typename Expr(a::Abs) = Bool; ~f
args : --set=types_pretty_printer_engine=roundtrip
stdout : @fun : .*Leaf:Int.*Expr.*out of scope.*
