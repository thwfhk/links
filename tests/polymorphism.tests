Let polymorphism [1]
fun pair(x) { (x, x) } (pair('a'), pair(13))
stdout : @\(\('a', 'a'\), \(13, 13\)\) : .*

Let polymorphism [2]
{fun pair(x) { (x, x) } (pair('a'), pair(13))}
stdout : @\(\('a', 'a'\), \(13, 13\)\) : .*

Monomorphic lambda bindings
(fun (p) { (p('a'), p(13))})(fun (x) { (x,x) })
stderr : @..*
exit : 1

No polymorphic recursion without signatures
fun f(x) { ignore(f("a")); ignore(f(1)); 1}
stderr : @..*
exit : 1

Polymorphic recursion with signatures
sig f : forall a. a -> Int fun f(x) { ignore(f("a")); ignore(f(1)); 1 } f
stdout : @fun : \[\] \(\(_\) -> Int\)

Invalid "polymorphic recursion"
sig f : forall a. a -> Int fun f(x) { x == 1; f("a"); f(1); 1 }
stderr : @..*
exit : 1

Polymorphic mutual recursion [1]
mutual { sig f : forall a. a -> Int fun f(x) { ignore(g("a")); ignore(g(1)); 1 } sig g : forall a. a -> Int fun g(x) { ignore(f("a")); ignore(f(1)); 1 } } f
stdout : @fun : \[\] \(\(_\) -> Int\)

Polymorphic mutual recursion [2]
mutual { sig f : forall a. a -> Int fun f(x) { ignore(f("a")); ignore(g(1)); 1 } sig g : forall a. a -> Int fun g(x) { ignore(g("a")); ignore(f(1)); 1 } } f
stdout : @fun : \[\] \(\(_\) -> Int\)

Polymorphic mutual recursion [3]
mutual { sig f : forall a. a -> Int fun f(x) { ignore(f("a")); ignore(f(1)); ignore(g("a")); ignore(g(1)); 1 } sig g : forall a. a -> Int fun g(x) { ignore(f("a")); ignore(f(1)); ignore(g("a")); ignore(g(1)); 1 } } f
stdout : @fun : \[\] \(\(_\) -> Int\)

Polymorphic mutual recursion [4]
mutual { sig f : forall a. a -> Int fun f(x) { ignore(g("a")); ignore(g(1)); 1 } sig g : forall a. a -> Int fun g(x) { ignore(x == 1); ignore(f("a")); ignore(f(1)); 1 } } f
stderr : @..*
exit : 1

Polymorphic row recursion
sig h : forall r::Row. ((| r)) -> Int fun h(x) {h((x,x))} h
stdout : fun : [] (((|_)) -> Int)

Polymorphic functions
fun cons(x,l) {[x] ++ l} (cons(5, [6]), cons("a", ["b"]))
stdout : ([5, 6], ["a", "b"]) : (List Int, List String)

Polymorphic functions in different function bodies
fun cons(x,l) {[x] ++ l} fun f() { cons(5, [6]) } fun g() { cons("a", ["b"]) } (f(), g())
stdout : ([5, 6], ["a", "b"]) : (List Int, List String)

Signatures on top-level variables
sig x : Int var x = 3; x
stdout : 3 : Int

Value restriction [1]
sig f : forall a. a -> a var f = (fun(x) { x })(fun(x) { x }); f
stderr : @..*
exit : 1

Polymorphic result of an operation in a function
effect Reader(a::Abs) { Read : () => a; } sig foo : forall a::Abs. [Reader(a)] (() -> a) fun foo() {var x = do Read; x} (handle(foo()) {case <Read => k> -> k(42)}, handle(foo()) {case <Read => k> -> k(true)})
stdout : (42, true) : (Int, Bool)

Overly general signatures
sig id : (a) -> b fun id(x) {x}
stderr : @..*
exit : 1

Same-context callbacks in curried recursive functions
fun zipwith(f)(xs)(ys) {switch ((xs, ys)) {case ((x::xs),(y::ys)) -> (f(x)(y))::(zipwith(f)(xs)(ys)) case _ -> []}} zipwith
stdout : fun : [] (((a) -> (b) -> c) -> (List a) -> (List b) -> List c)

Polymorphic function parameters (unannotated)
fun (f) {(f(42), f(true))}
stderr : @..*
exit : 1

Polymorphic function parameters (annotated)
