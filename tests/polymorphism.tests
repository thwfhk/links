# Legacy compatibility: The general callback and returned-call contexts are independent of construction.
Polymorphic effects for curried recursive functions
fun zipwith(f)(xs)(ys) {switch ((xs, ys)) {case ((x::xs),(y::ys)) -> (f(x)(y))::(zipwith(f)(xs)(ys)) case _ -> []}} zipwith
stdout : fun : ((a::Any) ~b~> (c::Any) ~b~> d) -> (List a::Any) -> (List c::Any) ~b~> List d

