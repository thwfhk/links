Composing two relative callbacks
effect Alpha { A : () => (); } effect Beta { B : () => (); } sig alpha : (<Alpha> (() -> Int)) -> Int fun alpha(m) { handle(m()) { case <A => k> -> k(()) } } sig beta : (<Beta> (() -> Int)) -> Int fun beta(m) { handle(m()) { case <B => k> -> k(()) } } alpha(fun() { do A; beta(fun() { do B; 42 }) })
stdout : 42 : Int

