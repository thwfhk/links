module A {
  module B {
    mutual {
      sig foo : (Bool) -> String
      fun foo(bool_val) { if (bool_val) { baz() } else { bar() } }
      sig bar : () -> String
      fun bar() { "Hello!" }
      sig baz : () -> String
      fun baz() { foo(false) }
    }
  }

  fun foo(bool_val) { B.foo(bool_val) }
}

fun foo() {
  A.foo(true)
}

foo()
