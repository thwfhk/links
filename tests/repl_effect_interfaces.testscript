#!/usr/bin/env bash

if ! output=$(./links 2>&1 <<'EOF'
effect Reader { Ask : () => Missing; }
effect Reader { Ask : () => Int; }
effect Callback { Run : ([Reader] (() -> Int)) => Int; }
effect Reader { Ask : () => Int; }
EOF
); then
    echo "FAILURE: The effect interface REPL session exited with an error"
    printf '%s\n' "$output"
    exit 1
fi

if [[ "$output" != *"Unbound type constructor Missing"*"Module Error: Duplicate operation Ask"* ]] ||
    [[ $(printf '%s\n' "$output" | grep -c '^<stdin>:') != 2 ]]; then
    echo "FAILURE: The REPL did not accept the corrected declaration and reject the duplicate"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: The REPL accepted the corrected interface and rejected the duplicate operation"

if ! output=$(./links --path=tests/modules 2>&1 <<'EOF'
open import Effect_identity;
var first = readEffect;
open import Effect_identity;
var second = readEffect;
var wrong = handle(first()) { case <Ask => k> -> k(9) };
handle(second()) { case <Ask => k> -> k(43) };
open import Effect_identity;
var mixed = if (true) first else second;
handle(readEffect()) { case <Ask => k> -> k(44) };
EOF
); then
    echo "FAILURE: The repeated import REPL session exited with an error"
    printf '%s\n' "$output"
    exit 1
fi

if [[ "$output" != *'The modalities require different effect contexts'*$'43 : Int'*'Type error: Expected'*$'44 : Int' ]] ||
    [[ $(printf '%s\n' "$output" | grep -c '^<stdin>:') != 2 ]]; then
    echo "FAILURE: The REPL did not keep the declarations from successive imports distinct"
    printf '%s\n' "$output"
    exit 1
fi

hidden_types='Expected \[Effect_identity\.Reader \(out of scope, declaration ([0-9]+)\)\][^,]*, got \[Effect_identity\.Reader \(out of scope, declaration ([0-9]+)\)\]'
if [[ ! "$output" =~ $hidden_types ]] || [[ "${BASH_REMATCH[1]}" == "${BASH_REMATCH[2]}" ]]; then
    echo "FAILURE: The REPL diagnostic did not distinguish hidden declarations from repeated imports"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: The REPL kept successive imports distinct and identified both hidden declarations"

for engine in roundtrip old; do
    if ! output=$(./links --set=types_pretty_printer_engine="$engine" 2>&1 <<'EOF'
module Library { effect Reader { Ask : () => Int; } typename Thunk = [Reader] (() -> Int); sig read : Thunk fun read() { do Ask } }
var previous = Library.read;
module Library { effect Reader { Ask : () => Int; } typename Thunk = [Reader] (() -> Int); }
previous;
var wrong = (previous : Library.Thunk);
EOF
    ) || ! grep -Eq '^fun : \[Library\.Reader \(out of scope, declaration [0-9]+\)\] \(\(\) -> Int\)$' <<< "$output" ||
        [[ "$output" != *'The modalities require different effect contexts'* ]] ||
        [[ $(grep -c '^<stdin>:' <<< "$output") != 1 ]]; then
        echo "FAILURE: The REPL lost the hidden interface behind a shadowed alias with the $engine printer"
        printf '%s\n' "$output"
        exit 1
    fi

    echo "SUCCESS: The REPL showed the hidden interface behind a shadowed alias with the $engine printer"
done

scratch=$(mktemp -d "${TMPDIR:-/tmp}/links-effect-interfaces.XXXXXX") || exit 1
trap 'rm -rf "$scratch"' EXIT

cat > "$scratch/prelude.links" <<'PRELUDE'
effect PreludeReader { PreludeAsk : () => Int; }

module PreludeEffects {
  effect Reader { Ask : () => Int; }

  sig read : [Reader] (() -> Int)
  fun read() { do Ask }
}
PRELUDE

if ! output=$(./links --set=prelude="$scratch/prelude.links" \
    -e 'handle(do PreludeAsk) { case <PreludeAsk => k> -> k(42) }' \
    -e 'handle(PreludeEffects.read()) { case <PreludeEffects.Ask => k> -> k(43) }' 2>&1) ||
    [[ "$output" != $'42 : Int\n43 : Int' ]]; then
    echo "FAILURE: Isolated inputs did not start with the prelude interface scope"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: Isolated inputs can use interfaces declared in the prelude"

cat > "$scratch/first.links" <<'FIRST'
effect SessionReader { SessionAsk : () => Int; }

sig read : [SessionReader] (() -> Int)
fun read() { do SessionAsk }
FIRST
cat > "$scratch/second.links" <<'SECOND'
handle(read()) { case <SessionAsk => k> -> k(42) }
SECOND

if ! output=$(./links --set=isolation=false "$scratch/first.links" "$scratch/second.links" 2>&1) ||
    [[ "$output" != $'() : ()\n42 : Int' ]]; then
    echo "FAILURE: Successive files did not share their interface declarations"
    printf '%s\n' "$output"
    exit 1
fi

if output=$(./links "$scratch/first.links" "$scratch/second.links" 2>&1) ||
    [[ "$output" != *'Undeclared operation SessionAsk'* ]]; then
    echo "FAILURE: A file used an interface from an isolated input"
    printf '%s\n' "$output"
    exit 1
fi

if ! output=$(./links --set=isolation=false \
    -e 'effect First { Ask : () => Int; }' \
    -e 'effect Second { Ask : () => Bool; } handle(do Ask) { case <Ask => k> -> k(true) }' 2>&1) ||
    [[ "$output" != $'() : ()\ntrue : Bool' ]]; then
    echo "FAILURE: An inherited operation was treated as a duplicate in a new input"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: Input isolation controls whether later inputs can use earlier declarations"

cat > "$scratch/import-first.links" <<'FIRST'
import Effect_identity;
var previous = Effect_identity.readEffect;
fun usePrevious() {
  handle(previous()) { case <Effect_identity.Ask => k> -> k(41) }
}
FIRST
cat > "$scratch/import-second.links" <<'SECOND'
var fresh = handle(Effect_identity.readEffect()) {
  case <Effect_identity.Ask => k> -> k(42)
};
import Effect_identity;
(usePrevious(), fresh)
SECOND
cat > "$scratch/import-mismatch.links" <<'MISMATCH'
var old = handle(previous()) {
  case <Effect_identity.Ask => k> -> k(42)
};
import Effect_identity;
old
MISMATCH

if ! output=$(./links --set=isolation=false --path=tests/modules \
    "$scratch/import-first.links" "$scratch/import-second.links" 2>&1) ||
    [[ "$output" != $'() : ()\n(41, 42) : (Int, Int)' ]]; then
    echo "FAILURE: A repeated import changed an earlier binding's effect declaration"
    printf '%s\n' "$output"
    exit 1
fi

if output=$(./links --set=isolation=false --path=tests/modules \
    "$scratch/import-first.links" "$scratch/import-mismatch.links" 2>&1) ||
    [[ "$output" != *'The modalities require different effect contexts'* ]]; then
    echo "FAILURE: A reference before a repeated import used the earlier declaration"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: Reloaded interfaces are visible throughout a later input"

cat > "$scratch/failed.links" <<'FAILED'
effect PendingReader { PendingAsk : () => Int; }
module Recovered {
  effect Reader { Ask : () => Bool; }
}
error("failed load")
FAILED

if ! output=$(./links 2>&1 <<EOF_LOAD
module Recovered { effect Reader { Ask : () => Int; } }
@load "$scratch/failed.links";
handle(do Recovered.Ask) { case <Recovered.Ask => k> -> k(42) };
do PendingAsk;
EOF_LOAD
); then
    echo "FAILURE: The failed load ended the REPL session"
    printf '%s\n' "$output"
    exit 1
fi

if [[ "$output" != *'failed load'*$'42 : Int'*'Undeclared operation PendingAsk'* ]]; then
    echo "FAILURE: The failed load changed the REPL interface scope"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: A failed load restores the previous interface scope"
