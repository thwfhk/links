---
config: tests/fresco_modal.config
---

A handler infers its effect arguments
tests/fresco_modal/handled42.links
filemode : true
args : --fresco
stdout : 42 : Int

Comprehensions retain handled callback effects
effect Reader { Read : () => Int; } handle (for (x <- [1,2]) [x + do Read]) { case xs -> xs case <Read => k> -> k(40) }
args : --fresco
stdout : [41, 42] : List Int

Comprehensions retain the guard of functions extracted from a guarded list
effect E { Op : () => Int; } var xs = ([fun() { do Op }] : modal [E] (List (() -> Int))); var ys = for (f <- xs) [~f]; handle ((hd(ys))()) { case x -> x case <Op => k> -> k(42) }
args : --fresco
stdout : 42 : Int

Extracted functions cannot escape their list's required effect
effect E { Op : () => Int; } var xs = ([fun() { do Op }] : modal [E] (List (() -> Int))); var ys = for (f <- xs) [~f]; (hd(ys))()
args : --fresco
exit : 1
stderr : @.*Type error:.*

Optimisation preserves comprehension callback effects
effect Reader { Read : () => Int; } handle (for (x <- [1,2]) [x + do Read]) { case xs -> xs case <Read => k> -> k(40) }
args : --fresco --set=optimise=true
stdout : [41, 42] : List Int

Repeated effects select the nearest handler
tests/fresco_modal/repeated11.links
filemode : true
args : --fresco
stdout : 11 : Int

Handler parameters pass through resumptions
tests/fresco_modal/parameters42.links
filemode : true
args : --fresco
stdout : 42 : Int

Optimisation preserves handler parameters
tests/fresco_modal/parameters42.links
filemode : true
args : --fresco --set=optimise=true
stdout : 42 : Int

Shallow resumption requires another handler
tests/fresco_modal/shallow11.links
filemode : true
args : --fresco
stdout : 11 : Int

A returned closure runs under a later handler
tests/fresco_modal/returned_closure42.links
filemode : true
args : --fresco
stdout : 42 : Int

Optimisation preserves a returned closure
tests/fresco_modal/returned_closure42.links
filemode : true
args : --fresco --set=optimise=true
stdout : 42 : Int

A global map accepts an effectful callback
tests/fresco_modal/map.links
filemode : true
args : --fresco
stdout : [21, 22] : List Int

Optimisation preserves the callback effect context
tests/fresco_modal/map.links
filemode : true
args : --fresco --set=optimise=true
stdout : [21, 22] : List Int

Unhandled operations reject
effect Reader { Ask : () => Int; } do Ask
args : --fresco
exit : 1
stderr : @.*Type error:.*

A negative operation argument retains its narrowed as binding
effect Choose { Pick : ([|Foo|Bar|]) => Int; } handle (do Pick(Bar)) { case x -> x case <Pick(-Foo as r) => k> -> k(switch(r) { case Bar -> 42 }) }
args : --fresco
stdout : 42 : Int

A guarded record update retains the replacement callback's effect
effect E { Op : () => Int; } var r = ((value=0, action=fun() { do Op }) : modal [E] (value:Int, action:(() -> Int))); var s = (r with action=fun() { do Op + 1 }); handle (s.action()) { case x -> x case <Op => k> -> k(41) }
args : --fresco
stdout : 42 : Int

Incomplete effect groups reject
effect State { Get : () => Int; Put : (Int) => (); } handle (do Get) { case x -> x case <Get => k> -> k(42) }
args : --fresco
exit : 1
stderr : @.*Missing operation clauses.*

Calling an effectful returned closure without a handler rejects
effect Tick { Next : () => Int; } var thunk = handle (fun() { do Next }) { case f -> f case <Next => k> -> k(1) }; thunk()
args : --fresco
exit : 1
stderr : @.*Type error:.*
