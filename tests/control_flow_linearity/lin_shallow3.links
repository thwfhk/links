# Using the linear variable `lf` in a recursive function is invalid

var lf = linfun() { xlin; 42 };

sig h : (() {Foo:() =@ Int|a::Lin}~@ b) { |_::Lin}-> () {Foo{_::Lin}|a::Lin}~@ b
fun h(m) {
  xlin;
  linfun() {
    shallowhandle({xlin; m()}) {
      case <Foo =@ k> -> {
        xlin;
        var i = lf();
        h(linfun(){xlin; k(i)})()
      }
    }
  }
}

h(linfun(){xlin; lindo Foo() + 42})()