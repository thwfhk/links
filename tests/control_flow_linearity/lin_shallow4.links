# Use the linear variable `lf` in a shallow handler with an auxiliary
# recursive function

var lf = linfun() { xlin; 42 };

sig h : (() {Foo:() =@ Int|a::Lin}~@ b) { |_::Lin}-> () {Foo{_::Lin}|a::Lin}~@ b
fun h(m) {
  xlin;
  linfun() {
    shallowhandle({xlin; m()}) {
      case <Foo =@ k> -> {
        xlin;
        h(linfun(){xlin; k(0)})()
      }
    }
  }
}

shallowhandle({
  lindo Foo() + 42
}) {
  case <Foo =@ k> -> {
    xlin;
    var i = lf();
    h(linfun(){xlin; k(i)})()
  }
}