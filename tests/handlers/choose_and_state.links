effect Choice { Choose : () => Bool; }
effect State(s::Abs) { Get : () => s; Put : (s) => (); }

sig incr : [State(Int)] ((Int) -> ())
fun incr(x) {var y = do Get; do Put(x+y)}

sig choice : [Choice, State(Int)] (() -> Int)
fun choice() {
  var x = if (do Choose()) { incr(1); do Get }
          else { incr(1); do Get };
  var y = if (do Choose()) { incr(1); do Get }
          else { incr(1); do Get };
  x + y
}

sig enumerate : forall a::Abs. (<Choice> (() -> a)) -> () -> List a
fun enumerate(m)() {
  handle(m()) {
    case x -> [x]
    case <Choose => k> -> k(true) ++ k(false)
  }
}


sig evalState : forall s::Abs,a::Abs. (s) -> (<State(s)> (() -> a)) -> () -> a
fun evalState(st)(m)() {
  (handle(m()) {
    case x              -> fun(_)  { x }
    case <Get => k>     -> fun(st) { k(st)(st) }
    case <Put(p) => k>  -> fun(_)  { k(())(p)  }
  })(st)
}

evalState(0)(fun() { enumerate(choice)() })() ++
  enumerate(fun() { evalState(0)(choice)() })()
