---
config: tests/fresco_typecheck.config
---

Source-only checking does not execute recursive calls
{ sig loop : (Int) -> Int fun loop(x) { loop(x) } loop(42) }
args : --fresco
stdout : @^$

Source-only checking rejects a type error
(fun(f) { (f(42), f(true)) })(fun(x) { x })
args : --fresco
exit : 1
stderr : @.*Type error:.*

Selected frontend rechecking lowers without evaluating source
sig absurd:(Int)->Int fun absurd(x) { switch(x) {} } { print("must not execute"); absurd(42) }
args : --fresco --set=recheck_frontend_transformations=true --set=recheck_frontend_transformations_filter=fresco-lowering --set=typecheck_ir=false --set=fail_on_ir_type_error=false
stdout : @^$

The selected lowering checkpoint checks effects and generated comprehensions
effect E { Read : () => Int; } handle <E> (for (x <- [1..3]) where (x <> 2) [x+do Read]) { case xs -> xs case <Read => k> -> k(40) }
args : --fresco --enable-handlers --set=typecheck_only=false --set=recheck_frontend_transformations=true --set=typecheck_ir=false --set=fail_on_ir_type_error=false
stdout : [41, 43] : List Int

A disabled frontend checkpoint keeps source-only checking
effect E { Read : () => Int; } sig f:modal [E] (() -> Int) fun f() { do Read } 42
args : --fresco --set=enable_handlers=false --set=recheck_frontend_transformations=true --set=recheck_frontend_transformations_filter=none
stdout : @^$

A selected frontend checkpoint requires the lowering extension
effect E { Read : () => Int; } sig f:modal [E] (() -> Int) fun f() { do Read } 42
args : --fresco --set=enable_handlers=false --set=recheck_frontend_transformations=true --set=recheck_frontend_transformations_filter=all
exit : 1
stderr : @.*Effect handlers.*enable_handlers.*


Fixities persist between shared batch files
tests/fixtures/fresco-fixities-use.links
filemode : true
args : --fresco --set=typecheck_only=false --set=isolation=false --set=recheck_frontend_transformations=true tests/fixtures/fresco-fixities-definitions.links
stdout : @\(\) : \(\)\n\(8, 6\) : \(Int, Int\)$

The contextual file frontend uses the configured preprocessor
tests/fixtures/fresco-preprocessed.links
filemode : true
args : --fresco --set=typecheck_only=false "--set=preprocessor=sed s/TOKEN/42/g" --set=recheck_frontend_transformations=true
stdout : 42 : Int

Preprocessed files check and lower without evaluation
tests/fixtures/fresco-preprocessed-check.links
filemode : true
args : --fresco "--set=preprocessor=sed s/TOKEN/42/g" --set=recheck_frontend_transformations=true
stdout : @^$
