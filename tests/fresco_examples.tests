Pi preserves finite producer and consumer order
open import Pi; (catch(fun(){pipe(fun(){yield(1);yield(2);yield(3);abort()},fun(){collectEstimations(3)()})}),catch(fun(){pipe(fun(){yield(1);yield(2);yield(3);abort()},fun(){[await(),await(),await()]})}))
stdout : ([3, 2, 1], [1, 2, 3]) : (List Int, List Int)
args : --fresco --path=examples/handlers:examples:lib/stdlib

Pi preserves producer and consumer interleaving
open import Pi; catch(fun(){pipe(fun(){print("a");yield(1);print("b");yield(2);print("c");abort()},fun(){var x=await();print("x");var y=await();print("y");x+y})})
stdout : axby3 : Int
args : --fresco --path=examples/handlers:examples:lib/stdlib

Pi resumes alternating Yield and Await steps
open import Pi; switch(~step[Int,Int](fun(){yield(1);var x=await();yield(x+1);42})) {case Yielded(x,k)->switch(k(())){case Awaits(k)->switch(k(20)){case Yielded(y,k)->switch(k(())){case Done(r)->(x,y,r) case _->error("done")} case _->error("yield")} case _->error("await")} case _->error("first")}
stdout : (1, 21, 42) : (Int, Int, Int)
args : --fresco --path=examples/handlers:examples:lib/stdlib

Pi preserves effects in stored Await resumptions
open import Pi; effect Reader {Ask:()=>Int;} handle <Reader> ({var st= ~step[Int,Int](fun(){yield(do Ask);var x=await();do Ask+x}); switch(st){case Yielded(x,k)->switch(k(())){case Awaits(k)->switch(k(2)){case Done(y)->(x,y) case _->error("done")} case _->error("await")} case _->error("yield")}}) {case x->x case <Ask=>k> -> k(20)}
stdout : (20, 22) : (Int, Int)
args : --fresco --path=examples/handlers:examples:lib/stdlib

Pi exchange preserves distinct payload and result types
open import Pi; ~exchange[Bool,String](fun(){if(await()) "yes" else "no"},fun(){yield(true); "unused"})
stdout : "yes" : String
args : --fresco --path=examples/handlers:examples:lib/stdlib

