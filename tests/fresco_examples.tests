Queued resumptions retain the caller effect context
open import FrescoPrelude; open import Coop; effect Reader { Ask : () => Int; } var result=handle (run(fun(){if(fork()) {42} else {do Ask}})) {case x -> x case <Ask => k> -> k(7)}; switch(result) {case Just((_,Cons(next,queue))) -> next(queue) case _ -> Nothing}
exit : 1
stderr : @.*Type error: Type does not match the required type.*In expression: next\.
args : --fresco --path=examples/handlers:examples:lib/stdlib

