#!/usr/bin/env bash

if ! output=$(./links <<'EOF'
effect Reader { Ask : () => Int; }
sig ask : [Reader] (() -> Int)
fun ask() { do Ask };
handle(ask()) { case <Ask => k> -> k(42) };
EOF
); then
    echo "FAILURE: The handler REPL session exited with an error"
    exit 1
fi

if [[ "$output" != *$'\nask = fun : [Reader] (() -> Int)'*$'\n42 : Int' ]]; then
    echo "FAILURE: The REPL did not return 42 from the handler"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: The REPL ran a handler with default settings"

if ! output=$(./links 2>&1 <<'EOF'
var linear = (linfun() { 42 } : [] (() -@ Int));
linear();
linear();
var linear = (linfun() { 43 } : [] (() -@ Int));
linear();
EOF
); then
    echo "FAILURE: The linear binding REPL session exited with an error"
    exit 1
fi

if [[ "$output" != *$'42 : Int'*'Linear variable linear has already been used'*$'43 : Int' ]]; then
    echo "FAILURE: The REPL did not enforce linear use across sentences"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: The REPL tracked a linear binding across sentences"

if ! output=$(./links 2>&1 <<'EOF'
var linear = (linfun() { 42 } : [] (() -@ Int));
{ var moved = linear; error("after move"); moved() };
linear();
var unused = (linfun() { 43 } : [] (() -@ Int));
{ error("before move"); var moved = unused; moved() };
unused();
EOF
); then
    echo "FAILURE: Error recovery ended the REPL session"
    exit 1
fi

if [[ "$output" != *'after move'*'Linear variable linear has already been used'*'before move'*$'43 : Int' ]]; then
    echo "FAILURE: The REPL lost track of which linear bindings ran"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: The REPL tracked linear uses before a runtime error"

if ! output=$(./links 2>&1 <<'EOF'
var firstArg = (linfun() { 44 } : [] (() -@ Int));
(fun(f, n) { f() + n })(firstArg, error("after argument"));
firstArg();
var captured = (linfun() { 45 } : [] (() -@ Int));
{ var wrapped = linfun() { captured() }; error("after capture"); wrapped() };
captured();
var unary = (linfun(n) { n } : [] ((Int) -@ Int));
{ var wrapped = linfun() { `unary` 45 }; error("after unary operator capture"); wrapped() };
unary(45);
var left = (linfun() { 46 } : [] (() -@ Int));
[left, { error("after list item"); linfun() { 47 } : [] (() -@ Int) }];
left();
var right = (linfun() { 48 } : [] (() -@ Int));
[{ error("before list item"); linfun() { 49 } : [] (() -@ Int) }, right];
right();
EOF
); then
    echo "FAILURE: Evaluation of a move ended the REPL session"
    exit 1
fi

if [[ "$output" != *'after argument'*'Linear variable firstArg has already been used'*'after capture'*'Linear variable captured has already been used'*'after unary operator capture'*'Linear variable unary has already been used'*'after list item'*'Linear variable left has already been used'*'before list item'*$'48 : Int' ]]; then
    echo "FAILURE: The REPL tracked the wrong moves in arguments, closures or lists"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: The REPL tracked linear moves in arguments, closures and lists"

if ! output=$(./links 2>&1 <<'EOF'
(fun(a,b) { 42 })(chr(-1), { print("application before binding"); 42 });
[chr(-1), { print("list before binding"); 'a' }];
(a=chr(-1), z=verify("bad", "pw"));
var unrelated = (linfun() { 50 } : [] (() -@ Int));
(fun(a,b) { 42 })(chr(-1), { print("application with binding"); 42 });
[chr(-1), { print("list with binding"); 'a' }];
(a=chr(-1), z=verify("bad", "pw"));
unrelated();
(fun(a,b) { 42 })(chr(-1), { print("application after consumption"); 42 });
[chr(-1), { print("list after consumption"); 'a' }];
(a=chr(-1), z=verify("bad", "pw"));
EOF
); then
    echo "FAILURE: Native failures ended the REPL session"
    exit 1
fi

chr_failure='***: Error: Invalid_argument("Char.chr")'
bcrypt_failure='***: Error: Bcrypt.Bcrypt_error'
if [[ "$output" != *"application before binding$chr_failure"*"list before binding$chr_failure"*"$bcrypt_failure"*"unrelated = fun"*"application with binding$chr_failure"*"list with binding$chr_failure"*"$bcrypt_failure"*$'\n50 : Int\n'*"application after consumption$chr_failure"*"list after consumption$chr_failure"*"$bcrypt_failure"* ]]; then
    echo "FAILURE: Tracking an unrelated linear value changed native evaluation order"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: Tracking an unrelated linear value preserved native evaluation order"

if ! output=$(./links 2>&1 <<'EOF'
var later = (linfun() { 51 } : [] (() -@ Int));
(fun(a,g) { g() })(chr(-1), later);
later();
var afterSuccess = (linfun() { 52 } : [] (() -@ Int));
(fun(a,g,b) { g()+b })(chr(-1), afterSuccess, { print("later operand ran"); 11 });
afterSuccess();
var uncaptured = (linfun() { 53 } : [] (() -@ Int));
if (true) { var x = 3; (fun(a,g) { g() })(chr(-1), linfun() { uncaptured()+x }) } else uncaptured();
uncaptured();
var nested = (linfun() { 54 } : [] (() -@ Int));
(fun((g,x),n) { g()+n+x })((nested, 3), if (true) exit("after nested move") else 2);
nested();
var called = (linfun() { 55 } : [] (() -@ Int));
[called(), { error("after list call"); 42 }];
called();
var capturedArgument = (linfun() { 56 } : [] (() -@ Int));
if (true) { var x = 3; (fun(g,n) { g()+n })(linfun() { capturedArgument()+x }, error("after lambda")) } else capturedArgument();
capturedArgument();
var firstField = (linfun() { 57 } : [] (() -@ Int));
(a=chr(-1), z=firstField);
firstField();
var lastField = (linfun() { 58 } : [] (() -@ Int));
(a=lastField, z=chr(-1));
lastField();
EOF
); then
    echo "FAILURE: An interrupted linear operand ended the REPL session"
    exit 1
fi

if [[ "$output" != *"$chr_failure"*$'\n51 : Int'*"later operand ran$chr_failure"*$'\n52 : Int'*"$chr_failure"*$'\n53 : Int'* ||
      "$output" != *$'\n"after nested move"\n'*'Linear variable nested has already been used'*'after list call'*'Linear variable called has already been used'*'after lambda'*'Linear variable capturedArgument has already been used'* ||
      "$output" != *"firstField = fun"*"$chr_failure"*'Linear variable firstField has already been used'*"lastField = fun"*"$chr_failure"*$'\n58 : Int'* ]]; then
    echo "FAILURE: The REPL tracked a move at the wrong point in operand evaluation"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: The REPL tracked only the linear moves reached before interruptions"

if ! output=$(./links 2>&1 <<'EOF'
effect Stopper { Stop : () => Int; }
var abandoned = (linfun() { 59 } : [] (() -@ Int));
{ var n = handle((fun(g,n) { g()+n })(abandoned, do Stop)) { case <Stop => k> -> 1 }; error("after abandoning operand") : Int };
abandoned();
var resumed = (linfun() { 60 } : [] (() -@ Int));
handle((fun(a,g,n) { g()+n })(chr(-1), resumed, do Stop)) { case <Stop => k> -> k(1) };
resumed();
EOF
); then
    echo "FAILURE: A handled interruption ended the REPL session"
    exit 1
fi

if [[ "$output" != *'after abandoning operand'*'Linear variable abandoned has already been used'*"$chr_failure"*$'\n60 : Int'* ]]; then
    echo "FAILURE: The REPL tracked the wrong linear moves when a handler stopped or resumed an operand"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: The REPL tracked linear moves through interrupted and resumed operands"

if ! output=$(./links 2>&1 <<'EOF'
var movedBeforeExit = (linfun() { 46 } : [] (() -@ Int));
var skippedByExit = (linfun() { 47 } : [] (() -@ Int));
var keep = 48;
module Interrupted {
  var madeBeforeExit = 49;
  var moved = movedBeforeExit;
  var stopped = { print("before exit"); exit("stopped"); moved() };
  var skipped = skippedByExit();
}
Interrupted.madeBeforeExit;
movedBeforeExit();
skippedByExit();
keep;
module Failed {
  var madeBeforeError = 50;
  var failed = (error("module error") : Int);
}
Failed.madeBeforeError;
keep;
if (true) exit("early expression") else 51;
52;
EOF
); then
    echo "FAILURE: Exit recovery ended the REPL session"
    exit 1
fi

if [[ "$output" != *$'before exit"stopped"\n'*'Interrupted'*'Linear variable movedBeforeExit has already been used'*$'47 : Int\n48 : Int\n'*'module error'*'Failed'*$'48 : Int\n"early expression"\n52 : Int' ||
      "$output" == *'madeBeforeExit ='* || "$output" == *'madeBeforeError ='* ]]; then
    echo "FAILURE: The REPL retained an interrupted module or printed the wrong exit result"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: The REPL rolled back interrupted modules and displayed exit values"

scratch=$(mktemp -d "${TMPDIR:-/tmp}/links-repl-recovery.XXXXXX") || exit 1
trap 'rm -rf "$scratch"' EXIT

cat > "$scratch/exits.links" <<'SOURCE'
var pending = 53;
var moved = fromLoad;
{ exit("load exit"); moved() }
SOURCE

if ! output=$(./links 2>&1 <<EOF_LOAD
var fromLoad = (linfun() { 54 } : [] (() -@ Int));
@load "$scratch/exits.links";
pending;
fromLoad();
55;
EOF_LOAD
); then
    echo "FAILURE: Exit during a load ended the REPL session"
    exit 1
fi

if [[ "$output" != *$'"load exit"\n'*'Unknown variable pending'*'Linear variable fromLoad has already been used'*$'55 : Int' ]]; then
    echo "FAILURE: The REPL failed to recover from exit during a load"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: The REPL recovered from an exit during a load"

if ! output=$(./links 2>&1 <<'EOF'
module Linear {
  var original = (linfun() { 42 } : [] (() -@ Int));
  var moved = original;
}
Linear.moved();
Linear.original();
EOF
); then
    echo "FAILURE: A module with a linear binding ended the REPL session"
    exit 1
fi

if [[ "$output" != *$'42 : Int'*'Linear variable '*original*' has already been used'* ]]; then
    echo "FAILURE: The REPL allowed a moved module binding to be reused"
    printf '%s\n' "$output"
    exit 1
fi

echo "SUCCESS: The REPL tracked a linear binding moved within a module"
