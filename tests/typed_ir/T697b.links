unsafe sig concatMap : forall a,c. ((a) -> List c, List a) -> List c
fun concatMap(f, l) {
  switch (l) {
    case [] -> []
    case hd::tl -> f(hd) ++ concatMap(f, tl)
  }
}


sig swap : forall a. (List a, a, a) -> List a
fun swap(xs, x1, x2) {
 for (x <- xs) {
  if (x == x1) [x2]
  else if (x == x2) [x1]
  else [x]
 }
}
