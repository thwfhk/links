---
config: tests/messages.config
args: --fresco
---

Correct message type sent to a process
spawn { recv() + 1 } ! 1
stdout : () : ()

Incorrect message type sent to a process is a type error
spawn { { recv() + 1} } ! "two"
stderr : @.*Type error.*
exit : 1

Receive types must unify (correct, closed rows)
sig f : modal [Wild, Receive([|Bar|])] (() -> ()) fun f() { receive { case Bar -> () }} sig g : modal [Wild, Receive([|Bar|])] (() -> ()) fun g() { receive { case Bar -> () }} spawnWait { self() ! Bar; f(); self() ! Bar; g() }
stdout : () : ()

Receive types must unify (incorrect, closed rows)
sig f : modal [Wild, Receive([|Bar|])] (() -> ()) fun f() { receive { case Bar -> () }} sig g : modal [Wild, Receive([|Foo|])] (() -> ()) fun g() { receive { case Foo -> () }} (fun () { f(); g() } : modal [Wild, Receive([|Bar|])] (() -> ()))
stderr : @.*Type error.*
exit : 1

Receive types must unify (correct, open rows)
spawnWait { var f = fun() { receive { case Bar -> () case x -> () }}; var g = fun() { receive { case Foo -> () case x -> () }}; self() ! Foo; f(); self() ! Bar; g() }
stdout : () : ()

Receive types must unify (incorrect, open rows)
spawn { var f = fun() { receive { case Bar (x) -> x+1 case x -> 0 }}; var g = fun() { receive { case Bar (s) -> s+.1.0 case x -> 0.0 }}; fun () { var _ = f(); g() } }
stderr : @.*Type error.*
exit : 1

Basic send/receive test.
sig main : modal [Wild] (() -> String) fun main() { spawnWait { var p = spawn { recv() ! "The end" } ! self(); recv() } } main()
stdout : @"The end" : .*

Mailboxes are not polymorphic [1]
sig main : modal [Wild] (() -> String) fun main() { spawnWait { var p = spawn { recv() ! "The end" } ! self(); recv() } } main()
stdout : "The end" : String

Mailboxes are not polymorphic [2]
var pid = spawn { recv() ++ [] }; { pid ! ["one"]; pid ! [2] }
stderr : @.*Type error.*
exit : 1

Built-in functions are polymorphic in their mailbox types
sig f : modal [Wild, Receive(Int)] (() -> String) fun f() {var x = recv(); intToString(x)} sig g : modal [Wild, Receive(())] ((Int) -> String) fun g(x) {var () = recv(); intToString(x)} (f, g)
stdout : (fun, fun) : (modal [effect_0$Wild, effect_1$Receive(Int)] (() -> String), modal [effect_0$Wild, effect_1$Receive(())] ((Int) -> String))

SpawnWait works on the server
sig go : modal [Wild] (() -> Int) fun go() { var p1 = spawn { receive { case Hi(pid) -> pid ! 100 } }; spawnWait { p1 ! Hi(self()) ; receive { case n -> n } } } go()
stdout : 100 : Int
