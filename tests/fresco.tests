Record extension replaces proven absence and retains other masks
sig extend:forall r::Row.((l-,hidden- |r))->(l:Int,hidden- |r) fun extend(base){(l=42|base)} extend((x=true))
args : --fresco
stdout : (l = 42, x = true) : (hidden-,l:Int,x:Bool)

