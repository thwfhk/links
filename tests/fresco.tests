---
config: tests/fresco.config
---

Frozen higher-rank argument executes (e3b)
{ sig id : forall a. (a) -> a fun id(x) { x } sig app : forall a, b. ((a) -> b) -> (a) -> b fun app(f)(x) { f(x) } sig poly : (forall a. (a) -> a) -> (Int, Bool) fun poly(f) { (f(42), f(true)) } app(fun(x) { poly(x) })(~id) }
args : --fresco
stdout : (42, true) : (Int, Bool)

External print executes in the initial Wild context
{ print("answer="); 42 }
args : --fresco
stdout : answer=42 : Int

An explicitly Wild function executes
sig emit : modal [Wild] ((String) -> ()) fun emit(x) { print(x) } emit("ok ")
args : --fresco
stdout : ok () : ()

A pure global signature rejects external print
sig emit : (String) -> () fun emit(x) { print(x) } emit("bad")
args : --fresco
exit : 1
stderr : @.*Type error:.*

Numeric conversions and division execute
floatToInt(intToFloat(84 / 2))
args : --fresco
stdout : 42 : Int

External list primitives retain polymorphism
(hd([42]), hd([true]))
args : --fresco
stdout : (42, true) : (Int, Bool)

String primitives execute
strsub("answer", 0, 3)
args : --fresco
stdout : "ans" : String

XML conversion executes
stringToXml("answer")
args : --fresco
stdout : answer : List XmlItem

Projection sections execute
(.x)((x=42, y=true))
args : --fresco
stdout : 42 : Int

Minus sections execute
(-)(44, 2)
args : --fresco
stdout : 42 : Int

Record updates preserve other fields
((x=1, y=true) with x=42).x
args : --fresco
stdout : 42 : Int

Record updates can change field types
((x=1, y=true) with x="answer")
args : --fresco
stdout : (x = "answer", y = true) : (x:String,y:Bool)

Record updates require an existing field
((x=1) with y=42)
args : --fresco
exit : 1
stderr : @.*Type error:.*

Negative patterns execute on another constructor
(fun (-(Foo, Bar)) { 42 })(Quux)
args : --fresco
stdout : 42 : Int

Negative patterns reject an excluded constructor
(fun (-Foo) { 42 })(Foo)
args : --fresco
exit : 1
stderr : @.*

A negative switch pattern permits the fallback
switch(Foo) { case -Foo -> 0 case _ -> 42 }
args : --fresco
stdout : 42 : Int

Record update evaluates its base and replacements once in source order
({ print("b"); (x=0, y=0) } with x={ print("x"); 20 }, y={ print("y"); 22 })
args : --fresco
stdout : bxy(x = 20, y = 22) : (x:Int,y:Int)

Repeated update labels evaluate every replacement and keep the first
((x=0) with x={ print("a"); 42 }, x={ print("b"); 99 })
args : --fresco
stdout : ab(x = 42) : (x:Int)

Regex ranges and repetition execute
"42" =~ /^[0-9]+$/
args : --fresco
stdout : true : Bool

Regex interpolation quotes metacharacters
var part = "a.b"; "a.b" =~ /^{part}$/
args : --fresco
stdout : true : Bool

Regex groups return captured strings
"ab" =~ /(a)(b)/l
args : --fresco
stdout : ["ab", "a", "b"] : List String

Regex replacement executes
"aba" =~ s/a/x/
args : --fresco
stdout : "xba" : String

Regex splices require strings
var part = 42; "42" =~ /{part}/
args : --fresco
exit : 1
stderr : @.*Type error:.*

Regex sequence splices retain Links evaluation order
"ab" =~ /{print("a"); "a"}{print("b"); "b"}/
args : --fresco
stdout : batrue : Bool

Regex alternatives retain left-to-right splice evaluation
"a" =~ /({print("a"); "a"}|{print("b"); "b"})/
args : --fresco
stdout : abtrue : Bool

Regex pattern splices run before replacement expressions
"a" =~ s/{print("p"); "a"}/{print("r"); "x"}/
args : --fresco
stdout : pr"x" : String

Regex replacement retains the existing single replacement behaviour
"aba" =~ s/a/x/g
args : --fresco
stdout : "xba" : String

The unavailable native regex flag reports a source error
"a" =~ /a/n
args : --fresco
exit : 1
stderr : @.*native regex flag.*

Inclusive integer ranges execute
[3..5]
args : --fresco
stdout : [3, 4, 5] : List Int

Descending integer ranges are empty
[5..3]
args : --fresco
stdout : [] : List Int

List comprehensions filter and concatenate
for (x <- [1..3]) where (x <> 2) [x + 40]
args : --fresco
stdout : [41, 43] : List Int

Multiple generators form a Cartesian product
for (x <- [1,2], y <- [true,false]) [(x,y)]
args : --fresco
stdout : [(1, true), (1, false), (2, true), (2, false)] : List (Int, Bool)

Nested comprehensions can use the outer binder
for (x <- [1,2]) for (y <- [x]) [x+y]
args : --fresco
stdout : [2, 4] : List Int

Comma-separated generator sources use the outer scope
for (x <- [1,2], y <- [x]) [y]
args : --fresco
exit : 1
stderr : @.*Type error:.*

Comprehensions retain orderby
for (x <- [2,1,3]) orderby (-x) [x]
args : --fresco
stdout : [3, 2, 1] : List Int

A nullary comprehension retains its filter
for () where (false) [42]
args : --fresco
stdout : [] : List Int

Comprehension bodies require lists
for (x <- [42]) x
args : --fresco
exit : 1
stderr : @.*Type error:.*

Comprehension filters require booleans
for (x <- [42]) where (x) [x]
args : --fresco
exit : 1
stderr : @.*Type error:.*

Cartesian generators finish before body execution
for (x <- { print("a"); [1,2] }, y <- { print("b"); [3] }) { print("c"); [x+y] }
args : --fresco
stdout : abbcc[4, 5] : List Int

Ordering retains repeated key evaluation
for (x <- [2,1,3]) orderby ({ print(intToString(x)); x }) [x]
args : --fresco
stdout : 12321232[1, 2, 3] : List Int

Singleton ranges include machine integer bounds
([min_int..min_int] == [min_int], [max_int..max_int] == [max_int])
args : --fresco
stdout : (true, true) : (Bool, Bool)

Range bounds evaluate once from left to right
[{ print("l"); 1 }..{ print("h"); 2 }]
args : --fresco
stdout : lh[1, 2] : List Int

Repeated comprehension binder names retain the first binder
for (x <- [1], x <- [2]) [x]
args : --fresco
stdout : [1] : List Int

Generator sources retain an outer variable shadowed by a pattern
var x = [42]; for (x <- [1], y <- x) [y]
args : --fresco
stdout : [42] : List Int

List cons executes
1 :: [2]
args : --fresco
stdout : [1, 2] : List Int

List concatenation executes
[1] ++ [2]
args : --fresco
stdout : [1, 2] : List Int

An unsigned parameter cannot be used at two types (c1a)
(fun(f) { (f(42), f(true)) })(fun(x) { x })
args : --fresco
exit : 1
stderr : @.*Type error:.*

A variant field keeps its quantified type
tests/fresco/polymorphic_variant.links
args : --fresco
filemode : true
stdout : (42, true) : (Int, Bool)
