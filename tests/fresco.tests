---
config: tests/fresco.config
---

Frozen higher-rank argument executes (e3b)
{ sig id : forall a. (a) -> a fun id(x) { x } sig app : forall a, b. ((a) -> b) -> (a) -> b fun app(f)(x) { f(x) } sig poly : (forall a. (a) -> a) -> (Int, Bool) fun poly(f) { (f(42), f(true)) } app(fun(x) { poly(x) })(~id) }
args : --fresco
stdout : (42, true) : (Int, Bool)

External print executes in the initial Wild context
{ print("answer="); 42 }
args : --fresco
stdout : answer=42 : Int

An explicitly Wild function executes
sig emit : modal [Wild] ((String) -> ()) fun emit(x) { print(x) } emit("ok ")
args : --fresco
stdout : ok () : ()

A pure global signature rejects external print
sig emit : (String) -> () fun emit(x) { print(x) } emit("bad")
args : --fresco
exit : 1
stderr : @.*Type error:.*

Numeric conversions and division execute
floatToInt(intToFloat(84 / 2))
args : --fresco
stdout : 42 : Int

External list primitives retain polymorphism
(hd([42]), hd([true]))
args : --fresco
stdout : (42, true) : (Int, Bool)

String primitives execute
strsub("answer", 0, 3)
args : --fresco
stdout : "ans" : String

XML conversion executes
stringToXml("answer")
args : --fresco
stdout : answer : List XmlItem

Projection sections execute
(.x)((x=42, y=true))
args : --fresco
stdout : 42 : Int

Minus sections execute
(-)(44, 2)
args : --fresco
stdout : 42 : Int

Record updates preserve other fields
((x=1, y=true) with x=42).x
args : --fresco
stdout : 42 : Int

Record updates can change field types
((x=1, y=true) with x="answer")
args : --fresco
stdout : (x = "answer", y = true) : (x:String,y:Bool)

Record updates require an existing field
((x=1) with y=42)
args : --fresco
exit : 1
stderr : @.*Type error:.*

Negative patterns execute on another constructor
(fun (-(Foo, Bar)) { 42 })(Quux)
args : --fresco
stdout : 42 : Int

Negative patterns reject an excluded constructor
(fun (-Foo) { 42 })(Foo)
args : --fresco
exit : 1
stderr : @.*

A negative switch pattern permits the fallback
switch(Foo) { case -Foo -> 0 case _ -> 42 }
args : --fresco
stdout : 42 : Int

Record update evaluates its base and replacements once in source order
({ print("b"); (x=0, y=0) } with x={ print("x"); 20 }, y={ print("y"); 22 })
args : --fresco
stdout : bxy(x = 20, y = 22) : (x:Int,y:Int)

Repeated update labels evaluate every replacement and keep the first
((x=0) with x={ print("a"); 42 }, x={ print("b"); 99 })
args : --fresco
stdout : ab(x = 42) : (x:Int)

Regex ranges and repetition execute
"42" =~ /^[0-9]+$/
args : --fresco
stdout : true : Bool

Regex interpolation quotes metacharacters
var part = "a.b"; "a.b" =~ /^{part}$/
args : --fresco
stdout : true : Bool

Regex groups return captured strings
"ab" =~ /(a)(b)/l
args : --fresco
stdout : ["ab", "a", "b"] : List String

Regex replacement executes
"aba" =~ s/a/x/
args : --fresco
stdout : "xba" : String

Regex splices require strings
var part = 42; "42" =~ /{part}/
args : --fresco
exit : 1
stderr : @.*Type error:.*

Regex sequence splices retain Links evaluation order
"ab" =~ /{print("a"); "a"}{print("b"); "b"}/
args : --fresco
stdout : batrue : Bool

Regex alternatives retain left-to-right splice evaluation
"a" =~ /({print("a"); "a"}|{print("b"); "b"})/
args : --fresco
stdout : abtrue : Bool

Regex pattern splices run before replacement expressions
"a" =~ s/{print("p"); "a"}/{print("r"); "x"}/
args : --fresco
stdout : pr"x" : String

Regex replacement retains the existing single replacement behaviour
"aba" =~ s/a/x/g
args : --fresco
stdout : "xba" : String

The unavailable native regex flag reports a source error
"a" =~ /a/n
args : --fresco
exit : 1
stderr : @.*native regex flag.*

Inclusive integer ranges execute
[3..5]
args : --fresco
stdout : [3, 4, 5] : List Int

Descending integer ranges are empty
[5..3]
args : --fresco
stdout : [] : List Int

List comprehensions filter and concatenate
for (x <- [1..3]) where (x <> 2) [x + 40]
args : --fresco
stdout : [41, 43] : List Int

Multiple generators form a Cartesian product
for (x <- [1,2], y <- [true,false]) [(x,y)]
args : --fresco
stdout : [(1, true), (1, false), (2, true), (2, false)] : List (Int, Bool)

Nested comprehensions can use the outer binder
for (x <- [1,2]) for (y <- [x]) [x+y]
args : --fresco
stdout : [2, 4] : List Int

Comma-separated generator sources use the outer scope
for (x <- [1,2], y <- [x]) [y]
args : --fresco
exit : 1
stderr : @.*Type error:.*

Comprehensions retain orderby
for (x <- [2,1,3]) orderby (-x) [x]
args : --fresco
stdout : [3, 2, 1] : List Int

A nullary comprehension retains its filter
for () where (false) [42]
args : --fresco
stdout : [] : List Int

Comprehension bodies require lists
for (x <- [42]) x
args : --fresco
exit : 1
stderr : @.*Type error:.*

Comprehension filters require booleans
for (x <- [42]) where (x) [x]
args : --fresco
exit : 1
stderr : @.*Type error:.*

Cartesian generators finish before body execution
for (x <- { print("a"); [1,2] }, y <- { print("b"); [3] }) { print("c"); [x+y] }
args : --fresco
stdout : abbcc[4, 5] : List Int

Ordering retains repeated key evaluation
for (x <- [2,1,3]) orderby ({ print(intToString(x)); x }) [x]
args : --fresco
stdout : 12321232[1, 2, 3] : List Int

Singleton ranges include machine integer bounds
([min_int..min_int] == [min_int], [max_int..max_int] == [max_int])
args : --fresco
stdout : (true, true) : (Bool, Bool)

Range bounds evaluate once from left to right
[{ print("l"); 1 }..{ print("h"); 2 }]
args : --fresco
stdout : lh[1, 2] : List Int

Repeated comprehension binder names retain the first binder
for (x <- [1], x <- [2]) [x]
args : --fresco
stdout : [1] : List Int

Generator sources retain an outer variable shadowed by a pattern
var x = [42]; for (x <- [1], y <- x) [y]
args : --fresco
stdout : [42] : List Int

List cons executes
1 :: [2]
args : --fresco
stdout : [1, 2] : List Int

List concatenation executes
[1] ++ [2]
args : --fresco
stdout : [1, 2] : List Int

An unsigned parameter cannot be used at two types (c1a)
(fun(f) { (f(42), f(true)) })(fun(x) { x })
args : --fresco
exit : 1
stderr : @.*Type error:.*

A variant field keeps its quantified type
tests/fresco/polymorphic_variant.links
args : --fresco
filemode : true
stdout : (42, true) : (Int, Bool)

Escape returns its body result
escape k in { 2 + 40 }
args : --fresco
stdout : 42 : Int

Escape exits an enclosing computation
escape return in { 1 + (escape k in { return(42) }) }
args : --fresco
stdout : 42 : Int

Escape continuation results agree across uses
escape k in { var _ = ("" == k(42), "again" == k(42)); 0 }
args : --fresco
stdout : 42 : Int

Escape rejects inconsistent continuation results
escape k in { var _ = ("" == k(42), true == k(42)); 0 }
args : --fresco
exit : 1
stderr : @.*Type error:.*

Escape requires Wild
sig f : () -> Int fun f() { escape k in { 42 } } f()
args : --fresco
exit : 1
stderr : @.*Type error:.*

Escape executes in a signed Wild function
sig f : modal [Wild] (() -> Int) fun f() { escape k in { k(42) } } f()
args : --fresco
stdout : 42 : Int

Frozen opened module names retain polymorphism
module A { sig id : forall a. (a) -> a fun id(x) { x } } open A; (~id[Int](42), ~id[Bool](true))
args : --fresco
stdout : (42, true) : (Int, Bool)

Frozen module names use the current binding
module A { sig f : forall a. (a) -> Int fun f(x) { 1 } } module B { sig f : forall a. (a) -> Int fun f(x) { 2 } } open A; var first = ~f; open B; (first(42), ~f[Bool](true))
args : --fresco
stdout : (1, 2) : (Int, Int)

Callback skeletons permit sequenced effects
sig concatMap : forall a,b. ((a)->List b,List a)->List b fun concatMap(f,l) { switch(l) { case [] -> [] case x::xs -> f(x) ++ concatMap(f,xs) } } concatMap(fun(x) { print(intToString(x)); [x] }, [1,2])
args : --fresco
stdout : 12[1, 2] : List Int

Sequenced callback expressions must return unit
sig apply : forall a,b. ((a)->List b,a)->List b fun apply(f,x) { f(x) } apply(fun(x) { x+1; [x] }, 41)
args : --fresco
exit : 1
stderr : @.*Type error:.*

A chained linear result needs supplied callable information
sig apply : forall a::Any,b::Any. ((a)->b,a)->b fun apply(f,x) { f(x) } apply(fun(x) { x }, linfun() { 42 })()
args : --fresco
exit : 1
stderr : @.*Type error:.*

A callback annotation supplies a chained linear result
sig apply : forall a::Any,b::Any. ((a)->b,a)->b fun apply(f,x) { f(x) } apply(fun(x:(() -@ Int)) { x }, linfun() { 42 })()
args : --fresco
stdout : 42 : Int

A result annotation supplies a chained linear result
sig apply : forall a::Any,b::Any. ((a)->b,a)->b fun apply(f,x) { f(x) } (apply(fun(x) { x }, linfun() { 42 }) : () -@ Int)()
args : --fresco
stdout : 42 : Int

A binding retains an inferred linear result
sig apply : forall a::Any,b::Any. ((a)->b,a)->b fun apply(f,x) { f(x) } var k = apply(fun(x) { x }, linfun() { 42 }); k()
args : --fresco
stdout : 42 : Int

An ordinary result annotation rejects a linear result
sig apply : forall a::Any,b::Any. ((a)->b,a)->b fun apply(f,x) { f(x) } (apply(fun(x) { x }, linfun() { 42 }) : () -> Int)()
args : --fresco
exit : 1
stderr : @.*Type error:.*

A supplied unary linear result executes
sig apply : forall a::Any,b::Any. ((a)->b,a)->b fun apply(f,x) { f(x) } (apply(fun(x) { x }, linfun(y) { y+1 }) : (Int) -@ Int)(41)
args : --fresco
stdout : 42 : Int

An annotated modal polymorphic argument retains its bound variable
typename Identity = modal [] (forall a. (a) -> a); sig useId : modal [] ((Identity) -> Int) fun useId(f) { f(42) } useId((fun(x) { x } : Identity))
args : --fresco
stdout : 42 : Int

Two annotated polymorphic arguments retain separate binders
typename Identity = modal [] (forall a. (a) -> a); sig useIds : modal [] ((Identity, Identity) -> (Int, Bool)) fun useIds(f,g) { (f(42),g(true)) } useIds((fun(x) { x } : Identity),(fun(y) { y } : Identity))
args : --fresco
stdout : (42, true) : (Int, Bool)

An annotation outside a polymorphic result still executes
typename Identity = forall a. modal [] ((a) -> a); sig useId : modal [] ((Identity) -> Int) fun useId(f) { f(42) } useId((fun(x) { x } : Identity))
args : --fresco
stdout : 42 : Int

An annotated polymorphic argument rejects a fixed result
typename Identity = modal [] (forall a. (a) -> a); sig useId : modal [] ((Identity) -> Int) fun useId(f) { f(42) } useId((fun(x) { 42 } : Identity))
args : --fresco
exit : 1
stderr : @.*Type error:.*

An annotated SpawnWait result retains polymorphic binders
typename Identity = modal [] (forall a. (a) -> a); sig useId : modal [] ((Identity) -> Int) fun useId(f) { f(42) } useId((spawnWait { fun(x) { x } } : Identity))
args : --fresco
stdout : 42 : Int

An annotated modal argument cannot conceal an unavailable effect
effect E { Op : () => Int; } typename Action = modal [] (() -> Int); sig use : modal [] ((Action) -> Int) fun use(f) { f() } handle <E> (use((fun() { do Op } : Action))) { case x -> x case <Op => k> -> k(42) }
args : --fresco --enable-handlers
exit : 1
stderr : @.*Type error:.*

Empty-variant elimination compiles without evaluating its unreachable body
typename Zero=[||]; sig absurd:(Zero)->Int fun absurd(x) { switch(x) {} } 42
args : --fresco
stdout : 42 : Int

Empty switches keep unknown scrutinee types and arbitrary results
sig absurd:forall a::Any,b::Any.(a)->b fun absurd(x) { switch(x) {} } 42
args : --fresco
stdout : 42 : Int

Empty switches accept open variant rows
sig absurd:forall r::Row(Any).([|r|])->Int fun absurd(x) { switch(x) {} } 42
args : --fresco
stdout : 42 : Int

Empty switches retain polymorphic results
sig absurd:([||])->(forall a.(a)->a) fun absurd(x) { switch(x) {} } 42
args : --fresco
stdout : 42 : Int

Empty switches retain modal results
sig absurd:([||])->modal [] (() -> Int) fun absurd(x) { switch(x) {} } 42
args : --fresco
stdout : 42 : Int

Empty switches retain linear function results
sig absurd:([||])->(() -@ Int) fun absurd(x) { switch(x) {} } 42
args : --fresco
stdout : 42 : Int

Empty switches resolve a module-qualified Zero alias
open import FrescoPrelude; sig absurd:(FrescoPrelude.Zero)->Int fun absurd(x) { switch(x) {} } 42
args : --fresco --path=lib/stdlib
stdout : 42 : Int

An aborting empty switch preserves scrutinee effect order
effect Abort { Stop : () => [||]; } { print("a"); handle <Abort> (switch({print("b"); do Stop}) {}) { case x -> x case <Stop => k> -> print("c"); 42 } }
args : --fresco --enable-handlers
stdout : abc42 : Int

An inferred empty-variant scrutinee executes through its handler
typename Zero=[||]; effect Abort { Stop : () => Zero; } sig noValue:modal [Abort] (() -> Zero) fun noValue() { do Stop } handle <Abort> (switch(noValue()) {}) { case x -> x case <Stop => k> -> 42 }
args : --fresco --enable-handlers
stdout : 42 : Int

Applied empty switches fill lambda argument skeletons
effect Abort { Stop : () => [||]; } handle <Abort> ((switch(do Stop) {})(fun(x) { x })) { case x -> x case <Stop => k> -> 42 }
args : --fresco --enable-handlers
stdout : 42 : Int

Applied empty switches retain supplied polymorphic argument types
effect Abort { Stop : () => [||]; } sig id:forall a.(a)->a fun id(x) { x } handle <Abort> ((switch(do Stop) {})(~id)) { case x -> x case <Stop => k> -> 42 }
args : --fresco --enable-handlers
stdout : 42 : Int

Applied empty switches fill linear lambda argument skeletons
effect Abort { Stop : () => [||]; } handle <Abort> ((switch(do Stop) {})(linfun(x) { x })) { case x -> x case <Stop => k> -> 42 }
args : --fresco --enable-handlers
stdout : 42 : Int

Chained empty switches fill both argument skeletons
effect Abort { Stop : () => [||]; } sig id:forall a.(a)->a fun id(x) { x } handle <Abort> ((switch(do Stop) {})(fun(x) { x })(~id)) { case x -> x case <Stop => k> -> 42 }
args : --fresco --enable-handlers
stdout : 42 : Int

An empty switch can provide an ascribed linear function shape
effect Abort { Stop : () => [||]; } handle <Abort> (((switch(do Stop) {}) : (() -@ Int))()) { case x -> x case <Stop => k> -> 42 }
args : --fresco --enable-handlers
stdout : 42 : Int

An empty switch cannot hide a scrutinee effect in its result modality
effect E { Read : () => Int; } sig fail:()->modal [E] (() -> Int) fun fail() { switch(do Read) {} } ()
args : --fresco --enable-handlers
exit : 1
stderr : @.*Type error:.*

An empty switch retains conservative unused linear resource checks
fun(c:End,z:[||]) { switch(z) {} }
args : --fresco
exit : 1
stderr : @.*Type error:.*usage requirement.*

An empty switch may consume a linear scrutinee without extra effects
sig fail:(End)->Int fun fail(c) { switch(c) {} } 42
args : --fresco
stdout : 42 : Int

Reached empty switches on integers retain match failure
switch(42) {}
args : --fresco
exit : 1
stderr : @.*Evalir.Exceptions.Wrong.*

Reached empty switches on inhabited variants retain match failure
switch(A) {}
args : --fresco
exit : 1
stderr : @.*Evalir.Exceptions.Wrong.*

An empty switch evaluates its scrutinee once before failing
switch({print("s"); 42}) {}
args : --fresco
stdout : s
exit : 1
stderr : @.*Evalir.Exceptions.Wrong.*

An aborting empty switch preserves a linear endpoint result
effect Abort { Stop : () => [||]; } var ap=(new() : AP(End)); var peer=spawn { close(accept(ap)) }; close(handle <Abort> ((switch(do Stop) {}) : End) { case c -> c case <Stop => k> -> request(ap) })
args : --fresco --enable-handlers
stdout : () : ()

Explicit variant widening preserves the original constructor
typename Narrow=[|A- |B|]; typename Wide=[|A:Int|B|]; switch(B : Wide <- Narrow) {case A(n) -> n case B -> 42}
args : --fresco
stdout : 42 : Int

Explicit record narrowing preserves retained fields
((x=42,y=true) : (x:Int) <- (x:Int,y:Bool)).x
args : --fresco
stdout : 42 : Int

Explicit widths recurse through ordinary payloads
typename Narrow=[|B|]; typename Wide=[|A:Int|B|]; var r=((value=B) : (value:Wide) <- (value:Narrow)); switch(r.value) {case A(n) -> n case B -> 42}
args : --fresco
stdout : 42 : Int

Explicit masks shield labels in an instantiated shared tail
sig extend:forall a::Any,r::Row(Any).([|A- |r|])->[|A:a|r|] fun extend(x) {(x:[|A:a|r|]<-[|A- |r|])} switch(~extend[Bool,{A:Int,B:()}](B)) {case A(n) -> if(n) 1 else 0 case B -> 42}
args : --fresco
stdout : 42 : Int

Shared presence parameters remain fixed during widening
sig extend:forall p::Presence(Any),r::Row(Any).([|A{p}|B- |r|])->[|A{p}|B|r|] fun extend(x) {(x:[|A{p}|B|r|]<-[|A{p}|B- |r|])} switch(~extend[{:Int},{}](A(42))) {case A(n) -> n case B -> 0}
args : --fresco
stdout : 42 : Int

Explicit function widths retain variance and arity
typename Narrow=[|B|]; typename Wide=[|A:Int|B|]; sig f:(Wide)->Narrow fun f(x){switch(x){case A(n)->B case B->B}} var g=(f:(Narrow)->Wide<-(Wide)->Narrow); switch(g(B)){case A(n)->n case B->42}
args : --fresco
stdout : 42 : Int

Record narrowing preserves an accessible linear endpoint
var ap=(new():AP(End)); var peer=spawn {close(accept(ap))}; var r=((keep=request(ap),drop=42):(keep:End)<-(keep:End,drop:Int)); close(r.keep)
args : --fresco
stdout : () : ()

Every retained payload must satisfy an explicit upcast
((x=42,y=1) : (x:Bool,y:Int) <- (x:Int,y:Int))
args : --fresco
exit : 1
stderr : @.*Type error:.*Explicit upcast.*

Record narrowing cannot hide a linear field
fun(c:End){((drop=c):()<-(drop:End))}
args : --fresco
exit : 1
stderr : @.*Type error:.*Explicit upcast.*

A shared open record tail does not prove an omitted label absent
sig strip:forall rho::Row.((|rho))->((x:Int|rho))->(|rho) fun strip(w)(r){(r:(|rho)<-(x:Int|rho))} (strip((x=true))((x=42)) : (x:Bool))
args : --fresco
exit : 1
stderr : @.*Type error:.*Explicit upcast.*

A shared open variant tail cannot be overwritten without an absence mask
sig bad:forall r::Row.([|r|])->[|A:Int|r|] fun bad(x){(x:[|A:Int|r|]<-[|r|])} bad
args : --fresco
exit : 1
stderr : @.*Type error:.*Explicit upcast.*

An explicit function upcast cannot change runtime arity
sig f:(Int)->Int fun f(x){x} (f:(Int,Bool)->Int<-(Int)->Int)
args : --fresco
exit : 1
stderr : @.*Type error:.*Explicit upcast.*

An explicit upcast cannot make a contextual function absolute
effect E {Read:()=>Int;} handle <E> ({var f=fun(){do Read};(f:modal [] (() -> Int)<-(() -> Int))}) {case f->f case <Read => k> -> k(42)}
args : --fresco --enable-handlers
exit : 1
stderr : @.*Type error:.*Explicit upcast.*

Ordinary annotations do not acquire implicit width subtyping
