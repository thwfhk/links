Imported infix helper retains ordinary type parameters
import Infix; freeze(Infix.A.run)
stdout : fun : forall a::(Any,Any),b::(Any,Any),c::(Any,Any).modal [] (((a::Any, b::Any) -> c::Any, a::Any, b::Any) -> c::Any)
args : --fresco --path=tests/modules --set=typecheck_ir=true --set=fail_on_ir_type_error=true --set=recheck_frontend_transformations=true --set=show_quantifiers=true --set=hide_fresh_type_vars=false

Imported infix callbacks retain polymorphism and caller effects
import Infix; effect Reader { Ask : () => Int; } handle <Reader> ((Infix.A.run((+),20,22), Infix.A.run(fun(x,y) {if(x) do Ask+y else y},true,2))) {case x -> x case <Ask => k> -> k(40)}
stdout : (42, 42) : (Int, Int)
args : --fresco --path=tests/modules --set=typecheck_ir=true --set=fail_on_ir_type_error=true --set=recheck_frontend_transformations=true --enable-handlers

Imported infix helper retains linear arguments and results
import Infix; var ap=(new():AP(End)); var p=spawn {close(accept(ap))}; var c=Infix.A.run(fun(c:End,n:Int) {c},request(ap),42); var closed = close(c); 42
stdout : 42 : Int
args : --fresco --path=tests/modules --set=typecheck_ir=true --set=fail_on_ir_type_error=true --set=recheck_frontend_transformations=true
