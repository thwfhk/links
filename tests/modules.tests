Repeated imports in one input share effect declarations
import Effect_identity; var first = Effect_identity.readEffect; import Effect_identity; var second = Effect_identity.readEffect; handle(first() + second()) { case <Effect_identity.Ask => k> -> k(21) }
args : --path=tests/modules
stdout : 42 : Int

