sig k : forall a,e::Row,f::Row. (a) -e-> (List a) -f-> a
fun k(d)(xs) {
  switch(xs) {
    case [] -> d
    case x :: _ -> x
  }
}

sig h : forall e::Row. (Int) -e-> forall a,e::Row. (a) -e-> a
fun h(_) { ~id }

sig lst : List (forall e::Row,a,f::Row. (Int) -e-> (a) -f-> a)
var lst = [];

k($(fun(x){h(x)@}))(lst)
