effect State(a::Abs) { Get : () => a; Put : (a) => (); }

sig hstate : forall a::Abs,b::Abs. (<State(a)> (() -> b)) -> () -> (a) -> (b,a)
fun hstate (m)() {
    handle (m()) {
        case x -> fun (s) { (x,s) }
        case <Get => k>     -> fun (s) { k(s)(s) }
        case <Put(s') => k> -> fun (s) { k(())(s') }
    }
}


sig f : [State(Int)] (() -> ())
fun f () {
    var x = do Get() ;
    do Put(2*x) ;
    ()
}

effect Reader(a::Abs) { Ask : () => a; }

sig hreader : forall a::Abs. (<Reader(Int)> (() -> a)) -> () -> a
fun hreader (m)() {
    handle (m()) {
           case x -> x
           case <Ask => k> -> k (-42)
    }
}

sig g : [State(Int), Reader(Int)] (() -> Int)
fun g () {
    var x = do Get() ;
    var y = do Ask() ;
    do Put(2*x) ;
    y + do Get()
}

( hstate(f)()(21) , hstate(fun() { hreader(g)() })()(21) , hreader(fun () { hstate(g)()(21) })() )
