---
config: tests/fresco_actors.config
---

A spawned mailbox receives the sent type
var p = spawn { print(intToString(recv()+1)) }; p ! 41
args : --fresco
stdout : 42() : ()

A mismatched mailbox message rejects
var p = spawn { print(intToString(recv()+1)) }; p ! "41"
args : --fresco
exit : 1
stderr : @.*Type error:.*

Receive cases execute through the existing mailbox
var p = spawn { receive { case Value(x) -> print(intToString(x)) } }; p ! Value(42)
args : --fresco
stdout : 42() : ()

Nested spawned mailboxes have separate types
var p = spawn { var outer = self(); var q = spawn { outer ! intToString(recv()) }; q ! 42; print(recv()) }; ()
args : --fresco
stdout : 42() : ()

Recv requires a mailbox context
recv()
args : --fresco
exit : 1
stderr : @.*Type error:.*

Self requires a mailbox context
self()
args : --fresco
exit : 1
stderr : @.*Type error:.*

A caller's handler is unavailable in a spawned body
effect E { Op : () => Int; } handle <E> (spawn { do Op }) { case p -> () case <Op => k> -> k(42) }
args : --fresco
exit : 1
stderr : @.*Type error:.*

A spawned body can install its own handler
effect E { Op : () => Int; } var p = spawn { print(intToString(handle <E> (do Op) { case x -> x case <Op => k> -> k(42) })) }; ()
args : --fresco
stdout : 42() : ()

A spawned body accepts an absolute capture
var f = (fun() { 42 } : modal [] (() -> Int)); var p = spawn { print(intToString(f())) }; ()
args : --fresco
stdout : 42() : ()

A spawned body rejects a contextual capture
var f = fun() { 42 }; var p = spawn { print(intToString(f())) }; ()
args : --fresco
exit : 1
stderr : @.*Type error:.*

A spawned body consumes an absolute linear capture once
var once = (linfun() { 42 } : modal [] (() -@ Int)); var p = spawn { print(intToString(once())) }; ()
args : --fresco
stdout : 42() : ()

A spawned body cannot discard a linear result
spawn { linfun() { 42 } }
args : --fresco
exit : 1
stderr : @.*Type error:.*

A mailbox transfers an absolute linear message
typename Message = modal [] (() -@ Int); var p = (spawn { var f = ~recv[Message](); print(intToString(f())) } : Process(Message)); p ! (linfun() { 42 } : Message)
args : --fresco
stdout : 42() : ()

Receive syntax uses the mailbox when recv is shadowed
fun recv() { 0 } var p = spawn { receive { case Value(x) -> print(intToString(x)) } }; p ! Value(42)
args : --fresco
stdout : 42() : ()

Spawn uses its own location when here is shadowed
fun here() { error("shadowed here called") } var p = spawn { print("child") }; ()
args : --fresco
stdout : child() : ()

The send section executes
var p = spawn { print(intToString(recv())) }; (!)(p,42)
args : --fresco
stdout : 42() : ()

Actor syntax retains its built-in Process type under alias shadowing
typename Process(a) = Int; var p = spawn { print(intToString(recv())) }; p ! 42
args : --fresco
stdout : 42() : ()

A shadowed Process alias cannot make an integer a process identifier
typename Process(a) = Int; 0 ! 42
args : --fresco
exit : 1
stderr : @.*Type error:.*

Actor syntax retains its built-in Location type under alias shadowing
typename Location = Int; var p = spawn { print("child") }; ()
args : --fresco
stdout : child() : ()

A process identifier can transfer two linear messages
typename Message = modal [] (() -@ Int); var p = (spawn { var f = ~recv[Message](); var g = ~recv[Message](); print(intToString(f()+g())) } : Process(Message)); { p ! (linfun() { 20 } : Message); p ! (linfun() { 22 } : Message) }
args : --fresco
stdout : 42() : ()

Receive syntax retains a supplied modal mailbox type
typename Message = modal [] (() -@ Int); var p = (spawn { receive { case f -> print(intToString(f())) } } : Process(Message)); p ! (linfun() { 42 } : Message)
args : --fresco
stdout : 42() : ()

A signed caller supplies the spawned mailbox type
typename Message = modal [] (() -@ Int); sig deliver : modal [Wild] ((Process(Message)) -> ()) fun deliver(p) { p ! (linfun() { 42 } : Message) } deliver(spawn { receive { case f -> print(intToString(f())) } })
args : --fresco
stdout : 42() : ()

The full spawn check rejects an incompatible inherited mailbox type
typename Message = modal [] (() -@ Int); sig deliver : modal [Wild] ((Process(Int)) -> ()) fun deliver(p) { p ! 42 } deliver(spawn { var f = ~recv[Message](); f() })
args : --fresco
exit : 1
stderr : @.*Type error:.*

A mailbox transfers a frozen polymorphic message
typename Message = modal [] (forall a. (a) -> a); var msg = (fun(x) { x } : Message); var p = (spawn { receive { case f -> print(intToString(f(42))) } } : Process(Message)); p ! ~msg
args : --fresco
stdout : 42() : ()

SpawnAt evaluates its location once before the child
var p = spawnAt({ print("location"); here() }, { print("child") }); ()
args : --fresco
stdout : locationchild() : ()

An explicit location uses the caller's handler
effect Place { Where : () => Location; } handle <Place> (spawnAt(do Where, { print("child") })) { case p -> () case <Where => k> -> k(here()) }
args : --fresco
stdout : child() : ()

SpawnAt rejects a non-location argument
spawnAt(42, { () })
args : --fresco
exit : 1
stderr : @.*Type error:.*

SpawnAngel executes its child
var p = spawnAngel { print("angel") }; ()
args : --fresco
stdout : angel() : ()

SpawnAngelAt executes at the supplied location
var p = spawnAngelAt(here(), { print("angel") }); ()
args : --fresco
stdout : angel() : ()

SpawnWait returns the child's result
spawnWait { 42 }
args : --fresco
stdout : 42 : Int

SpawnWait has a fresh mailbox
spawnWait { var outer = self(); var p = spawn { outer ! intToString(recv()) }; p ! 42; recv() }
args : --fresco
stdout : "42" : String

Nested SpawnWait bodies have separate mailbox types
spawnWait { self() ! 40; var extra = spawnWait { self() ! "ab"; strlen(recv()) }; recv()+extra }
args : --fresco
stdout : 42 : Int

SpawnWait consumes an absolute linear capture
var once = (linfun() { 42 } : modal [] (() -@ Int)); spawnWait { once() }
args : --fresco
stdout : 42 : Int

SpawnWait returns an absolute linear function
var once = spawnWait { (linfun() { 42 } : modal [] (() -@ Int)) }; once()
args : --fresco
stdout : 42 : Int

SpawnWait rejects a relative function result
spawnWait { fun() { recv() } }
args : --fresco
exit : 1
stderr : @.*Type error:.*

SpawnWait cannot call a captured contextual function
var f = fun() { 42 }; spawnWait { f() }
args : --fresco
exit : 1
stderr : @.*Type error:.*

SpawnWait does not transfer a caller's handler
effect E { Op : () => Int; } handle <E> (spawnWait { do Op }) { case x -> x case <Op => k> -> k(42) }
args : --fresco
exit : 1
stderr : @.*Type error:.*

SpawnWait permits a handler installed inside the child
effect E { Op : () => Int; } spawnWait { handle <E> (do Op) { case x -> x case <Op => k> -> k(42) } }
args : --fresco
stdout : 42 : Int

SpawnWait retains a supplied polymorphic result
typename Identity = modal [] (forall a. (a) -> a); var id = (spawnWait { fun(x) { x } } : Identity); (id(42), id(true))
args : --fresco
stdout : (42, true) : (Int, Bool)

SpawnAt retains a supplied linear mailbox type
typename Message = modal [] (() -@ Int); var p = (spawnAt(here(), { receive { case f -> print(intToString(f())) } }) : Process(Message)); p ! (linfun() { 42 } : Message)
args : --fresco
stdout : 42() : ()

SpawnWait restores the caller's mailbox context
var n = spawnWait { 42 }; recv()
args : --fresco
exit : 1
stderr : @.*Type error:.*

HaveMail requires a mailbox context
haveMail()
args : --fresco
exit : 1
stderr : @.*Type error:.*

A spawn location receives from the caller's mailbox
spawnWait { self() ! here(); var p = spawnAt(recv(), { print(intToString(recv())) }); p ! 42; () }
args : --fresco
stdout : 42() : ()

A signed caller supplies a polymorphic SpawnWait result
typename Identity = modal [] (forall a. (a) -> a); sig useId : modal [] ((Identity) -> Int) fun useId(f) { f(42) } useId(spawnWait { fun(x) { x } })
args : --fresco
stdout : 42 : Int

A SpawnWait result transfers through a linear mailbox
typename Message = modal [] (() -@ Int); var p = (spawn { receive { case f -> print(intToString(f())) } } : Process(Message)); p ! spawnWait { (linfun() { 42 } : Message) }
args : --fresco
stdout : 42() : ()

Client spawning and mailbox polling lower with checked IR
sig start : modal [Wild] (() -> ()) fun start() { var p = spawnClient { if (haveMail()) recv()+1 else 0 }; () } ()
args : --fresco
stdout : () : ()
