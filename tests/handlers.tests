Nullary operation with native permission
effect Reader { Read : () => Int; } (fun() { print("Reading"); do Read } : [Reader, wild] (() -> Int))
stdout : fun : [Reader, wild] (() -> Int)

Absolute native permission
fun(g : [wild] (() -> ())) { g }(fun(){ print("Hello") })
stdout : fun : [wild] (() -> ())

Implicit return case (1)
handle(42) { }
stdout : 42 : Int

Implicit return case (2)
effect Operation { Op : () => Bool; } handle(do Op) { case <Op => resume> -> resume(true) }
stdout : true : Bool

Omission of resumption for nullary operations (1)
effect Foo { Foo : () => Int; } handle(do Foo) { case <Foo> -> 5 }
stdout : 5 : Int

Omission of resumption for nullary operations (2)
effect Foo { Foo : () => Int; } handle(do Foo) { case <Foo => _> -> 6 }
stdout : 6 : Int

Omission of resumption for nullary operations (3)
effect Foo { Foo : () => Int; } fun(m : <Foo> (() -> Int)) { handle(m()) { case <Foo> -> 5 } }
stdout : fun : (<Foo> (() -> Int)) -> Int

Operation annotation (1)
effect Foo { Foo : (Int) => Int; } fun(m : <Foo> (() -> Int)) { handle(m()) { case <Foo(x) => k> : ((Int) => Int) -> k (x) } }
stdout : fun : (<Foo> (() -> Int)) -> Int

Operation annotation (2)
effect Foo { Foo : (Bool) => Int; } fun(f : ((Bool) -> Int))(m : <Foo> (() -> Int)) { handle(m()) { case <Foo(x : Bool) => k> -> k (f (x)) } }
stdout : fun : ((Bool) -> Int) -> (<Foo> (() -> Int)) -> Int

Operation annotation (3)
effect Foo { Foo : (Int) => [] (() -> (Int, Int)); } fun(m : <Foo> (() -> Int)) { handle(m()) { case <Foo(x) => k> : ((Int) => [] (() -> (Int, Int))) -> k ( fun () { (x,x) } ) } }
stdout : fun : (<Foo> (() -> Int)) -> Int

Handled operation is available inside its handler
effect Reader { Ask : () => Int; } sig ask : [Reader] (() -> Int) fun ask() { do Ask } sig read : [] (() -> Int) fun read() { handle(ask()) { case <Ask => k> -> k(42) } } read()
stdout : 42 : Int

Unhandled operation is unavailable inside a return-only handler
effect Reader { Ask : () => Int; } sig ask : [Reader] (() -> Int) fun ask() { do Ask } sig read : [] (() -> Int) fun read() { handle(ask()) { case x -> x } } read()
stderr : @.*Type error: The modalities require different effect contexts.*
exit : 1

Applying a linear function to an operation result
effect Choice { Choose : () => Bool; } sig applyChoice : [Choice] (((String) -@ ()) -> ()) fun applyChoice(f) {f(if (do Choose) "A" else "B")} applyChoice
stdout : fun : [Choice] (((String) -@ ()) -> ())

Repeated resumption of a computation using a linear local
effect Reader { Ask : () => Int; } { var f = (linfun(x) { x + 1 } : [] ((Int) -@ Int)); handle(f(do Ask)) { case <Ask => k> -> k(19) + k(21) } }
stdout : 42 : Int

Deep handler operation clause can use a linear argument
effect Foo { Foo : ([] (() -@ Int)) => Int; } var lf = (linfun() { 42 } : [] (() -@ Int)); handle(do Foo(lf) + 42) { case <Foo(f : ([] (() -@ Int))) => k> -> k(f()) }
stdout : 84 : Int

Deep handler operation clause cannot use a linear local
effect Foo { Foo : () => Int; } var lf = linfun() { 42 }; handle(do Foo + 42) { case <Foo => k> -> k(lf()) }
stderr : @.*Type error: Variable lf has a linear type*
exit : 1

Shallow handler operation clause can use a linear local
effect Foo { Foo : () => Int; } var lf = linfun() { 42 }; shallowhandle(do Foo + 42) { case <Foo -> k> -> var n = lf(); handle(k(n)) { case <Foo => resume> -> resume(0) } }
stdout : 84 : Int

Shallow handler cannot use a linear local twice
effect Foo { Foo : () => Int; } fun() { var lf = (linfun(x) {x} : [] ((Int) -@ Int)); shallowhandle(lf(do Foo)) { case <Foo -> k> -> var n = lf(42); handle(k(n)) { case <Foo => next> -> next(0) } } }
stderr : @.*Type error: Variable lf has a linear type*
exit : 1

Shallow handler return clause can use a linear local
{ var f = linfun(x) { x + 1 }; shallowhandle(41) { case n -> f(n) } }
stdout : 42 : Int

Deep handler return clause cannot use a linear local
{ var f = linfun(x) { x + 1 }; handle(41) { case n -> f(n) } }
stderr : @.*Type error: Variable f has a linear type*
exit : 1

Deep handler return clause can use its linear result once
handle(linfun(n) { n + 1 }) { case f : ((Int) -@ Int) -> f(41) }
stdout : 42 : Int

Deep handler return clause cannot use its linear result twice
handle(linfun(n) { n + 1 }) { case f : ((Int) -@ Int) -> f(20) + f(20) }
stderr : @.*Type error: Variable f has a linear type*
exit : 1

A state resumption checks the type of its next state
effect State(a::Abs) { Get : () => a; Put : (a) => (); } handle({ var n = do Get; do Put(n + 2); do Get })(state <- 40) { case <Get => k> -> k(state, state) case <Put(n) => k> -> k((), true) }
stderr : @.*Expected Int, got Bool.*
exit : 1

A handler cannot choose a polymorphic operation's result type
effect Failure { Fail : forall a::Abs. () => a; } sig f : [Failure] (() -> Int) fun f() { if (do Fail) 42 else do Fail } handle(f()) { case <Fail => k> -> k(42) }
stderr : @.*Expected .*::Abs, got Int.*
exit : 1

