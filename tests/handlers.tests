Operation polymorphism (1)
effect Failure { Fail : forall a::Abs. () => a; } sig catch : forall b::Abs. (<Failure> (() -> b)) -> Maybe(b) fun catch(m) { handle(m()) { case <Fail => k> : (forall a::Abs. () => a) -> Nothing case x -> Just(x) } } catch(fun() { 42 })
