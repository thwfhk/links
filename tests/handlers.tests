Shallow addition with a single recursive handler
effect Counting { One : () => Int; } { sig h1 : (<Counting> (() -> Int)) -> Int fun h1(m) { shallowhandle(m()) { case <One -> k> -> h1(fun() { k(1) }) case x -> x - 1 } } h1(fun() { do One + do One }) }
stdout : 1 : Int

Shallow addition with two mutual recursive handlers
effect Counting { One : () => Int; } { sig h1 : (<Counting> (() -> Int)) -> Int fun h1(m) { shallowhandle(m()) { case <One -> k> -> h1(fun() { k(1) }) } } sig h2 : (<Counting> (() -> Int)) -> Int fun h2(m) { shallowhandle(m()) { case <One -> k> -> h1(fun() { k(2) }) } } h2(fun() { do One + do One }) }
stdout : 3 : Int

Shallow handler composition
effect E2 { Op2 : () => Int; } effect E1 { Op1 : () => Int; } sig h1 : (<E1> (() -> Int)) -> () -> Int fun h1(m)() { shallowhandle(m()) { case <Op1 -> k> -> h1(fun() { k(1) })() } } sig h2 : (<E2> (() -> Int)) -> () -> Int fun h2(m)() { shallowhandle(m()) { case <Op2 -> k> -> h2(fun() { k(2) })() } } h1(fun() { h2(fun() { do Op1 + do Op2 })() })()
stdout : 3 : Int

A shallow resumption runs under a new handler and skips the original return clause
effect Steps { Next : () => Int; } shallowhandle(do Next + do Next) { case <Next => k> -> [handle(k(20)) { case <Next => resume> -> resume(22) }] case n -> [n + 100] }
stdout : [42] : List Int

