Deep state handling (1)
effect State { Get : () => Int; Put : (Int) => (); } {sig state : (<State> (() -> Int)) -> (Int) -> Int fun state(m) { handle(m()) { case <Get => k> -> fun(s) { k(s)(s) } case <Put(p) => k> -> fun(s) { k(())(p) } case x -> fun(s) { x } } } sig runState : (Int, <State> (() -> Int)) -> Int fun runState(s0, c) { var f = state(c); f(s0) } runState(2, fun() { var s = do Get; do Put(s + 1); var s = do Get; do Put(s + s); do Get }) }
stdout : 6 : Int

Deep state handling (2)
effect State { Get : () => Int; Put : (Int) => (); } {sig state : (<State> (() -> Int)) -> (Int) -> Int fun state(m)(s) { handle(m())(s <- s) { case <Get => k> -> k(s,s) case <Put(p) => k> -> k((),p) case x -> x } } sig runState : (Int, <State> (() -> Int)) -> Int fun runState(s0, c) { state(c)(s0) } runState(2, fun() { var s = do Get; do Put(s + 1); var s = do Get; do Put(s + s); do Get }) }
stdout : 6 : Int

