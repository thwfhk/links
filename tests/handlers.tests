An operation pattern handler accepts an extra open-row payload
effect Moving(a::Type(Any,Any,Abs), b::Type(Any,Any,Abs)) { Move : (a) => b; } sig test : forall r::Row,b::Type(Any,Any,Abs). (modal <Moving(modal [] [|Alice|Bob|r|], b)> (() -> Char)) -> Char fun test(m) { handle <Moving(modal [] [|Alice|Bob|r|], b)> (m()) { case <Move(person)> -> switch(person) { case Alice -> 'A' case Bob -> 'B' case _ -> 'U' } case x -> x } } ~test[{Other:Int},Int](fun() { var _ = do Move(Other(42)); 'X' })
stdout : 'U' : Char
args : --fresco --enable-handlers

