Recursive nesting of deep handlers
{ fun h1(m,h) { handle(m()) { case <Foo => k> -> h(fun() { k(()) },h1) case x -> x } } fun h2(m,h) { handle(m()) { case <Foo => k> -> h(fun() { k(()) },h2) case x -> x } } h1(fun(){42},h2) }
stdout : 42 : Int
args : --enable-handlers

Parameterised handler with multiple parameters (1)
effect Steps { A : () => (); B : () => (); C : () => (); D : () => (); } handle({do A; do B; do C; do D})(a <- 0, b <- 1, c <- 2, d <- 3) { case <A => k> -> k((),a+1,b,c,d) case <B => k> -> k((),a,b+1,c,d) case <C => k> -> k((),a,b,c+1,d) case <D => k> -> k((),a,b,c,d+1) case _ -> (a,b,c,d) }
stdout : (1, 2, 3, 4) : (Int, Int, Int, Int)
args : --fresco --enable-handlers

Parameterised handler with multiple parameters (2)
effect Steps { A : () => (); B : () => (); C : () => (); D : () => (); } handle({do A; do B; do C; do D})(a <- 0, b <- false, (c0, c1) as c <- (true,0), d <- "Hello") { case <A => k> -> k((),a+1,b,c,d) case <B => k> -> k((),a,not(b),c,d) case <C => k> -> k((),a,b,(not(c0), c1+1),d) case <D => k> -> k((),a,b,c,d ^^ " World") case _ -> (a,b,c,d) }
stdout : (1, true, (false, 1), "Hello World") : (Int, Bool, (Bool, Int), String)
args : --fresco --enable-handlers

