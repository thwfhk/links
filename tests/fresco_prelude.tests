---
config: tests/fresco_prelude.config
---

The collection prelude retains map polymorphism
open import FrescoPrelude; (map(fun(x) { x+1 }, [1,2]), map(fun(x) { not(x) }, [true,false]))
args : --fresco --path=lib/stdlib
stdout : ([2, 3], [false, true]) : (List Int, List Bool)

Map callbacks use the caller's handled effect
open import FrescoPrelude; effect Offset { Get : () => Int; } handle <Offset> (map(fun(x) { x + do Get }, [1,2])) { case xs -> xs case <Get => k> -> k(40) }
args : --fresco --path=lib/stdlib
stdout : [41, 42] : List Int

Iter callbacks retain source order and Wild
open import FrescoPrelude; { iter(fun(x) { print(intToString(x)) }, [1,2,3]); 42 }
args : --fresco --path=lib/stdlib
stdout : 12342 : Int

An unhandled map callback rejects
open import FrescoPrelude; effect Offset { Get : () => Int; } map(fun(x) { x + do Get }, [1,2])
args : --fresco --path=lib/stdlib
exit : 1
stderr : @.*Type error:.*

A pure map caller rejects a Wild callback
open import FrescoPrelude; sig f : () -> List () fun f() { map(print, ["a"]) } f()
args : --fresco --path=lib/stdlib
exit : 1
stderr : @.*Type error:.*

Map rejects a callback that captures a linear value
open import FrescoPrelude; { var once = linfun() { 42 }; map(fun(x) { once()+x }, [1,2]) }
args : --fresco --path=lib/stdlib
exit : 1
stderr : @.*Type error:.*

Folds retain callback order
open import FrescoPrelude; (fold_left(fun(a,x) { a*10+x }, 0, [1,2,3]), fold_right(fun(x,a) { a*10+x }, 0, [1,2,3]))
args : --fresco --path=lib/stdlib
stdout : (123, 321) : (Int, Int)

The prelude range includes machine integer bounds
open import FrescoPrelude; (intRange(min_int,min_int)==[min_int], intRange(max_int,max_int)==[max_int])
args : --fresco --path=lib/stdlib
stdout : (true, true) : (Bool, Bool)

SortBy callbacks retain handled effects alongside Wild
open import FrescoPrelude; effect Offset { Get : () => Int; } handle <Offset> (sortBy(fun(x) { x + do Get }, [3,1,2])) { case xs -> xs case <Get => k> -> k(40) }
args : --fresco --path=lib/stdlib
stdout : [1, 2, 3] : List Int

SortByBase rejects function-valued keys
open import FrescoPrelude; sortByBase(fun(x) { (key=fun(y) { x+y }) }, [1,2])
args : --fresco --path=lib/stdlib
exit : 1
stderr : @.*Type error:.*

Frozen map retains polymorphic elements
open import FrescoPrelude; typename Identity = forall a. modal [] ((a) -> a); sig id : Identity fun id(x) { x } var xs = ~map[Identity,Identity](fun(x) { ~x }, [~id]); switch(xs) { case f::_ -> (f(42),f(true)) case [] -> (0,false) }
args : --fresco --path=lib/stdlib
stdout : (42, true) : (Int, Bool)

Curry retains a handled callback effect
open import FrescoPrelude; effect Offset { Get : () => Int; } handle <Offset> (curry(fun(x,y) { x+y+do Get })(1)(1)) { case x -> x case <Get => k> -> k(40) }
args : --fresco --path=lib/stdlib
stdout : 42 : Int

A returned curried callback retains its effect requirement
open import FrescoPrelude; effect Offset { Get : () => Int; } var step = handle <Offset> (curry(fun(x,y) { x+y+do Get })(1)) { case f -> f case <Get => k> -> k(40) }; step(1)
args : --fresco --path=lib/stdlib
exit : 1
stderr : @.*Type error:.*

Tuple helpers accept larger tuples
open import FrescoPrelude; (first((42,true,"x")), tenth((1,2,3,4,5,6,7,8,9,true,"x")))
args : --fresco --path=lib/stdlib
stdout : (42, true) : (Int, Bool)

Indexed map preserves index and evaluation order
open import FrescoPrelude; mapi(fun(x,i) { print(intToString(i)); x+i }, [40,41])
args : --fresco --path=lib/stdlib
stdout : 01[40, 42] : List Int

Span retains the existing complete-match order
open import FrescoPrelude; span(fun(x) { x > 0 }, [1,2,3])
args : --fresco --path=lib/stdlib
stdout : ([3, 2, 1], []) : (List Int, List Int)

String joining uses the staged helpers
open import FrescoPrelude; unwords(["modal","effects"])
args : --fresco --path=lib/stdlib
stdout : "modal effects" : String

Span callbacks retain handled effects and stopping order
open import FrescoPrelude; effect Limit { Get : () => Int; } handle <Limit> (span(fun(x) { print(intToString(x)); x < do Get }, [1,2,3])) { case xs -> xs case <Get => k> -> k(2) }
args : --fresco --path=lib/stdlib
stdout : 12([1], [2, 3]) : (List Int, List Int)

Indexed map callbacks use the handled context
open import FrescoPrelude; effect Offset { Get : () => Int; } handle <Offset> (mapi(fun(x,i) { x+i+do Get }, [1,1])) { case xs -> xs case <Get => k> -> k(40) }
args : --fresco --path=lib/stdlib
stdout : [41, 42] : List Int

TakeWhile retains its Wild requirement
open import FrescoPrelude; sig f : () -> List Int fun f() { takeWhile(fun(x) { x > 0 }, [1]) } f()
args : --fresco --path=lib/stdlib
exit : 1
stderr : @.*Type error:.*

Search callbacks use handled effects
open import FrescoPrelude; effect Limit { Get : () => Int; } handle <Limit> (fromMaybe(search(fun(x) { x >= do Get }, [1,2,3]), 0)) { case x -> x case <Get => k> -> k(2) }
args : --fresco --path=lib/stdlib
stdout : 2 : Int

Find stops at its first match
open import FrescoPrelude; find(fun(x) { print(intToString(x)); x == 2 }, [1,2,3])
args : --fresco --path=lib/stdlib
stdout : 122 : Int

Numeric helpers retain their empty seeds
open import FrescoPrelude; (max_list([])==min_int, min_list([])==max_int, maxF_list([])==neg_infinity, minF_list([])==infinity)
args : --fresco --path=lib/stdlib
stdout : (true, true, true, true) : (Bool, Bool, Bool, Bool)

Averages retain empty and nonempty results
open import FrescoPrelude; (avg([])==0.0, avg([1,2,3])==2.0, avgF([])==0.0, avgF([1.0,3.0])==2.0)
args : --fresco --path=lib/stdlib
stdout : (true, true, true, true) : (Bool, Bool, Bool, Bool)

Association helpers retain first and all matches
open import FrescoPrelude; var xs = [("x",1),("x",2),("y",3)]; (assoc("x",xs)==1, assocAll("x",xs)==[1,2], removeAssoc("x",xs)==[("x",2),("y",3)], isJust(lookup("y",xs)))
args : --fresco --path=lib/stdlib
stdout : (true, true, true, true) : (Bool, Bool, Bool, Bool)

FromJust retains its Wild requirement
open import FrescoPrelude; sig f : () -> Int fun f() { fromJust(Just(42)) } f()
args : --fresco --path=lib/stdlib
exit : 1
stderr : @.*Type error:.*

Maybe helpers retain their supplied element type
open import FrescoPrelude; (fromMaybe(Just(42),0), fromMaybe(Nothing,true), isJust(Nothing : Maybe (Int)))
args : --fresco --path=lib/stdlib
stdout : (42, true, false) : (Int, Bool, Bool)
