typename RecursiveList(a) = [| Cons:(a, RecursiveList(a)) | Nil |];

sig example : () -> RecursiveList(Int)
fun example() {
    Cons(1, Cons(2, Cons(3, Nil)))
}

sig map : (((a) ~%~> b), RecursiveList(a)) ~> RecursiveList(b)
fun map(f, xs) {
  switch (xs) {
    case Nil -> Nil
    case Cons(x, xs) -> Cons(f(x), map(f, xs))
  }
}

map(fun(x) { x + 1 }, example())
