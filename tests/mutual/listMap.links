typename VariantList(a) = (| Cons:(a, VariantList(a)) | Nil |);

sig example : () -> VariantList(Int)
fun example() {
    Cons(1, Cons(2, Cons(3, Nil)))
}

sig map : (((a) -> b), VariantList(a)) -> VariantList(b)
fun map(f, xs) {
  switch (xs) {
    case Nil -> Nil
    case Cons(x, xs) -> Cons(f(x), map(f, xs))
  }
}

map(fun(x) { x + 1 }, example())
