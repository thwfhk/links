#!/usr/bin/env bash

set -u

roundtrip() {
    local name="$1" bindings="$2" expression="$3"
    shift 3

    local printed printed_type reparsed
    if ! printed=$(./links "$@" -e "$bindings $expression"); then
        echo "FAILURE: $name could not be printed"
        return 1
    fi
    case "$printed" in
        "fun : "*) printed_type=${printed#fun : } ;;
        *)
            echo "FAILURE: $name printed an unexpected result: $printed"
            return 1 ;;
    esac
    if ! reparsed=$(./links "$@" -e "$bindings (($expression) : $printed_type)"); then
        echo "FAILURE: $name could not reparse $printed_type"
        return 1
    fi
    if [[ "$printed" != "$reparsed" ]]; then
        echo "FAILURE: $name changed from $printed to $reparsed"
        return 1
    fi
    echo "SUCCESS: $name"
}

status=0
roundtrip "Absolute interface and native permission in an alias" \
    'effect Reader { Ask : () => Int; } typename Thunk = [wild, Reader] (() -> Int);' \
    'fun() { print("hello"); do Ask } : Thunk' || status=1

roundtrip "Mixed modal and quantified prefixes" \
    'sig f : [] (forall a::Abs. a -> a) fun f(x) {x}' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Quantified presence in an alias argument" \
    'typename Shape(p::Presence(Any,Any)) = (x{p},anchor:Int); sig f : forall p::Presence(Any,Any). (Shape({p})) -> Shape({p}) fun f(r) {r}' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Quantified value type that admits linear values" \
    'sig f : forall a::Any. (a::Any) -> a::Any fun f(x) {x}' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Recursive variant containing an ambient function" \
    'typename Expr = mu x. (|Stop | Step:() -> x|); sig f : Expr -> Expr fun f(x) { x }' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Relative mask followed by an extension" \
    'effect Reader(a::Abs) { Ask : () => a; } sig f : (<Reader | Reader(Int)> (() -> Int)) -> (<Reader | Reader(Int)> (() -> Int)) fun f(x) { x }' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Nested lists and function elements" \
    'sig f : (List (List ([] (Int -> Int)))) -> List (List ([] (Int -> Int))) fun f(xs) { xs }' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Variants and open record rows" \
    'sig f : forall r::Row,s::Row. (List (|None|Some:(x:Int|r)|s|)) -> List (|None|Some:(x:Int|r)|s|) fun f(xs) { xs }' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Empty variants" '' \
    'fun(x : (| |)) { switch (x) { } }' || status=1

roundtrip "Open-only variants with the old printer" \
    'sig f : forall r::Row. ((|r|)) -> (|r|) fun f(x) { x }' \
    '~f' --set=types_pretty_printer_engine=old --set=show_quantifiers=true || status=1

for engine in roundtrip old; do
    roundtrip "Eleven function parameters and tuple fields with the $engine printer" '' \
        'fun(a : Int, b : Bool, c : Int, d : Int, e : Int, f : Int,
             g : Int, h : Int, i : Int, j : String, k : Float) {
             (a, b, c, d, e, f, g, h, i, j, k)
         }' --set=types_pretty_printer_engine="$engine" || status=1

    roundtrip "Absent variant fields with the $engine printer" \
        'sig f : forall r::Row. ((|None{-}|Some:Int|r|)) -> (|None{-}|Some:Int|r|) fun f(x) { x }' \
        '~f' --set=types_pretty_printer_engine="$engine" --set=show_quantifiers=true || status=1

    # Library.Nested.Reader now names the new interface. Nested.previous
    # still has the old interface, so the type ascription checks its identity.
    roundtrip "Interface identity through an open module with the $engine printer" \
        'module Library { module Nested { effect Reader { Ask : () => Int; } sig previous : [Reader] (() -> Int) fun previous() { do Ask } } } open Library; module Library { module Nested { effect Reader { Ask : () => Int; } } }' \
        'Nested.previous' --set=types_pretty_printer_engine="$engine" || status=1

    roundtrip "Mask and extension identity through an open module with the $engine printer" \
        'module Library { module Nested { effect Reader(a::Abs) { Ask : () => a; } sig previous : (<Reader | Reader(Int)> (() -> Int)) -> (<Reader | Reader(Int)> (() -> Int)) fun previous(f) { f } } } open Library; module Library { module Nested { effect Reader(a::Abs) { Ask : () => a; } } }' \
        'Nested.previous' --set=types_pretty_printer_engine="$engine" || status=1

    roundtrip "Shadowed alias with a visible interface name with the $engine printer" \
        'module Library { module Nested { effect Reader { Ask : () => Int; } } }
         open Library;
         typename Thunk = [Library.Nested.Reader] (() -> Int);
         sig previous : Thunk fun previous() { do Library.Nested.Ask }
         module Library { module Nested { effect Reader { Ask : () => Int; } } }
         typename Thunk = Bool;' \
        'previous' --set=types_pretty_printer_engine="$engine" || status=1

    # Nested.Thunk still names the old alias, and its interface has no visible name.
    roundtrip "Alias for a hidden interface through an open module with the $engine printer" \
        'module Effects { effect Reader { Ask : () => Int; } }
         module Library { module Nested {
             typename Thunk = [Effects.Reader] (() -> Int);
             sig previous : Thunk fun previous() { do Effects.Ask }
         } }
         open Library;
         module Effects { effect Reader { Ask : () => Int; } }
         module Library { module Nested { typename Thunk = Bool; } }' \
        'Nested.previous' --set=types_pretty_printer_engine="$engine" || status=1

    roundtrip "Shadowed alias in an alias argument with the $engine printer" \
        'typename Box(a::Abs) = (item:a); typename Value = Int;
         sig f : Box(Value) -> Box(Value) fun f(x) { x }
         typename Value = Bool;' \
        '~f' --set=types_pretty_printer_engine="$engine" || status=1

    roundtrip "Hidden interface in an unused alias argument with the $engine printer" \
        'module Effects { effect Reader { Ask : () => Int; } }
         typename Ignore(a::Abs) = Int;
         sig f : () -> Ignore([Effects.Reader] (() -> Int)) fun f() { 1 }
         module Effects { effect Reader { Ask : () => Int; } }' \
        '~f' --set=types_pretty_printer_engine="$engine" || status=1

    roundtrip "Shadowed parameterised recursive alias with the $engine printer" \
        'typename Expr(a::Abs) = (|Leaf:a|More:Expr(a)|);
         sig f : () -> Expr(Int) fun f() { Leaf(1) }
         typename Expr(a::Abs) = Bool;' \
        '~f' --set=types_pretty_printer_engine="$engine" || status=1

    roundtrip "Shadowed recursive alias with renamed mu arguments with the $engine printer" \
        'typename Expr(a::Abs) = (|Leaf:a|More:Expr(mu x. (|Stop|Next:x|))|);
         sig f : () -> Expr(mu y. (|Stop|Next:y|)) fun f() { Leaf(Stop) }
         typename Expr(a::Abs) = Bool;' \
        '~f' --set=types_pretty_printer_engine="$engine" || status=1

    roundtrip "Shadowed recursive alias with an unused argument with the $engine printer" \
        'typename Ignore(a::Abs) = Int;
         typename Expr(a::Abs) = (|Leaf:a|More:Expr(Ignore(List(a)))|);
         sig f : () -> Expr(Ignore(Bool)) fun f() { Leaf(1) }
         typename Expr(a::Abs) = Bool;' \
        '~f' --set=types_pretty_printer_engine="$engine" || status=1

    roundtrip "Shadowed recursive alias that swaps arguments with the $engine printer" \
        'typename Expr(a::Abs,b::Abs) = (|Leaf:a|More:Expr(b,a)|);
         sig f : () -> Expr(Bool,Int) fun f() { Leaf(true) }
         typename Expr(a::Abs,b::Abs) = Bool;' \
        '~f' --set=types_pretty_printer_engine="$engine" || status=1
done

exit "$status"
