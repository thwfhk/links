#!/usr/bin/env bash

set -u

roundtrip() {
    local name="$1" bindings="$2" expression="$3"
    shift 3

    local printed printed_type reparsed
    if ! printed=$(./links "$@" -e "$bindings $expression"); then
        echo "FAILURE: $name could not be printed"
        return 1
    fi
    case "$printed" in
        "fun : "*) printed_type=${printed#fun : } ;;
        *)
            echo "FAILURE: $name printed an unexpected result: $printed"
            return 1 ;;
    esac
    if ! reparsed=$(./links "$@" -e "$bindings (($expression) : $printed_type)"); then
        echo "FAILURE: $name could not reparse $printed_type"
        return 1
    fi
    if [[ "$printed" != "$reparsed" ]]; then
        echo "FAILURE: $name changed from $printed to $reparsed"
        return 1
    fi
    echo "SUCCESS: $name"
}

status=0
roundtrip "Absolute interface and native permission in an alias" \
    'effect Reader { Ask : () => Int; } typename Thunk = [wild, Reader] (() -> Int);' \
    'fun() { print("hello"); do Ask } : Thunk' || status=1

roundtrip "Mixed modal and quantified prefixes" \
    'sig f : [] (forall a::Abs. a -> a) fun f(x) {x}' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Quantified presence in an alias argument" \
    'typename Shape(p::Presence(Any,Any)) = (x{p},anchor:Int); sig f : forall p::Presence(Any,Any). (Shape({p})) -> Shape({p}) fun f(r) {r}' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Quantified value type that admits linear values" \
    'sig f : forall a::Any. (a::Any) -> a::Any fun f(x) {x}' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Recursive variant containing an ambient function" \
    'typename Expr = mu x. (|Stop | Step:() -> x|); sig f : Expr -> Expr fun f(x) { x }' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Relative mask followed by an extension" \
    'effect Reader(a::Abs) { Ask : () => a; } sig f : (<Reader | Reader(Int)> (() -> Int)) -> (<Reader | Reader(Int)> (() -> Int)) fun f(x) { x }' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Nested lists and function elements" \
    'sig f : (List (List ([] (Int -> Int)))) -> List (List ([] (Int -> Int))) fun f(xs) { xs }' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Variants and open record rows" \
    'sig f : forall r::Row,s::Row. (List (|None|Some:(x:Int|r)|s|)) -> List (|None|Some:(x:Int|r)|s|) fun f(xs) { xs }' \
    '~f' --set=show_quantifiers=true || status=1

roundtrip "Empty variants" '' \
    'fun(x : (| |)) { switch (x) { } }' || status=1

roundtrip "Open-only variants with the old printer" \
    'sig f : forall r::Row. ((|r|)) -> (|r|) fun f(x) { x }' \
    '~f' --set=types_pretty_printer_engine=old --set=show_quantifiers=true || status=1

for engine in roundtrip old; do
    roundtrip "Absent variant fields with the $engine printer" \
        'sig f : forall r::Row. ((|None{-}|Some:Int|r|)) -> (|None{-}|Some:Int|r|) fun f(x) { x }' \
        '~f' --set=types_pretty_printer_engine="$engine" --set=show_quantifiers=true || status=1
done

exit "$status"
