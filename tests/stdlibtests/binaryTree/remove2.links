open import Comparators;
open import BinaryTree;

sig print_list : modal [Wild] ((List Int) -> String)
fun print_list(xs) {
  sig print_list_inner : (List Int) -> String
  fun print_list_inner(xs) {
    switch(xs) {
      case [] -> ""
      case [x] -> intToString(x)
      case x::xs -> intToString(x) ^^ "," ^^ print_list_inner(xs)
    }
  }
  "[" ^^ print_list_inner(xs) ^^ "]"
}

sig test : modal [Wild] (() -> BinaryTree(Int))
fun test() {
  var t = empty();
  var t = add(intComparator, 3, t);
  var t = add(intComparator, 2, t);
  var t = add(intComparator, 1, t);
  var t = add(intComparator, 4, t);
  remove(intComparator, 3, t)
}

test()
