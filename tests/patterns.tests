Absence typing in variant patterns
typename Payload = [|B|A:Payload|]; typename Result(r::Row(Any,Any)) = [|A:Result({ |r})|B|r|]; sig f : forall r::Row(Any,Any). ([|A:Payload|]) -> Result({ |r}) fun f(x) {switch (x) {case A(B) -> B case A(-B as y) -> A(f(y))}} ~f
stdout : fun : forall a::Row.modal [] (([|A:Payload|]) -> Result ({ |a::Any}))
args : --fresco --set=typecheck_ir=true --set=show_quantifiers=true --set=hide_fresh_type_vars=false

Redundant pattern [1]
fun (x) { switch (x) { case x -> x case A -> A }}
stderr : @..*
exit : 1
ignore : Awaiting decision about what we want Links to guarantee

Redundant pattern [2]
fun (x) { switch (x) { case x -> A(1) case A -> A('2') } }
stderr : @.*Type error: Handler or branch result types do not agree\nIn expression: switch \(x\) \{ case x -> A\(1\) case A -> A\('2'\) \}\.
exit : 1
args : --fresco --set=typecheck_ir=true

Redundant pattern [3]
fun (x) {switch (x) { case(A(B(C(1,2,3)))) -> 0 case(A(B(C(1,2,3)))) -> 1}}
stderr : @..*
exit : 1
ignore : Awaiting decision about what we want Links to guarantee

