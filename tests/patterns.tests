fun (x) {switch (x) { case(true) -> 0 case(false) -> 1 case(y) -> 2}}
stdout : fun : (Bool) -> Int
args : --fresco --set=typecheck_ir=true --set=show_quantifiers=true --set=hide_fresh_type_vars=false

