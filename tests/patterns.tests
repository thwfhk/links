List pattern
switch (A ([])) { case A (_::_) -> 0 case A ([]) -> 1 }
stdout : 1 : Int
args : --fresco --set=typecheck_ir=true

Open record pattern
sig rest : forall a,r::Row(Any,Any). ((l:a|r)) -> (l- |r) fun rest(r) {switch (r) {case (l=l|s) -> s}} ~rest
stdout : fun : forall a,b::Row.modal [] (((l:a|b::Any)) -> (l-|b::Any))
args : --fresco --set=typecheck_ir=true --set=show_quantifiers=true --set=hide_fresh_type_vars=false

HasType pattern [1]
