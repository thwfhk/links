Recursive absence patterns retain an open result row
typename Payload = [|B|A:Payload|]; typename Result(r::Row(Any,Any)) = [|A:Result({ |r})|B|r|]; sig f : forall r::Row(Any,Any). ([|A:Payload|]) -> Result({ |r}) fun f(x) {switch (x) {case A(B) -> B case A(-B as y) -> A(f(y))}} (~f[{}]((A(B) : [|A:Payload|])), ~f[{Extra:Int}]((A(A(A(B))) : [|A:Payload|])))
stdout : (B, A(A(B))) : (Result ({ |}), Result ({ |Extra:Int}))
args : --fresco --set=typecheck_ir=true --set=fail_on_ir_type_error=true --set=recheck_frontend_transformations=true

Open record patterns retain linear remainder fields
sig rest : forall a,r::Row(Any,Any). ((l:a|r)) -> (l- |r) fun rest(r) {switch (r) {case (l=l|s) -> s}} var r=rest((l=(),k=linfun(){42})); switch(r) {case (k=f) -> f()}
stdout : 42 : Int
args : --fresco --set=typecheck_ir=true --set=fail_on_ir_type_error=true --set=recheck_frontend_transformations=true

Negative as-patterns retain linear payloads
var r=(fun(-Foo as r) {r})(Bar(linfun(){42})); switch(r) {case Bar(f) -> f()}
stdout : 42 : Int
args : --fresco --set=typecheck_ir=true --set=fail_on_ir_type_error=true --set=recheck_frontend_transformations=true

Supplied presence parameters execute absent and present cases
sig f : forall p::Presence. ([|Foo|Bar{p}|]) -> Int fun f(x) { switch(x) {case Foo -> 1 case _ -> 2} } (~f[{-}](Foo), ~f[{:()}](Bar))
stdout : (1, 2) : (Int, Int)
args : --fresco --set=typecheck_ir=true --set=fail_on_ir_type_error=true --set=recheck_frontend_transformations=true
