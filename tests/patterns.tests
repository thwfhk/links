---
config: tests/legacy_compatibility.config
args : --set=typecheck_ir=true
---

Nested variant matching [1]
switch (A (A)) { case A (A) -> 0 case A (B) -> 1 }
stdout : 0 : Int
args : --fresco --set=typecheck_ir=true

Nested variant matching [2]
switch (A (A)) { case A (B) -> 0 case A (A) -> 1 }
stdout : 1 : Int
args : --fresco --set=typecheck_ir=true

Constant patterns [1]
switch (A (1)) { case A (0) -> 0 case A (1) -> 1 }
stdout : 1 : Int
args : --fresco --set=typecheck_ir=true

Constant patterns [2]
switch (A (1)) { case A (0) -> 0 case _ -> 1 }
stdout : 1 : Int
args : --fresco --set=typecheck_ir=true

Constant patterns [3]
switch (A (1)) { case A (0) -> 0 case A (x) -> 1 }
stdout : 1 : Int
args : --fresco --set=typecheck_ir=true

