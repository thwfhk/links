stdout : 1 : Int
args : --fresco --set=typecheck_ir=true

HasType pattern [2]
switch (1) {case (1:Int) -> 1 case (x:String) -> 0}
stderr : @.*Type error: Types are inconsistent\nIn expression: x:String\.
exit : 1
args : --fresco --set=typecheck_ir=true

HasType pattern [3]
