args : --fresco --set=typecheck_ir=true

HasType pattern [4]
switch (A) {case A -> 0 case B(C(x:String)) -> 1}
stdout : 0 : Int
args : --fresco --set=typecheck_ir=true

As pattern
switch (1) {case 1 as x -> x}
