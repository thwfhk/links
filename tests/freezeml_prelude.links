sig head : forall a. [] ((List a) -> a)
fun head(x :: _) { x }

sig tail : forall a. [] ((List a) -> List a)
fun tail(_ :: xs) { xs }

sig single : forall a. [] ((a) -> List a)
fun single(x) { [x] }

typename ST(s, a) = [] (() -> a);

sig runST : [] ((forall s. ST(s, a)) -> a)
fun runST(f) { f() }

sig argST : forall s. ST(s, Int)
fun argST() { 0 }

sig pair : forall a, b. [] ((a) -> (b) -> (a, b))
fun pair(x)(y) { (x, y) }

sig pair' : forall b, a. [] ((a) -> (b) -> (a, b))
fun pair'(x)(y) { (x, y) }

sig id : forall a. [] ((a) -> a)
fun id(x) { x }

sig ids : List (forall a. [] ((a) -> a))
var ids = [ ~id ];

sig inc : [] ((Int) -> Int)
fun inc(x) { x + 1 }

sig choose : forall a. [] ((a) -> (a) -> (a))
fun choose(x)(_) { x }

sig poly : [] ((forall a. [] ((a) -> a)) -> (Int, Bool))
fun poly (id) { (id(0), id(true)) }

sig auto : [] ((forall a. [] ((a) -> a)) -> (forall a. [] ((a) -> a)))
fun auto(id) { ~id }

sig auto' : forall b. [] ((forall a. [] ((a) -> a)) -> (b) -> b)
fun auto'(id) { id }

sig map : forall a,b. [] (((a) -> b) -> (List a) -> List b)
fun map(f)(xs) {
  switch(xs) {
    case [] -> []
    case x :: xs -> f(x) :: map(f)(xs)
  }
}

sig revapp : forall a,b. [] ((a) -> ((a) -> b) -> b)
fun revapp(x)(f) { f(x) }

sig app : forall a,b. [] (((a) -> b) -> (a) -> b)
fun app(f)(x) { f(x) }

sig first : forall a::Any,b::Any,c::Any. [] (((a) -> b, (a, c)) -> (b, c))
fun first(f, (x, y)) { (f(x), y) }
