---
config: tests/sessions.config
args: --fresco --path=lib/stdlib
---

Access points
sig f : forall s::Type(Any,Session,Any). modal [Wild] ((AP(?Int.~s)) -> s) fun f(ap) { send(42,request(ap)) } ~f
stdout : fun : forall a::Session.modal [effect_0$Wild] ((AP (?(Int).~a::Session)) -> a::Session)

Linear function annotation
sig h : forall a::Type(Any,Any,Any). ((a) -@ a, a) -> a fun h(f,x) { f(x) }
stdout : () : ()
exit : 0

Non-linear use of linear function
sig h : forall a::Type(Any,Any,Any). ((a) -@ a, a) -> a fun h(f,x) { f(f(x)) }
stderr : @.*Type error:.*
exit : 1

Linear identity
sig identity : forall a::Type(Any,Any,Any). (a) -> a fun identity(x) { x } ~identity
stdout : fun : forall a::(Any,Any).modal [] ((a::Any) -> a::Any)
exit : 0

Non-linear dup
sig duplicate : forall a. (a) -> (a,a) fun duplicate(x) { (x,x) } ~duplicate
stdout : fun : forall a.modal [] ((a) -> (a, a))
exit : 0

Receive value
sig value : forall a::Type(Any,Any,Abs), s::Type(Unl,Session,Any). modal [Wild] ((?a.s) -> a) fun value(c) { receive(c).1 } ~value
stdout : fun : forall a::Type(Any,Any,Abs),b::(Unl,Session).modal [effect_0$Wild] ((?(a::Any).b::(Unl,Session)) -> a::Any)
exit : 0

Receive channel
sig channel : forall a::Type(Unl,Any,Abs), s::Type(Any,Session,Any). modal [Wild] ((?a.s) -> s) fun channel(c) { receive(c).2 } ~channel
stdout : fun : forall a::Abs,b::Session.modal [effect_0$Wild] ((?(a).b::Session) -> b::Session)
exit : 0

Ignore send
open import FrescoPrelude; sig discard : forall s::Type(Unl,Session,Any). modal [Wild] ((!Int.s) -> ()) fun discard(c) { ignore(send(42,c)) } ~discard
stdout : fun : forall a::(Unl,Session).modal [effect_0$Wild] ((!(Int).a::(Unl,Session)) -> ())
exit : 0

Linear end
open import FrescoPrelude; ignore(request((new() : AP(End))))
stderr : @.*Type error:.*
exit : 1

Non-linear generalisation (1)
{var x = A; ()}
stdout : () : ()
exit : 0

Non-linear generalisation (2)
sig discard : forall r::Row. ((x:Int|r)) -> () fun discard(r) { var (x=42|q)=r; () } ~discard
stdout : fun : forall a::Row.modal [] (((x:Int|a)) -> ())
exit : 0

The linear callback signature retains separate instantiations
sig h : forall a::Type(Any,Any,Any). ((a) -@ a, a) -> a fun h(f,x) { f(x) } (h(linfun(x) { x },42),h(linfun(x) { x },true))
stdout : (42, true) : (Int, Bool)

The access point signature executes at a concrete protocol
sig f : forall s::Type(Any,Session,Any). modal [Wild] ((AP(?Int.~s)) -> s) fun f(ap) { send(42,request(ap)) } var ap=(new() : AP(?Int.End)); var child=spawn { var (x,c)=receive(accept(ap)); close(c); print(intToString(x)) }; close(f(ap))
stdout : 42() : ()
