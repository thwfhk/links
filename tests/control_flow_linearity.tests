S2.4 Restriction of row-based effect types (1)
fun verboseUse(f:(() { |%::Lin}-@ ())) {xlin; var s = lindo Get; f(); lindo Print(s)} verboseUse
stdout : fun : (() {Get:() =@ a,Print:(a) =@ b|c::Lin}-@ ()) {Get:() =@ a,Print:(a) =@ b|c::Lin}-> b

