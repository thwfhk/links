Applying a linear function in a closure with CFL off
fun faithfulApply(f:((a::Any) { |%}-@ ())) { linfun (s) { f(s) } } faithfulApply
stdout : fun : ((a::Any) -b-@ ()) -> (a::Any) -b-@ ()
args : --set=track_control_flow_linearity=false

Applying a linear function in a closure with CFL on
fun faithfulApply(f:((a::Any) { |%::Lin}-@ ())) {xlin; linfun (s) {xlin; f(s)} } faithfulApply
stdout : fun : ((a::Any) { |b::Lin}-@ ()) { |_::Lin}-> (a::Any) { |b::Lin}-@ ()

S2.1 Subkinding of value linearity (with CFL off) (1)
fun id(x) {x} id(42)
stdout : 42 : Int
args : --set=track_control_flow_linearity=false

S2.1 Subkinding of value linearity (with CFL off) (2)
fun id(x) {x} id(linfun(){42})
stdout : fun : () -@ Int
args : --set=track_control_flow_linearity=false

S2.1 Subkinding of value linearity (with CFL on) (1)
fun id(x) {xlin; x} id(42)
stdout : 42 : Int

S2.1 Subkinding of value linearity (with CFL on) (2)
fun id(x) {xlin; x} id(linfun(){42})
stdout : fun : () -@ Int

S2.2 Applying a linear function to an operation result with CFL off
fun applyChoice(f:((String) { |%}-@ ())) {f(if (do Choose) "A" else "B")} applyChoice
stdout : fun : ((String) {Choose:() => Bool|a}-@ ()) {Choose:() => Bool|a}-> ()
args : --set=track_control_flow_linearity=false

S2.2 Applying a linear function to an operation result with CFL on
fun applyChoice(f:((String) { |%::Lin}-@ ())) {xlin; f(if (lindo Choose) "A" else "B")} applyChoice
stdout : fun : ((String) {Choose:() =@ Bool|a::Lin}-@ ()) {Choose:() =@ Bool|a::Lin}-> ()

S2.2 A linear resumption cannot be used twice
fun applyChoice(f:((String) { |%::Lin}-@ ())) {xlin; f(if (lindo Choose) "A" else "B")} fun(f) {handle ({xlin; applyChoice(f)}) {case <Choose =@ r> -> xlin; r(true); r(false)} }
exit : 1
stderr : @.*Type error: Variable .* has linear type .* is used 2 times.*

S2.2 A linear resumption can be used once
fun applyChoice(f:((String) { |%::Lin}-@ ())) {xlin; f(if (lindo Choose) "A" else "B")} fun(f) {handle ({xlin; applyChoice(f)}) {case <Choose =@ r> -> xlin; r(true)} }
stdout : fun : ((String) {Choose:() =@ Bool|a::Lin}~@ ()) {Choose{_::Lin}|a::Lin}~> ()

S2.2 Subkinding of control-flow linearity (1)
fun tossCoin(g) {var b = g(); if (b) "heads" else "tails"} fun(){ tossCoin(fun(){do Choose}) }
stdout : fun : () {Choose:() => Bool|_}-> String

S2.2 Subkinding of control-flow linearity (2)
fun tossCoin(g) {var b = g(); if (b) "heads" else "tails"} fun(){ tossCoin(fun(){lindo Choose}) }
stdout : fun : () {Choose:() =@ Bool|_}-> String

S2.2 Subkinding of control-flow linearity (3)
fun tossCoin(g) {var b = g(); if (b) "heads" else "tails"} fun(){ tossCoin(fun(){xlin; lindo Choose}) }
stdout : fun : () {Choose:() =@ Bool|_::Lin}-> String

