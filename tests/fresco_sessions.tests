---
config: tests/fresco_sessions.config
args: --fresco
---

Session send and receive execute on separate processes
var ap = new(); var p = spawn { var c = accept(ap); var (x,c) = receive(c); close(c); print(intToString(x)) }; close(send(42,request(ap)))
stdout : 42() : ()

An explicitly located access point executes
var ap = newAP(here()); var p = spawn { var c = accept(ap); close(send(42,c)) }; { var (x,c) = receive(request(ap)); close(c); x }
stdout : 42 : Int

A server access point executes
var ap = newServerAP(); var p = spawn { var c = accept(ap); close(send(42,c)) }; { var (x,c) = receive(request(ap)); close(c); x }
stdout : 42 : Int

Link connects two dual session endpoints
var first = new(); var second = new(); var producer = spawn { var c = send(42,accept(first)); var (ack,c) = receive(c); close(c) }; var relay = spawn { link(request(first),accept(second)) }; { var (x,c) = receive(request(second)); close(send((),c)); x }
stdout : 42 : Int

Link forwards a message after the sender closes
var first = new(); var second = new(); var producer = spawn { close(send(42,accept(first))) }; var relay = spawn { link(request(first),accept(second)) }; { var (x,c) = receive(request(second)); close(c); x }
stdout : 42 : Int

Link forwards a message after the sender closes with the legacy frontend
var first = new(); var second = new(); var producer = spawn { close(send(42,accept(first))) }; var relay = spawn { link(request(first),accept(second)) }; { var (x,c) = receive(request(second)); close(c); x }
args : --set=fresco=false
stdout : 42 : Int

Link forwards in the reverse direction after the sender closes
var first = new(); var second = new(); var producer = spawn { close(send(42,request(second))) }; var relay = spawn { link(request(first),accept(second)) }; { var (x,c) = receive(accept(first)); close(c); x }
stdout : 42 : Int

Link forwards in the reverse direction after the sender closes with the legacy frontend
var first = new(); var second = new(); var producer = spawn { close(send(42,request(second))) }; var relay = spawn { link(request(first),accept(second)) }; { var (x,c) = receive(accept(first)); close(c); x }
args : --set=fresco=false
stdout : 42 : Int

Link retains queued message order after the sender closes
var first = new(); var second = new(); var producer = spawn { close(send(43,send(42,accept(first)))) }; var relay = spawn { link(request(first),accept(second)) }; { var (x,c) = receive(request(second)); var (y,c) = receive(c); close(c); (x,y) }
stdout : (42, 43) : (Int, Int)

Link retains queued message order after the sender closes with the legacy frontend
var first = new(); var second = new(); var producer = spawn { close(send(43,send(42,accept(first)))) }; var relay = spawn { link(request(first),accept(second)) }; { var (x,c) = receive(request(second)); var (y,c) = receive(c); close(c); (x,y) }
args : --set=fresco=false
stdout : (42, 43) : (Int, Int)

Chained relays forward after the sender closes
var first = new(); var middle = new(); var last = new(); var producer = spawn { close(send(42,accept(first))) }; var relay = spawn { link(request(first),accept(middle)) }; var relay = spawn { link(request(middle),accept(last)) }; { var (x,c) = receive(request(last)); close(c); x }
stdout : 42 : Int

Chained relays forward after the sender closes with the legacy frontend
var first = new(); var middle = new(); var last = new(); var producer = spawn { close(send(42,accept(first))) }; var relay = spawn { link(request(first),accept(middle)) }; var relay = spawn { link(request(middle),accept(last)) }; { var (x,c) = receive(request(last)); close(c); x }
args : --set=fresco=false
stdout : 42 : Int

Link connects End peers that have already closed
var first = (new() : AP(End)); var second = (new() : AP(End)); var producer = spawn { close(accept(first)) }; var relay = spawn { link(request(first),accept(second)) }; close(request(second))
stdout : () : ()

Link connects End peers that have already closed with the legacy frontend
var first = (new() : AP(End)); var second = (new() : AP(End)); var producer = spawn { close(accept(first)) }; var relay = spawn { link(request(first),accept(second)) }; close(request(second))
args : --set=fresco=false
stdout : () : ()

Session payloads must match the protocol
var ap = (new() : AP(?(Int).End)); var p = spawn { var (x,c) = receive(accept(ap)); close(c) }; close(send("42",request(ap)))
exit : 1
stderr : @.*Type error:.*

Session endpoints cannot be duplicated
fun(c:End) { (c,c) }
exit : 1
stderr : @.*Type error:.*

Session endpoints cannot be discarded
fun(c:End) { () }
exit : 1
stderr : @.*Type error:.*

Access points require a session protocol
(new() : AP(Int))
exit : 1
stderr : @.*Type error:.*

Session primitives require Wild
(fun() { new() } : modal [] (() -> AP(End)))
exit : 1
stderr : @.*Type error:.*

Client access point creation lowers with checked IR
sig makeClient : modal [Wild] (() -> AP(End)) fun makeClient() { newClientAP() } ()
stdout : () : ()

Local send retains a contextual residual protocol
sig forward : forall s::Type(Any,Session,Any). modal [Wild] ((Int, !(Int).s) -> s) fun forward(x,c) { send(x,c) } ()
stdout : () : ()

An absolute linear function transfers through a session
typename Message = modal [] (() -@ Int); var ap = (new() : AP(?(Message).End)); var p = spawn { var (f,c) = freeze(receive)[Message,End](accept(ap)); close(c); print(intToString(f())) }; close(~send[Message,End]((linfun() { 42 } : Message),request(ap)))
stdout : 42() : ()

A contextual function cannot be sent through a session
var ap = new(); var c = request(ap); send(fun() { 42 },c)
exit : 1
stderr : @.*Type error:.*

An absolute polymorphic function transfers through a session
typename Message = modal [] (forall a. (a) -> a); var msg = (fun(x) { x } : Message); var ap = (new() : AP(?(Message).End)); var p = spawn { var (f,c) = freeze(receive)[Message,End](accept(ap)); close(c); print(intToString(f(42))); if (f(true)) print("true") else print("false") }; close(~send[Message,End](~msg,request(ap)))
stdout : 42true() : ()

A session delegates a linear channel
var data = new(); var courier = new(); var producer = spawn { close(send(42,accept(data))) }; var delegate = spawn { close(send(request(data),accept(courier))) }; { var (c,done) = receive(request(courier)); close(done); var (x,c) = receive(c); close(c); x }
stdout : 42 : Int

An access point supports two connections
var ap = new(); var producer = spawn { close(send(42,accept(ap))); close(send(43,accept(ap))) }; { var (x,c) = receive(request(ap)); close(c); var (y,c) = receive(request(ap)); close(c); (x,y) }
stdout : (42, 43) : (Int, Int)

Generic link retains a rigid session protocol
sig join : forall s::Type(Any,Session,Any). modal [Wild] ((AP(s),AP(s)) -> ()) fun join(a,b) { ~link[s](~accept[s](a),~request[s](b)) } ()
stdout : () : ()

Generic link rejects two copies of the same protocol
sig join : forall s::Type(Any,Session,Any). modal [Wild] ((s,s) -> ()) fun join(a,b) { ~link[s](a,b) } ()
exit : 1
stderr : @.*Type error:.*

Selection returns the chosen input continuation
typename Choice = [&|Go:!Int.End,Stop:End|&]; var ap = (new() : AP(Choice)); var p = spawn { offer(accept(ap)) { case Go(c) -> close(send(42,c)) case Stop(c) -> close(c) } }; { var c = select Go request(ap); var (x,c) = receive(c); close(c); x }
stdout : 42 : Int

Offer selects the second branch
typename Choice = [&|Go:!Int.End,Stop:End|&]; var ap = (new() : AP(Choice)); var p = spawn { offer(accept(ap)) { case Go(c) -> close(send(42,c)) case Stop(c) -> { close(c); print("stop") } } }; close(select Stop request(ap))
stdout : stop() : ()

Selection rejects an unknown label
fun(c:([+|Go:End|+])) { select Stop c }
exit : 1
stderr : @.*Type error:.*

Selection requires a selecting endpoint
fun(c:([&|Go:End|&])) { select Go c }
exit : 1
stderr : @.*Type error:.*

Offer requires an offering endpoint
fun(c:([+|Go:End|+])) { offer(c) { case Go(c) -> close(c) } }
exit : 1
stderr : @.*Type error:.*

Selection requires Wild
sig choose : ([+|Go:End|+]) -> End fun choose(c) { select Go c } ()
exit : 1
stderr : @.*Type error:.*

Offer requires Wild
sig choose : ([&|Go:End|&]) -> End fun choose(c) { offer(c) { case Go(c) -> c } } ()
exit : 1
stderr : @.*Type error:.*

An offered continuation cannot be discarded
fun(c:([&|Go:End|&])) { offer(c) { case Go(c) -> () } }
exit : 1
stderr : @.*Type error:.*

Offer branches must agree on their result type
fun(c:([&|Go:End,Stop:End|&])) { offer(c) { case Go(c) -> { close(c); 42 } case Stop(c) -> { close(c); true } } }
exit : 1
stderr : @.*Type error:.*

Offer rejects a missing closed branch
fun(c:([&|Go:End,Stop:End|&])) { offer(c) { case Go(c) -> close(c) } }
exit : 1
stderr : @.*Type error:.*

Offer preserves a handler around its branch
effect E { Read : () => Int; } var ap = (new() : AP([&|Go:End|&])); var p = spawn { close(select Go request(ap)) }; handle <E> ({ offer(accept(ap)) { case Go(c) -> { close(c); do Read } } }) { case x -> x case <Read => k> -> k(42) }
stdout : 42 : Int

Duplicate offer labels retain the last branch
var ap = (new() : AP([&|Go:End|&])); var p = spawn { offer(accept(ap)) { case Go(c) -> { close(c); print("first") } case Go(c) -> { close(c); print("last") } } }; close(select Go request(ap))
stdout : last() : ()

Offer preserves an outer variant annotation
var ap = (new() : AP([&|Go:End|&])); var p = spawn { offer(accept(ap)) { case (Go(c):[|Go:End|]) -> { close(c); print("done") } } }; close(select Go request(ap))
stdout : done() : ()

Offer checks an annotated continuation
var ap = (new() : AP([&|Go:End|&])); var p = spawn { offer(accept(ap)) { case Go(c:End) -> { close(c); print("done") } } }; close(select Go request(ap))
stdout : done() : ()

An offer continuation annotation must match its protocol
fun(c:([&|Go:End|&])) { offer(c) { case Go(c:(!Int.End)) -> close(send(42,c)) } }
exit : 1
stderr : @.*Type error:.*

Nested selection returns each continuation in turn
var ap = (new() : AP([&|More:[&|Value:!Int.End,Done:End|&],Stop:End|&])); var p = spawn { offer(accept(ap)) { case More(c) -> offer(c) { case Value(c) -> close(send(42,c)) case Done(c) -> close(c) } case Stop(c) -> close(c) } }; { var c = select More request(ap); var c = select Value c; var (x,c) = receive(c); close(c); x }
stdout : 42 : Int

Selection evaluates its endpoint once
var ap = (new() : AP([&|Go:End|&])); var p = spawn { offer(accept(ap)) { case Go(c) -> close(c) } }; close(select Go { print("endpoint"); request(ap) })
stdout : endpoint() : ()
