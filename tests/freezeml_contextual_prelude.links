# Contextual helpers for the supported Freezeml cases.
typename Identity = forall a. modal [] ((a) -> a);

sig head : forall a. (List a) -> a
fun head(x :: _) { x }

sig tail : forall a. (List a) -> List a
fun tail(_ :: xs) { xs }

sig single : forall a. (a) -> List a
fun single(x) { [x] }

typename ST(s::Any, a::Any) = modal [] (() -> a);

sig runST : (forall s. ST(s, a)) -> a
fun runST(f) {
  var f = f : (() -> a);
  f()
}

sig argST : forall s. ST(s, Int)
fun argST() { 0 }

sig pair : forall a, b. (a) -> (b) -> (a, b)
fun pair(x)(y) { (x, y) }

sig pair' : forall b, a. (a) -> (b) -> (a, b)
fun pair'(x)(y) { (x, y) }

sig id : forall a. (a) -> a
fun id(x) { x }

sig ids : List Identity
var ids = [ ~id ];

sig inc : (Int) -> Int
fun inc(x) { x + 1 }

sig poly : (Identity) -> (Int, Bool)
fun poly(id) { (id(0), id(true)) }

sig auto : (Identity) -> Identity
fun auto(id) { ~id }

sig auto' : forall b. (Identity) -> modal [] ((b) -> b)
fun auto'(id) { id }

sig first : forall a::Any, b::Any, c::Any. ((a) -> b, (a, c)) -> (b, c)
fun first(f, (x, y)) { (f(x), y) }
