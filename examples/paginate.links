var results_per_page = 10;

var wordlist = [
  (word="apricot", meaning="a stone fruit"),
  (word="apple", meaning="a round fruit"),
  (word="pear", meaning="a fruit with a narrow top")
];

fun find(n,c) {
  var limit = results_per_page;
  var offset = results_per_page * (n-1);

  take(limit,
    drop(offset,
      for (r <- wordlist)
        where (r.word =~ /^{c}.*/)
        orderby (r.word)
        [r]))
}

find(1, "a")
