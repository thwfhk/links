effect State(s::Abs) {
  Get : () => s;
  Put : (s) => ();
}

effect Writer {
  Tell : (String) => ();
}

sig runState : forall s::Abs,a::Abs. (<State(s)> (() -> a)) -> (s) -> () -> (a, s)
fun runState(m)(s)() {
  (handle(m()) {
     case x -> fun (s) {(x, s)}
     case <Get => k>    -> fun (s) {k(s)(s)}
     case <Put(s) => k> -> fun (_) {k(())(s)}
   })(s)
}

sig evalState : forall s::Abs,a::Abs. (<State(s)> (() -> a)) -> (s) -> () -> a
fun evalState(m)(s)() {
  (handle(m()) {
     case x -> fun (s) {x}
     case <Get => k>    -> fun (s) {k(s)(s)}
     case <Put(s) => k> -> fun (_) {k(())(s)}
   })(s)
}

sig runStringWriter : forall a::Abs. (<Writer> (() -> a)) -> (String) -> () -> (a, String)
fun runStringWriter(m)(s)() {
  (handle(m()) {
     case x -> fun (s) {(x, s)}
     case <Tell(t) => k> -> fun (s) {k(())(s ^^ t)}
   })(s)
}

sig printer : forall a::Abs. [wild] ((<Writer> (() -> a)) -> a)
fun printer(m) {
  handle(m()) {
     case x -> x
     case <Tell(s) => k> -> println(s); k(())
  }
}

sig get : forall s::Abs. [State(s)] (() -> s)
fun get() {do Get}

sig put : forall s::Abs. [State(s)] ((s) -> ())
fun put(s) {do Put(s)}

sig tell : [Writer] ((String) -> ())
fun tell(s) {do Tell(s)}

typename Expr =
  (| Lit : Int
   | Var : String
   | Plus : (Expr, Expr)
   | Assign : (String, Expr)
   | Sequence : List Expr
   | While : (Expr, Expr)
   |);

fun showExpr(e) {
  switch (e) {
    case Lit(i)        -> intToString(i)
    case Var(x)        -> x
    case Plus(l, r)    -> "(" ^^ showExpr(l) ^^ ")+(" ^^ showExpr(r) ^^ ")"
    case Assign(x, e)  -> x ^^ " := " ^^ showExpr(e)
    case Sequence(es)  ->
      fun showExprs(es) {
        switch (es) {
          case []      -> ""
          case [e]     -> showExpr(e)
          case (e::es) -> showExpr(e) ^^ ", " ^^ showExprs(es)
        }
      }
      "[" ^^ showExprs(es) ^^ "]"
    case While(c, b)   -> "while (" ^^ showExpr(c) ^^ ") {" ^^ showExpr(b) ^^ "}"
  }
}

typename Env = List (String, Int);

effect Suspension {
  Suspend : (Expr, [State(Env), Writer, Suspension] (() -> Int)) => Int;
}

typename SComp = [State(Env), Writer, Suspension] (() -> Int);

sig suspend : (Expr) -> [Suspension] ((SComp) -> Int)
fun suspend(e)(m) {do Suspend(e, m)}

fun showEnv(env) {
  fun showEntry((x, i)) {x ^^ "=" ^^ intToString(i)}

  fun showEntries(es) {
    switch(es) {
      case []      -> ""
      case [e]     -> showEntry(e)
      case (e::es) -> showEntry(e) ^^ "; " ^^ showEntries(es)
    }
  }
  "{" ^^ showEntries(env) ^^ "}"
}

mutual {
  sig bevalStep : (Expr) -> SComp
  fun bevalStep(exp)() {
    switch(exp) {
      case Lit(x) -> x
      case Var(x) ->
        switch (lookup(x, get())) {
          case Just(v) -> v
          case Nothing -> error("variable: " ^^ x ^^ " not found!")
        }
      case Plus(l, r) -> beval(l) + beval(r)
      case Assign(x, e) ->
        var v = beval(e);
        put ((x, v) :: get());
        v
      case Sequence([])    -> 0
      case Sequence([e])   -> beval(e)
      case Sequence(e::es) ->
        ignore(beval(e)); beval (Sequence(es))
      case While(c, b)     ->
        if (beval(c) == 0) {
          0
        } else {
          ignore(beval(b)); beval(exp)
        }
    }
  }

  sig beval : [State(Env), Writer, Suspension] ((Expr) -> Int)
  fun beval(e) {suspend(e)(bevalStep(e))}
}

sig computation : (Expr) -> SComp
fun computation(e)() { beval(e) }

sig force : [State(Env), Writer] ((SComp) -> () -> Int)
fun force(m)() {
  handle(m()) {
    case x        -> x
    case <Suspend(e, m) => k> -> k (force(m)())
  }
}

sig logger : (SComp) -> (String) -> SComp
fun logger(m)(name)() {
  (handle(m()) {
     case x        -> fun (_) {x}
     case <Suspend(e, m) => k> ->
       fun (name) {
         tell("Entering " ^^ name ^^ " with " ^^ showExpr(e) ^^ "\n");
         var y = suspend(e)(logger(m)(name));
         tell("Exiting " ^^ name ^^ " with " ^^ intToString(y) ^^ "\n");
         k(y)(name)
       }
   })(name)
}

sig dump : (SComp) -> SComp
fun dump(m)() {
  handle(m()) {
     case x        -> x
     case <Suspend(e, m) => k> ->
       tell(showEnv(get()));
       k(suspend(e)(dump(m)))
  }
}

sig e1 : Expr
var e1 = Plus (Lit(3), Lit(4));
sig e2 : Expr
var e2 = Plus (Assign("x", Lit(3)), Assign("y", Lit(4)));
sig e3 : Expr
var e3 = Plus (Plus(Assign ("x", Lit(3)), Assign("y", Lit(4))), Plus (Var("x"), Var("y")));

sig test0 : [wild] ((Expr) -> Int)
fun test0(e) {
  printer(fun() { evalState(fun() { force(computation(e))() })([] : Env)() })
}
sig test1 : [wild] ((Expr) -> Int)
fun test1(e) {
  printer(fun() { evalState(fun() { force(logger(computation(e))("eval"))() })([] : Env)() })
}
sig test2 : [wild] ((Expr) -> Int)
fun test2(e) {
  printer(fun() { evalState(fun() { force(dump(computation(e)))() })([] : Env)() })
}
sig test3 : [wild] ((Expr) -> Int)
fun test3(e) {
  printer(fun() { evalState(fun() { force(dump(logger(computation(e))("eval")))() })([] : Env)() })
}


