# Shallow state handlers

effect State(a::Abs) { Get : () => a; Put : (a) => (); }
effect Log(a::Abs) { Log : (a) => (); }

# Turn a continuation into a computation in the same context.
sig compify : ((a) -> b) -> (a) -> () -> b
fun compify(k)(x)() { k(x) }

# The run handler forces evaluation of a computation
fun run(m) {
  handle(m()) {
    case x -> x
  }
}

# Get and put operations
sig get : forall a::Abs. [State(a)] (() -> a)
fun get() {do Get}

sig put : forall a::Abs. [State(a)] ((a) -> ())
fun put(p) {do Put(p)}

# Print line operation
sig logVal : forall a::Abs. [Log(a)] ((a) -> ())
fun logVal(p) {do Log(p)}

# Stateful computation evaluator
sig evalState : forall s::Abs,a::Abs. (s) -> (<State(s)> (() -> a)) -> () -> a
fun evalState(st)(m)() {
  (shallowhandle(m()) {
    case x -> fun(_)  { x }
    case <Get -> k>    -> fun(st) { evalState(st)(fun() { compify(k)(st)() })() }
    case <Put(p) -> k>  -> fun(_)  { evalState(p)(fun() { compify(k)(())() })() }
  })(st)
}

sig logState : forall s::Abs,a::Abs. [State(s), Log(s)] ((<State(s)> (() -> a)) -> () -> a)
fun logState(m)() {
  shallowhandle(m()) {
    case <Get -> k>    -> var v = get();
                      logState(fun() { compify(k)(v)() })()
    case <Put(p) -> k>  -> logVal(p);
                      var v = put(p);
                      logState(fun() { compify(k)(v)() })()
    case x -> x
  }
}

# Prints integers to stdout
sig logPrinter : forall a::Abs. [wild] ((<Log(Int)> (() -> a)) -> () -> a)
fun logPrinter(m)() {
  shallowhandle(m()) {
    case x -> x
    case <Log(p) -> k>  -> print(intToString(p));
                      logPrinter(fun() { compify(k)(())() })()
  }
}

# Log accumulator
sig logAccumulator : forall a::Abs,b::Abs. (List a) -> (<Log(a)> (() -> b)) -> () -> (b, List a)
fun logAccumulator(ps)(m)() {
  shallowhandle(m()) {
    case x -> (x,ps)
    case <Log(p) -> k> -> logAccumulator(p :: ps)(fun() { compify(k)(())() })()
  }
}

# Stateful computation which counts down to zero
sig count : [State(Int)] (() -> Int)
fun count() {
    var i = get();
    if (i <= 0) {i}
    else {put(i-1); count()}
}

# Example 1
fun example1() {
  run(evalState(5)(count))
}

# Example 2
sig example2 : [wild] (() -> Int)
fun example2() {
  run(logPrinter(fun() { evalState(5)(fun() { logState(count)() })() }))
}

# Unit test
fun unitTest(n) {
  run(logAccumulator([])(fun() { evalState(n)(fun() { logState(count)() })() }))
}
