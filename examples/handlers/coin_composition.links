effect Choice { Choose : () => Bool; }
effect Failure { Fail : forall a::Abs. () => a; }

typename Toss = (|Heads|Tails|);

fun intersperse(y, xs) {
   switch (xs) {
     case []      -> []
     case [x]     -> [x]
     case x :: xs -> x :: y :: intersperse(y,xs)
   }
}

## Various conversion functions
fun showList(showX)(xs) {
  var xs = fold_left(fun (acc, x) { acc ^^ x }
                    , ""
                    , intersperse(",", map(showX, xs)));
  "[" ^^ xs ^^ "]"
}

fun showToss(toss) {
  switch(toss) {
    case Heads -> "Heads"
    case Tails -> "Tails"
  }
}

sig positive : forall a::Abs. (<Choice> (() -> a)) -> a
fun positive(m) {
  handle(m()) {
    case x -> x
    case <Choose => k> -> k(true)
  }
}

sig allChoices : forall a::Abs. (<Choice> (() -> a)) -> () -> List a
fun allChoices(m)() {
  handle(m()) {
    case x -> [x]
    case <Choose => k> -> k(true) ++ k(false)
  }
}

sig failure : forall a::Abs. (<Failure> (() -> a)) -> () -> List a
fun failure(m)() {
  handle(m()) {
    case x -> [x]
    case <Fail => k> -> []
  }
}

# fun allChoicesShallow(m)() {
#   shallowhandle(m()) {
#     case x -> [x]
#     case <Choose -> k> -> allChoicesShallow(fun() {k(true)})() ++ allChoicesShallow(fun() {k(false)})()
#   }
# }

sig toss : [Choice] (() -> Toss)
fun toss() {
  if (do Choose) Heads else Tails
}

sig drunkToss : [Choice, Failure] (() -> Toss)
fun drunkToss() {
  if (do Choose) toss() else do Fail
}

sig run : [wild] (() -> ())
fun run() {
  var xs = allChoices(fun() { failure(drunkToss)() })();
  println(showList(showList(showToss))(xs));
  var ys = failure(fun() { allChoices(drunkToss)() })();
  println(showList(showList(showToss))(ys));
  ()
  # var zs = allChoicesShallow(toss)();
  # print(showList(showToss)(zs))
}

run()
