# Deep and shallow implementations of pipes along with their
# interencodings.
#
# The direct implementations are adapted from Kammar et al. (2013)
# whilst the encoded implementations are adapted from Hillerström and
# Lindley (2018).

effect Await(s::Abs) { Await : () => s; }
effect Yield(s::Abs) { Yield : (s) => (); }

# Basic combinators.
sig await : forall s::Abs. [Await(s)] (() -> s)
fun await() { do Await }

sig yield : forall s::Abs. [Yield(s)] ((s) -> ())
fun yield(s) { do Yield(s) }

sig forever : (() -> a) -> b
fun forever(f) { ignore(f()); forever(f) }

sig blackhole : forall s::Abs,a. [Await(s)] (() -> a)
fun blackhole() { forever(await) }

sig take1 : forall s::Abs. (Int) -> [Await(s), Yield(s)] (() -> ())
fun take1(n)() {
  fun take0(n) {
    if (n <= 0) ()
    else {
      var x = await();
      yield(x);
      take0(n-1)
   }
 }
 take0(n)
}

sig produceFrom : (Int) -> [Yield(Int)] (() -> a)
fun produceFrom(n)() {
  fun produceFrom0(n) {
     yield(n);
     produceFrom0(n+1)
  }
  produceFrom0(n)
}

sig skip1 : forall s::Abs. (Int) -> [Await(s), Yield(s)] (() -> ())
fun skip1(n)() {
  fun skip0(n) {
    var x = await();
    if (n <= 0) yield(x)
    else skip0(n-1)
  }
  skip0(n)
}

sig printer : forall s::Abs. ([] ((s) -> String)) -> [Await(s), wild] (() -> ())
fun printer(toString)() {
  var x = await();
  print(toString(x))
}

sig forward : forall s::Abs. [Await(s), Yield(s)] (() -> ())
fun forward() { yield(await()) }

sig collect : forall s::Abs,a. (<Yield(s)> (() -> a)) -> List s
fun collect(m) {
  handle(m()) {
    case _ -> []
    case <Yield(x)> -> [x]
  }
}

module Deep {
  mutual {
    typename Producer(s, a) = () -> (Consumer(s,a)) -> a;
    typename Consumer(s, a) = (s) -> (Producer(s,a)) -> a;
  }

  typename Pipe(s::Abs, a) = (<Await(s)> (() -> a)) -> (Producer(s,a)) -> a;
  typename Copipe(s::Abs, a) = (<Yield(s)> (() -> a)) -> (Consumer(s,a)) -> a;

  sig expoPipe1 : forall a::Abs. ([] (Pipe(Int,a)), [] (Copipe(Int,a))) ->
                 (Int) -> [Await(Int), Yield(Int)] (() -> a)
  fun expoPipe1(pipe, copipe)(n)() {
    if (n == 0) {
      forever(fun() {
        var x = await();
        yield(x+1)
      })
    } else {
      pipe(fun() { expoPipe1(pipe, copipe)(n-1)() })
          (fun() { copipe(fun() { expoPipe1(pipe, copipe)(n-1)() }) })
    }
  }


  module Direct {
    sig pipe : forall s::Abs,a::Abs. Pipe(s,a)
    fun pipe(cons) {
      handle(cons()) {
        case x -> fun(_) { x }
        case <Await => resume> ->
          fun(prod) {
            prod()(resume)
          }
      }
    }

    sig copipe : forall s::Abs,a::Abs. Copipe(s,a)
    fun copipe(prod) {
      handle(prod()) {
        case x -> fun(_) { x }
        case <Yield(s) => resume> ->
          fun(cons) {
            cons(s)(fun() { resume(()) })
          }
      }
    }

    sig >+> : forall s::Abs,a::Abs. (<Yield(s)> (() -> a), <Await(s)> (() -> a)) -> () -> a
    op producer >+> consumer {
      fun() { pipe(consumer)(fun() { copipe(producer) }) }
    }

    sig expoPipe : forall a::Abs. (Int) -> [Await(Int), Yield(Int)] (() -> a)
    fun expoPipe(n) { expoPipe1(pipe, copipe)(n) }
  }

  module Encoded {
    sig pipe : forall s::Abs,a::Abs. Pipe(s,a)
    fun pipe(cons) {
      shallowhandle(cons()) {
        case x -> fun(_) { x }
        case <Await -> resume> ->
          fun(prod) {
            prod()(fun(x) { pipe(fun() { resume(x) }) })
          }
      }
    }

    sig copipe : forall s::Abs,a::Abs. Copipe(s,a)
    fun copipe(prod) {
      shallowhandle(prod()) {
        case x -> fun(_) { x }
        case <Yield(s) -> resume> ->
          fun(cons) {
            cons(s)(fun() { copipe(fun() { resume(()) }) })
          }
      }
    }

    sig >+> : forall s::Abs,a::Abs. (<Yield(s)> (() -> a), <Await(s)> (() -> a)) -> () -> a
    op producer >+> consumer {
      fun() { pipe(consumer)(fun() { copipe(producer) }) }
    }

    sig expoPipe : forall a::Abs. (Int) -> [Await(Int), Yield(Int)] (() -> a)
    fun expoPipe(n) { expoPipe1(pipe, copipe)(n) }
  }
}

module Shallow {
  typename Prod(s::Abs,a) = <Yield(s)> (() -> a);
  typename Cons(s::Abs,a) = <Await(s)> ((s) -> a);
  typename Awaiting(s::Abs,a) = <Await(s)> (() -> a);

  module Direct {
    mutual {
      sig pipe : forall s::Abs,a::Abs. (Prod(s,a), Awaiting(s,a)) -> a
      fun pipe(prod, cons) {
        shallowhandle(cons()) {
          case <Await -> resume> -> copipe(resume, prod)
        }
      }

      sig copipe : forall s::Abs,a::Abs. (Cons(s,a), Prod(s,a)) -> a
      fun copipe(cons, prod) {
        shallowhandle(prod()) {
          case <Yield(s) -> resume> -> pipe(fun() { resume(()) }, fun() { cons(s) })
        }
      }
    }

    sig >+> : forall s::Abs,a::Abs. (Prod(s,a), Awaiting(s,a)) -> () -> a
    op producer >+> consumer {
      fun() { pipe(producer, consumer) }
    }
  }

  module Encoded {
    # A deep handler records the next request and its resumption.
    # The two loops alternate between the recorded requests.
    typename Request(s,a) = mu r . (|Finished:a |Waiting:(s) -> r|);
    typename Output(s,a) = mu r . (|Finished:a |Sending:(s, (()) -> r)|);

    sig wait : forall s::Abs,a::Abs. (Awaiting(s,a)) -> Request(s,a)
    fun wait(cons) {
      handle(cons()) {
        case x -> Finished(x)
        case <Await => resume> -> Waiting(resume)
      }
    }

    sig send : forall s::Abs,a::Abs. (Prod(s,a)) -> Output(s,a)
    fun send(prod) {
      handle(prod()) {
        case x -> Finished(x)
        case <Yield(x) => resume> -> Sending(x, resume)
      }
    }

    sig drive : (() -> Output(s,a), Request(s,a)) -> a
    fun drive(prod, cons) {
      switch (cons) {
        case Finished(x) -> x
        case Waiting(next) ->
          switch (prod()) {
            case Finished(x) -> x
            case Sending(x, more) -> drive(fun() { more(()) }, next(x))
          }
      }
    }

    sig pipe : forall s::Abs,a::Abs. (Prod(s,a), Awaiting(s,a)) -> a
    fun pipe(prod, cons) {
      drive(fun() { send(prod) }, wait(cons))
    }

    sig copipe : forall s::Abs,a::Abs. (Cons(s,a), Prod(s,a)) -> a
    fun copipe(cons, prod) {
      switch (send(prod)) {
        case Finished(x) -> x
        case Sending(x, more) -> drive(fun() { more(()) }, wait(fun() { cons(x) }))
      }
    }

    sig >+> : forall s::Abs,a::Abs. (Prod(s,a), Awaiting(s,a)) -> () -> a
    op producer >+> consumer {
      fun() { pipe(producer, consumer) }
    }
  }
}


sig >+> : forall s::Abs,a::Abs. (<Yield(s)> (() -> a), <Await(s)> (() -> a)) -> () -> a
op producer >+> consumer {
  fun() { Deep.Direct.pipe(consumer)(fun() { Deep.Direct.copipe(producer) }) }
}

sig expoPipe : forall a::Abs. (Int) -> [Await(Int), Yield(Int)] (() -> a)
fun expoPipe(n)() {
  if (n == 0) {
    forever(fun() {
      var x = await();
      yield(x+1)
    })
  } else {
    Deep.Direct.pipe(fun() { expoPipe(n-1)() })
                    (fun() { Deep.Direct.copipe(fun() { expoPipe(n-1)() }) })
  }
}

sig nested : [wild] ((Int, Int, Int) -> ())
fun nested(start, depth, end) {
  ((fun() { ((fun() { (produceFrom(start) >+> expoPipe(depth))() }) >+> take1(end))() })
    >+> printer(intToString))()
}

sig simple : [wild] (() -> ())
fun simple() {
  ((fun() { (produceFrom(0) >+> skip1(1000))() }) >+> printer(intToString))()
}

fun nested_example(start, depth, end) {
  var deep = collect(fun() {
    open Deep.Direct;
    ((fun() { ((fun() { (produceFrom(start) >+> expoPipe(depth))() }) >+> take1(end))() }) >+> forward)()
  });

  var deep_encoded = collect(fun() {
    open Deep.Encoded;
    ((fun() { ((fun() { (produceFrom(start) >+> expoPipe(depth))() }) >+> take1(end))() }) >+> forward)()
  });

  var shallow = collect(fun() {
    open Shallow.Direct;
    ((fun() { ((fun() { (produceFrom(start) >+> expoPipe(depth))() }) >+> take1(end))() }) >+> forward)()
  });

  var shallow_encoded = collect(fun() {
    open Shallow.Encoded;
    ((fun() { ((fun() { (produceFrom(start) >+> expoPipe(depth))() }) >+> take1(end))() }) >+> forward)()
  });

  concat([deep, deep_encoded, shallow, shallow_encoded])
}

fun unitTest() { nested_example(0, 8, 10) }
