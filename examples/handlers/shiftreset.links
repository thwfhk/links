# Delimited continuations using handlers

effect Shift(a::Abs,b::Abs) { Shift : ([] (((a) -> b) -> b)) => a; }

sig reset : forall a::Abs,b::Abs. (<Shift(a,b)> (() -> b)) -> b
fun reset(m) {
  handle(m()) {
    case x        -> x
    case <Shift(f) => resume> -> f(resume)
  }
}

sig shift : forall a::Abs,b::Abs. [Shift(a,b)] (([] (((a) -> b) -> b)) -> a)
fun shift(f) { do Shift(f) }

sig comp : [Shift(Int,Int)] (() -> Int)
fun comp() {
    var x = shift(fun(k) { k(k(k(7))) });
    x  * 2 + 1
}

sig yield : forall a::Abs. [Shift((),List a)] ((a) -> ())
fun yield(x) {
  shift(fun(k) {
    x :: k(())
  })
}

sig example : () -> List Int
fun example() {
  reset(fun() {
    yield(1);
    yield(2);
    yield(3);
    []
  })
}
