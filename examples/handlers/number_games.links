# Classic guess a number game
open import FrescoPrelude;

typename Answer = [|Low|Correct|High|];

effect Read { Read : () => Int; }
effect Guess { Guess : (Int) => Answer; }

sig readInt : modal [Read, Wild] (() -> Int)
fun readInt() {var n = do Read; print(" " ^^ intToString(n)); n}

sig guess : modal [Read, Guess, Wild] (() -> ())
fun guess() {
  print("Take a guess>");
  var number = readInt();
  switch (do Guess(number)) {
    case Low -> println("\nYour guess is too low."); guess()
    case Correct -> println("\nCorrect!!")
    case High -> println("\nYour guess is too high."); guess()
  }
}

sig isNil : forall a. (List a) -> Bool
fun isNil(xs) {
  switch (xs) {
    case [] -> true
    case _  -> false
  }
}

sig input : forall a. (List Int, modal <Read> (() -> a)) -> ()
fun input(guesses, m) {
  handle(m())(guesses <- guesses) {
    case x -> ()
    case <Read => resume> ->
       switch(guesses) {
         case [] -> ()
         case g :: gs -> resume(g, gs)
       }
  }
}

sig mySecret : forall a. (Int, modal <Guess> (() -> modal <Guess|> a)) -> a
fun mySecret(secret, m) {
  handle(m()) {
    case x -> x
    case <Guess(n) => resume> ->
      if (n < secret) resume(Low)
      else if (n > secret) resume(High)
      else resume(Correct)
  }
}

sig logger : forall a. modal [Guess] ((modal <Guess> (() -> a)) -> List (Int,Answer))
fun logger(m) {
  handle(m())(log <- []) {
    case _ -> log
    case <Guess(n) => resume> ->
       var an = do Guess(n);
       resume(an, (n, an) :: log)
  }
}

sig example : modal [Wild] (() -> ())
fun example() {
  mySecret(42, fun() { input([64,32,48,40,44,42], guess) })
}

sig example2 : modal [Wild] (() -> List (Int,Answer))
fun example2() {
  mySecret(42, fun() {logger(fun() { input([64,32,48,40,44,42], guess) }) })
}
