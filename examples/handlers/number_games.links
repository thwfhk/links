# Classic guess a number game
typename Answer = (|Low|Correct|High|);

effect Input { Read : () => Int; }
effect Guessing { Guess : (Int) => Answer; }

sig readInt : [Input, wild] (() -> Int)
fun readInt() {var n = do Read; print(" " ^^ intToString(n)); n}

sig guess : [Input, Guessing, wild] (() -> ())
fun guess() {
  print("Take a guess>");
  var number = readInt();
  switch (do Guess(number)) {
    case Low -> println("\nYour guess is too low."); guess()
    case Correct -> println("\nCorrect!!")
    case High -> println("\nYour guess is too high."); guess()
  }
}

fun isNil(xs) {
  switch (xs) {
    case [] -> true
    case _  -> false
  }
}

sig input : (List Int, <Input> (() -> a)) -> ()
fun input(guesses, m) {
  handle(m())(guesses <- guesses) {
    case x -> ()
    case <Read => resume> ->
       switch(guesses) {
         case [] -> ()
         case g :: gs -> resume(g, gs)
       }
  }
}

sig mySecret : forall a::Abs. (Int, <Guessing> (() -> a)) -> a
fun mySecret(secret, m) {
  handle(m()) {
    case x -> x
    case <Guess(n) => resume> ->
      if (n < secret) resume(Low)
      else if (n > secret) resume(High)
      else resume(Correct)
  }
}

sig logger : [Guessing] ((<Guessing> (() -> a)) -> List (Int, Answer))
fun logger(m) {
  handle(m())(log <- []) {
    case _ -> log
    case <Guess(n) => resume> ->
       var an = do Guess(n);
       resume(an, (n, an) :: log)
  }
}

sig example : [wild] (() -> ())
fun example() {
  mySecret(42, fun() { input([64,32,48,40,44,42], guess) })
}

sig example2 : [wild] (() -> List (Int, Answer))
fun example2() {
  mySecret(42, fun() {logger(fun() { input([64,32,48,40,44,42], guess) }) })
}
