# Pi estimation

open import FrescoPrelude;

# Operations
effect Yield(a::Type(Any,Any,Abs)) { Yield : (a) => (); }
effect Await(a::Type(Any,Any,Abs)) { Await : () => a; }
effect Abort { Abort : () => Zero; }
sig yield : forall a::Abs. modal [Yield(a)] ((a) -> ())
fun yield(x) { do Yield(x) }

sig await : forall a::Abs. modal [Await(a)] (() -> a)
fun await() { do Await }

sig abort : forall a. modal [Abort] (() -> a)
fun abort() {
  switch (do Abort) { }
}


# Point type
typename Point = (x:Float, y:Float);

sig makePoint : (Float, Float) -> Point
fun makePoint(x, y) { (x=x, y=y) }

sig insideUnitCircle : (Point) -> Bool
fun insideUnitCircle(p) {
  (p.x *. p.x +. p.y *. p.y) <= 1.0
}

# Streams of random points
sig randomPoints : forall a. modal [Yield(Point), Wild] (() -> a)
fun randomPoints() {
  var p = makePoint(random(), random());
  yield(p);
  randomPoints()
}

# Synchronous take operation
sig take : forall a::Abs,b. modal [Wild] ((Int, modal <Yield(a)> (() -> b)) -> List a)
fun take(n, m) {
  handle <Yield(a)> (m())(n <- n, st <- []) {
    case _ -> st
    case <Yield(x) => resume> ->
       if (n <= 0) st
       else resume((), n-1, x :: st)
  }
}

# Compute pi

sig computePi : forall a. (Int) -> modal [Yield(Float), Wild] (() -> a)
fun computePi(n)() {
  sig loop : modal [Yield(Float), Wild] ((Int, Int) -> a)
  fun loop(total, count) {
     # Synchronously take `n' random points
     var points = take(n, randomPoints);
     # Sanitise the points
     var inside = filter(insideUnitCircle, points);

     var total = total + n;
     var count = count + length(inside);
     var ratio = intToFloat(count) /. intToFloat(total);
     # The area A of a circle is given by the following formula
     #       A = π * r²,
     # hence π = A/r². So, given random points with
     #       x in (0,1), y in (0,1),
     # the ratio of those inside a unit circle should approach π / 4.
     # Therefore, the value of π should be:
     yield(ratio *. 4.0);

     loop(total, count)
  }
  loop(0, 0)
}

# Display pi estimation
sig renderEstimations : (Int) -> modal [Await(Float), Wild] (() -> ())
fun renderEstimations(n)() {
  sig eraser : modal [] ((Int) -> modal [Wild] (() -> ()))
  fun eraser(n)() {
    sig loop : modal [Wild] ((Int) -> ())
    fun loop(n) {
      if (n <= 0) ()
      else { print("\b"); loop(n-1) }
    }
    loop(n)
  }

  sig display : modal [Wild] ((String, Int, Int) -> Int)
  fun display(pi, i, n) {
    var s = "Pi estimation (" ^^ intToString(i) ^^ "/" ^^ intToString(n) ^^ "): " ^^ pi;
    print(s);
    strlen(s)
  }

  sig loop : modal [Await(Float), Wild] ((Int, Int, modal [Wild] (() -> ())) -> ())
  fun loop(i, n, erase) {
    if (i >= n) { print("\n") }
    else {
      var pi = await();
      erase();
      var len = display(floatToString(pi), i+1, n);
      loop(i+1, n, eraser(len))
    }
  }
  var len = display("0.0", 0, n);
  loop(0, n, eraser(len))
}

sig collectEstimations : forall a::Abs. (Int) -> modal [Await(a)] (() -> List a)
fun collectEstimations(n)() {
  sig loop : modal [Await(a)] ((Int, List a) -> List a)
  fun loop(n, acc) {
    if (n <= 0) acc
    else loop(n-1, await() :: acc)
  }
  loop(n, [])
}

# Multi-handler
typename Resumption(a::Any, r::Any) = (a) -> r;
typename Step(a::Any, r::Any) =
  [|Done:r
   |Yielded:(a, Resumption((), Step(a,r)))
   |Awaits:Resumption(a, Step(a,r))|];

# The inner handler leaves Yield to the outer handler. Its resumptions are
# wrapped when they leave that handler, retaining both stream operations.
typename AwaitStep(a::Any, r::Any) =
  [|Done:modal <Yield|> r |Awaits:Resumption(a, AwaitStep(a,r))|];

sig yieldStep : forall a::Abs,b. modal [Wild]
  ((modal <Yield(a)> (() -> AwaitStep(a,b))) -> Step(a,b))
fun yieldStep(f) {
  handle <Yield(a)> (f()) {
    case Done(x) -> Done(x)
    case Awaits(resume) ->
      var next = (fun(x) { ~yieldStep[a,b](fun() { resume(x) }) } : Resumption(a,Step(a,b)));
      Awaits(next)
    case <Yield(x) => resume> -> Yielded(x, resume)
  }
}

sig step : forall a::Abs,b. modal [Wild]
  ((modal <Await(a),Yield(a)> (() -> modal <Await,Yield|> b)) -> Step(a,b))
fun step(f) {
  ~yieldStep[a,b](fun() {
    handle <Await(a)> (f()) {
      case x -> (Done(x) : AwaitStep(a,b))
      case <Await => resume> -> (Awaits(resume) : AwaitStep(a,b))
    }
  })
}

sig exchange : forall a::Abs,b. modal [Wild]
  ((modal <Await(a),Yield(a)> (() -> modal <Await,Yield|> b),
    modal <Await(a),Yield(a)> (() -> modal <Await,Yield|> b)) -> b)
fun exchange(f, g) {
  sig exchange_aux : (Step(a,b), Step(a,b)) -> b
  fun exchange_aux(f, g) {
    switch( (f, g) ) {
      case (Awaits(resume0), Yielded(x, resume1)) ->
        exchange_aux(resume0(x), resume1(()))
      case (Done(x), _) -> x
      case _ -> error("Improper synchronisation")
    }
  }
  exchange_aux(step(f), step(g))
}

# Shallow handler
typename Consumer(a::Type(Any,Any,Abs), b::Any) =
  modal <Abort|Abort,Await(a)> ((a) -> b);
typename Producer(a::Type(Any,Any,Abs), b::Any) =
  modal <Abort|Abort,Yield(a)> (() -> b);

mutual {
  sig copipe : forall a::Abs,b,c. modal [Abort, Wild]
    ((Consumer(a,modal <Await|> b), Producer(a,c)) -> b)
  fun copipe(receiver, sender) {
    shallowhandle <Yield(a)> (sender()) {
      case _ -> abort()
      case <Yield(x) -> resume> -> pipe(fun() { resume(()) }, fun() { receiver(x) })
    }
  }

  sig pipe : forall a::Abs,b,c. modal [Abort, Wild]
    ((Producer(a,c), modal <Await(a)> (() -> modal <Await|> b)) -> b)
  fun pipe(sender, receiver) {
    shallowhandle <Await(a)> (receiver()) {
      case x -> x
      case <Await -> resume> -> copipe(resume, sender)
    }
  }
}

sig catch : forall a. modal [Wild]
  ((modal <Abort> (() -> modal <Abort|> a)) -> a)
fun catch(m) {
  handle(m()) {
    case x -> x
    case <Abort> -> error("Caught abort")
  }
}


sig example : modal [Wild] ((Int) -> ())
fun example(n) {
  catch(fun() {
    var sender = ~computePi[()](30000);
    var receiver = renderEstimations(n);
    var result = ~pipe[Float,(),()](fun() { sender() }, fun() { receiver() });
    result
  })
}

sig unitTest : modal [Wild] (() -> List Float)
fun unitTest() {
  catch(fun() {
    var sender = ~computePi[()](30000);
    var receiver = ~collectEstimations[Float](5);
    var result = ~pipe[Float,List Float,()](fun() { sender() }, fun() { receiver() });
    result
  })
}
