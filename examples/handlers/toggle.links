# Toggle on/off

# State operations
effect State(s::Abs) { Get : () => s; Put : (s) => (); }

sig get : forall s::Abs. [State(s)] (() -> s)
fun get() {do Get}

sig put : forall s::Abs. [State(s)] ((s) -> ())
fun put(st) {do Put(st)}

# Stateful computation
sig toggle : [State(Bool)] (() -> Bool)
fun toggle() {
  var bit = get();
  put(not(bit));
  get()
}

# State handler
sig runState : forall s::Abs,a::Abs. (<State(s)> (() -> a)) -> (s) -> () -> (a,s)
fun runState(m)(st)() {
  var run = handle(m()) {
    case x      -> fun(ret_st) { (x,ret_st) }
    case <Get => resume>    -> fun(get_st) { resume(get_st)(get_st) }
    case <Put(put_st) => resume> -> fun(ignored_st)  { resume(())(put_st) }
  };
  run(st)
}

runState(toggle)(false)()
