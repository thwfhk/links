# A port of the simple counting benchmark from Kammar et al. (2013)

effect State(s::Abs) { Get : () => s; Put : (s) => (); }

sig evalState : forall s::Abs,a::Abs. (<State(s)> (() -> a)) -> (s) -> a
fun evalState(m)(st) {
  var run =
    handle(m()) {
      case x      -> fun(_) { x }
      case <Get() => resume>     -> fun(st) { resume(st)(st) }
      case <Put(st) => resume> -> fun(s) { resume(())(st) }
    };
  run(st)
}

sig count : [State(Int)] (() -> Int)
fun count() {
  var n = do Get();
  if (n == 0) n
  else { do Put(n-1); count() }
}

evalState(count)(100)
