# Choice example.
# links> enumerate(choice);

effect Choice { Choose : () => Bool; }

# The choice computation
sig choice : [Choice] (() -> Int)
fun choice() {
  var x = if (do Choose()) { 2 }
          else { 4 };
  var y = if (do Choose()) { 8 }
          else { 16 };
  x + y
}

#
# A few (closed) handlers
#

# The "positive" handler
sig positive : forall a::Abs. (<Choice> (() -> a)) -> () -> a
fun positive(m)() {
  handle(m()) {
    case <Choose => k> -> k(true)
    case x   -> x
  }
}

# The "I'll-take-everything" handler
sig enumerate : forall a::Abs. (<Choice> (() -> a)) -> () -> List a
fun enumerate(m)() {
  handle(m()) {
    case <Choose => k> -> k(true) ++ k(false)
    case x -> [x]
  }
}
