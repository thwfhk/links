# Transaction example
# Run example() to see three interleaved bank transfers.

# Queue API
typename Queue(a) = (List a, List a);


sig enqueue : (a, Queue(a)) -> Queue(a)
fun enqueue(x, (rear, front)) {
  (x :: rear, front)
}

sig dequeue : (Queue(a)) -> (Maybe(a), Queue(a))
fun dequeue(q) {
  switch (q) {
    case ([], []) -> (Nothing, q)
    case (rear, x :: front) -> (Just(x), (rear, front))
    case (rear, [])         -> dequeue( ([], reverse(rear)) )
  }
}

typename Account = (String, Int);
typename Bank = List Account;

effect State(s::Abs) { Get : () => s; Put : (s) => (); }
effect Abort { Abort : () => Zero; }

effect Cooperative {
  Fork : ([wild, State(Bank), Cooperative] (() -> ())) => ();
  Yield : () => ();
}

typename Co = [wild, State(Bank), Cooperative] (() -> ());
typename RunQueue = mu q . (Queue((q) -> ()));

sig yield : [Cooperative] (() -> ())
fun yield() { do Yield }

sig fork : [Cooperative] ((Co) -> ())
fun fork(f) { do Fork(f) }

sig schedule : [wild, State(Bank)] ((Co) -> ())
fun schedule(main) {
  sig runNext : (RunQueue) -> ()
  fun runNext(q) {
    switch (dequeue(q)) {
      case (Nothing, _) -> ()
      case (Just(resume), q) -> resume(q)
    }
  }

  sig withThreads : (Co, RunQueue) -> ()
  fun withThreads(f, q) {
    (handle(f()) {
      case () -> fun (q) { runNext(q) }
      case <Yield => resume> ->
        fun (q) { runNext(enqueue(fun (q) { resume(())(q) }, q)) }
      case <Fork(f) => resume> ->
        fun (q) { withThreads(f, enqueue(fun (q) { resume(())(q) }, q)) }
    })(q)
  }

  withThreads(main, ([], []))
}

# State API
sig get : forall s::Abs. [State(s)] (() -> s)
fun get() { do Get }

sig put : forall s::Abs. [State(s)] ((s) -> ())
fun put(st) { do Put(st) }

sig runState : forall s::Abs,a::Abs. (<State(s)> (() -> a), s) -> (a, s)
fun runState(m, st) {
  handle(m())(st <- st) {
    case x      -> (x, st)
    case <Get => resume>    -> resume(st, st)
    case <Put(p) => resume> -> resume((), p)
  }
}

# Transaction handler
sig abort : [Abort] (() -> a)
fun abort() {
  switch (do Abort) { }
}

sig beginTransaction :
  [State(Bank)] ((<State(Bank), Abort> (() -> ())) -> (Bank, String))
fun beginTransaction(m) {
  handle(m())([alice, bob] as st <- (get() : Bank)) {
    case () -> put(st); (st, "Done")
    case <Abort> -> (get(), "Aborted")
    case <Get => resume> -> resume(get(), st)
    case <Put([acc]) => resume> ->
       if (acc.1 == "Alice")
          resume((), [acc, bob])
       else
          resume((), [alice, acc])
  }
}

sig accounts : Bank
var accounts = [("Alice", 100), ("Bob", 25)];

# Transfer
sig transfer : [Abort, Cooperative, State(Bank)] ((Bool, Int, String, String) -> ())
fun transfer(delay, amount, src, dest) {
  fun upd(account) {
    var accounts = filter(fun(a) { a.1 <> account.1 }, get());
    put([account])
  }
  fun add(amount, acc) {
     switch (lookup(acc, get())) {
       case Nothing -> error("Unknown account")
       case Just(n) -> upd((acc, n + amount))
     }
  }
  fun deduct(amount, acc) {
     switch (lookup(acc, get())) {
       case Nothing -> error("Unknown account")
       case Just(n) ->
         if (n - amount >= 0) upd((acc, n - amount))
         else abort()
     }
  }
  add(amount, dest);
  ignore(if (delay) yield() else ());
  deduct(amount, src)
}

sig example : [wild] (() -> ((), Bank))
fun example() {
  sig main : Co
  fun main() {
     fork(fun() {
       var (_, result) = beginTransaction(fun() {
          transfer(true, 100, "Alice", "Bob")
       });
       println("Transaction [100, Alice -> Bob]: " ^^ result)
     });
     fork(fun() {
       var (_,result) = beginTransaction(fun() {
          transfer(false, 25, "Alice", "Bob")
       });
       println("Transaction [25, Alice -> Bob]: " ^^ result)
     });
     fork(fun() {
       var (_,result) = beginTransaction(fun() {
          transfer(true, 50, "Bob", "Alice")
       });
       println("Transaction [50, Bob -> Alice]: " ^^ result)
     })
  }
  runState(fun() { schedule(main) }, accounts)
}
