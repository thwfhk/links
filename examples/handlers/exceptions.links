# Resumable exceptions
#
#   Program idea: Small calculator program which sums user supplied
#                 integers. (Links supports only user input via web
#                 forms, so we simulate inputs in this example)
#

effect Input { Input : (String) => Int; }
effect Failure { Fail : (String) => Int; }

# Simulation of input via prompt
sig input : [Input, wild] ((String) -> Int)
fun input(s) {println(s); do Input(s)}

# Computation summing (simulated) user supplied integers
sig sumUp : [Input, wild] (() -> Int)
fun sumUp() {
  sum([input("10"), input("20"), input("MMXVII"), input("30")])
}

# Fail operation to signal conversion failure
sig fail : [Failure] ((String) -> Int)
fun fail(e) {do Fail(e)}

# String to integer conversion
sig parseInt : [Failure] ((String) -> Int)
fun parseInt(s) {
  if (isInt(s)) stringToInt(s)
  else fail(s)
}

# Input handling
sig prompt : forall a::Abs. [Failure] ((<Input> (() -> a)) -> () -> a)
fun prompt(m)() {
  handle(m()) {
    case x   -> x
    case <Input(n) => k>  -> k(parseInt(n))
  }
}

# Standard exception handling
sig catchFail : forall a::Abs. (<Failure> (() -> a)) -> () -> a
fun catchFail(m)() {
  handle(m()) {
    case x -> x
    case <Fail(s)> -> error("Conversion failure: " ^^ s)
  }
}

sig printResult : [wild] ((() -> Int) -> ())
fun printResult(m) {
  handle(m()) {
    case x -> println("Sum is " ^^ intToString(x))
  }
}

# Example 1
sig example1 : [wild] (() -> ())
fun example1() {
  printResult(catchFail(fun() { prompt(sumUp)() }))
}

# Resumable exceptions
sig catchResume : forall a::Abs. [wild] ((<Failure> (() -> a)) -> () -> a)
fun catchResume(m)() {
  handle(m()) {
    case x -> x
    case <Fail(s) => k> -> println("Conversion failure: " ^^ s); k(0)
  }
}

# Example 2
sig example2 : [wild] (() -> ())
fun example2() {
  printResult(catchResume(fun() { prompt(sumUp)() }))
}

# Unit test
sig sumUpSilently : [Input] (() -> Int)
fun sumUpSilently() {
  fun input(s) {do Input(s)}
  sum([input("10"), input("20"), input("MMXVII"), input("30")])
}

fun unitTest() {
  handle(prompt(sumUpSilently)()) {
    case <Fail(_) => k> -> k(0)
    case (x : Int) -> x
  }
}
