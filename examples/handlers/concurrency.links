#
# Cooperative concurrency
#

effect Cooperative {
  Fork : ([wild, Cooperative] (() -> ())) => ();
  Yield : () => ();
}

typename Co = [wild, Cooperative] (() -> ());

## cooperative concurrency interface
sig fork : [Cooperative] ((Co) -> ())
fun fork(p) {do Fork(p)}

sig yield : [Cooperative] (() -> ())
fun yield() {do Yield}

# example abstract concurrent computation
sig test : Co
fun test() {
  println("M1 ");
  fork(fun () {println("A1 "); yield(); println ("A2 ")});
  println("M2 ");
  yield();
  fork(fun () {println("B1 "); yield(); println ("B2 ")});
  yield();
  println("M3 ");
  yield();
  println("\n")
}

## Scheduler queues

typename Queue(a) = (List a, List a);
typename RunQueue = mu q . (Queue((q) -> ()));

sig enqueueProcess : (a, Queue(a)) -> Queue(a)
fun enqueueProcess(x, (front, back)) { (front, x :: back) }

sig dequeueProcess : (Queue(a)) -> (Maybe(a), Queue(a))
fun dequeueProcess(q) {
  switch (q) {
    case ([], []) -> (Nothing, q)
    case ([], back) -> dequeueProcess((reverse(back), []))
    case (x :: front, back) -> (Just(x), (front, back))
  }
}

sig runNext : [wild] ((RunQueue) -> ())
fun runNext(q) {
  switch (dequeueProcess(q)) {
    case (Nothing, _) -> ()
    case (Just(task), q) -> task(q)
  }
}

# Defer forked processes.
sig scheduleBreadthFirst : [wild] ((Co) -> (RunQueue) -> ())
fun scheduleBreadthFirst(m) {
  handle(m()) {
    case <Yield => k> -> fun (q) {
      runNext(enqueueProcess(fun (q) { k(())(q) }, q))
    }
    case <Fork(p) => k> -> fun (q) {
      k(())(enqueueProcess(scheduleBreadthFirst(p), q))
    }
    case () -> runNext
  }
}

# Run forked processes immediately.
sig scheduleDepthFirst : [wild] ((Co) -> (RunQueue) -> ())
fun scheduleDepthFirst(m) {
  handle(m()) {
    case <Yield => k> -> fun (q) {
      runNext(enqueueProcess(fun (q) { k(())(q) }, q))
    }
    case <Fork(p) => k> -> fun (q) {
      scheduleDepthFirst(p)(enqueueProcess(fun (q) { k(())(q) }, q))
    }
    case () -> runNext
  }
}

# Randomly choose when to run a forked process.
sig scheduleRandom : [wild] ((Co) -> (RunQueue) -> ())
fun scheduleRandom(m) {
  handle(m()) {
    case <Yield => k> -> fun (q) {
      runNext(enqueueProcess(fun (q) { k(())(q) }, q))
    }
    case <Fork(p) => k> -> fun (q) {
      if (random() < 0.5) {
        k(())(enqueueProcess(scheduleRandom(p), q))
      } else {
        scheduleRandom(p)(enqueueProcess(fun (q) { k(())(q) }, q))
      }
    }
    case () -> runNext
  }
}

effect ProcessQueue(a::Abs) {
  Enqueue : (a) => ();
  Dequeue : () => Maybe(a);
}

sig enqueue : forall a::Abs. [ProcessQueue(a)] ((a) -> ())
fun enqueue(x) { do Enqueue(x) }

sig dequeue : forall a::Abs. [ProcessQueue(a)] (() -> Maybe(a))
fun dequeue() { do Dequeue }

## queue implementation using a zipper
sig zipQueue : forall s::Abs,a::Abs. (<ProcessQueue(s)> (() -> a)) -> () -> a
fun zipQueue(m)() {
  handle(m())((front, back) <- ([], [])) {
    case <Enqueue(x) => k> -> k((),(front, x :: back))
    case <Dequeue => k>    ->
      switch ((front, back)) {
        case ([], [])   -> k(Nothing,([], []))
        case ([], back) -> var (x::front) = reverse(back);
                           k(Just(x),(front, []))
        case (x::front, back) ->
                           k(Just(x),(front, back))
      }
    case x -> x
  }
}


