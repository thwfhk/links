#
# Cooperative concurrency with first-order algebraic effects
#

open import FrescoPrelude;

typename Two = Bool;
typename One = ();

effect Coop {
  Fork : () => Two;
  Yield : () => One;
  Stop : () => Zero;
}

# type of a concurrent computation
typename Co(a::Any) = modal <Coop> (() -> modal <Coop|> a);

## cooperative concurrency interface
sig fork : modal [Coop] (() -> Two)
fun fork() {do Fork}

sig yield : modal [Coop] (() -> One)
fun yield() {do Yield}

sig stop : forall a. modal [Coop] (() -> a)
fun stop() {switch (do Stop) { }}

# in fact `Yield` is redundant: we could use
# yield() == if(fork()) {stop()} else {()}

# example abstract concurrent computation
sig test : modal [Wild] (Co(One))
fun test() {
  print("M1 ");
  if(fork()) { print("A1 "); yield(); print ("A2 "); stop() } else {
    print("M2 ");
    yield();
    print("M3 ");
    if(fork()) { print("B1 "); yield(); print ("B2 "); stop() } else {
      print("M4 ");
      yield();
      print("M5 ");
      print("\n");
      stop()
    }
 }
}

typename Queue(a::Any, r::Row(Any,Any)) =
  [|Cons:(a, Queue(a,{ |r}))|Nil|r|];

# a resumption takes an initial list of resumptions and if one of them
# yields a value returns a pair of the value and a list of unfinished
# resumptions
mutual {
  typename Res(a::Any) = (ResList(a)) -> Maybe ((a, ResList(a)));
  typename ResList(a::Any) = Queue(Res(a),{});
}

# Links (following OCaml) only infers recursive types when all
# recursive type variables are guarded by a variant or record
# constructor. This means it is more convenient to define Res mutually
# recursively with a bespoke list type rather than using the standard
# list type - otherwise we would need to add a number of type
# annotations inside the body of coop.

sig snoc : forall a::Any, r::Row(Any,Any).
  (Queue(a,{}), a) -> Queue(a,{ |r})
fun snoc(rs, r) {
  switch (rs) {
    case Nil             -> Cons(r, Nil)
    case (Cons (r', rs)) -> Cons(r', snoc(rs, r))
  }
}

sig coop : forall a. modal [Wild] ((Co(a)) -> Res(a))
fun coop(m) {
  ((handle(m()) {
    case x            -> fun (rs) {Just ((x, rs))}
    case <Fork => k>  -> fun (rs) {
                           var next = fun(rs:ResList(a)) {k(false)(rs)};
                           k(true)(snoc(rs, next))
                         }
    case <Yield => k> -> fun (rs) {
                           switch (rs) {
                             case Nil         -> k(())(Nil)
                             case Cons(r, rs) ->
                               var next = fun(rs:ResList(a)) {k(())(rs)};
                               r(snoc(rs, next))
                           }
                         }
    case <Stop>       -> fun (rs) {
                           switch (rs) {
                             case Nil         -> Nothing
                             case Cons(r, rs) -> r(rs)
                           }
                         }
  }) : (ResList(a)) -> Maybe ((a, ResList(a))))
}

sig run : forall a. modal [Wild] ((Co(a)) -> Maybe ((a, ResList(a))))
fun run(m) {
  coop(m)(Nil)
}
