typename Zero = (| |);

effect Choice { Choice : (()) => Bool; }
effect Failure { Failure : (()) => Zero; }
effect Rand { Rand : (()) => Float; }

sig choice : [Choice] (() -> Bool)
fun choice() {do Choice(())}

sig choose : [Choice] ((a, a) -> a)
fun choose(x,y) {if (choice()) {x} else {y}}

sig fail : [Failure] (() -> a)
fun fail() {switch (do Failure(())) { }}

sig allResults : forall a::Abs. (<Choice, Failure> (() -> a)) -> List a
fun allResults(m) {
  handle(m()) {
    case x     -> [x]
    case <Choice(()) => k>  -> k(true) ++ k(false)
    case <Failure(()) => k> -> []
  }
}

typename Toss = (|Heads|Tails|);

sig drunkToss : [Choice, Failure] (() -> Toss)
fun drunkToss() {
  if (choice()) {
    choose(Heads, Tails)
  } else {
    fail()
  }
}

sig drunkTosses : (Int) -> [Choice, Failure] (() -> List Toss)
fun drunkTosses(n)() {
  for (_ <- [1..n]) [drunkToss()]
}

sig rand : [Rand] (() -> Float)
fun rand() {do Rand(())}

sig randomResult :
  forall a::Abs. [Rand] ((<Choice> (() -> a)) -> () -> a)
fun randomResult(m)() {
  handle(m()) {
    case x    -> x
    case <Choice(()) => k> -> k (rand() < 0.5)
  }
}

sig persevere : forall a::Abs. (<Failure> (() -> a)) -> () -> a
fun persevere(m)() {
  handle(m()) {
    case x     -> x
    case <Failure(()) => k> -> persevere(m)()
  }
}

sig maybeResult : forall a::Abs. (<Failure> (() -> a)) -> () -> Maybe(a)
fun maybeResult(m)() {
  handle(m()) {
    case x     -> Just(x)
    case <Failure(()) => k> -> Nothing
  }
}

sig handleRandom : forall a::Abs. [wild] ((<Rand> (() -> a)) -> a)
fun handleRandom(m) {
  handle(m()) {
    case x  -> x
    case <Rand(()) => k> -> k (random())
  }
}

sig sampleMaybe : forall a::Abs. [wild] (([Choice, Failure, Rand, wild] (() -> a)) -> Maybe(a))
fun sampleMaybe(m) {
  handleRandom(fun() { maybeResult(fun() { randomResult(m)() })() })
}

sig sampleMaybe2 : forall a::Abs. [wild] (([Choice, Failure, Rand, wild] (() -> a)) -> Maybe(a))
fun sampleMaybe2(m) {
  handleRandom(fun() { randomResult(fun() { maybeResult(m)() })() })
}

sig sample : forall a::Abs. [wild] (([Choice, Failure, Rand, wild] (() -> a)) -> a)
fun sample(m) {
  handleRandom(fun() { persevere(fun() { randomResult(m)() })() })
}

sig sample2 : forall a::Abs. [wild] (([Choice, Failure, Rand, wild] (() -> a)) -> a)
fun sample2(m) {
  handleRandom(fun() { randomResult(fun() { persevere(m)() })() })
}

allResults(drunkTosses(3))
#sampleMaybe(drunkTosses(2))
#sampleMaybe2(drunkTosses(2))
#sample(drunkTosses(5))
#sample2(drunkTosses(5))
