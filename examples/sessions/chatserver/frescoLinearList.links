typename LinList(a::Type(Any,Any,Any)) = [| LinNil | LinCons: (a, LinList(a)) |];

# Maps a function over all channels
sig linMap : forall s::Type(Any,Session,Any).
  ((s) -> s, LinList(s)) -> LinList(s)
fun linMap(f, chans) {
  switch(chans) {
    case LinNil -> LinNil
    case LinCons(ch, chs) -> LinCons(f(ch), (linMap(f, chs)))
  }
}

