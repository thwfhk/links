typename State(a::Type(Any,Any,Abs)) = AP (!a.End);

sig newCell : forall a::Type(Any,Any,Abs). modal [Wild] ((a) -> State(a))
fun newCell(v) {
  var x = new();
  var _ = spawn {close(send(v, accept(x)))};
  x
}

sig put : forall a::Type(Unl,Any,Abs). modal [Wild] ((State(a), a) -> ())
fun put(x, v) {
  var (_, s) = receive(request(x));
  close(s);
  var _ = spawn {close(send(v, accept(x)))};
  ()
}

sig get : forall a::Type(Unl,Any,Abs). modal [Wild] ((State(a)) -> a)
fun get(x) {
  var (v, s) = receive(request(x));
  close(s);
  var _ = spawn {close(send(v, accept(x)))};
  v
}

# an atomic swap operation
sig swap : forall a::Type(Any,Any,Abs). modal [Wild] ((State(a), a) -> a)
fun swap(x, w) {
  var (v, s) = receive(request(x));
  close(s);
  var _ = spawn {close(send(w, accept(x)))};
  v
}

# Landin's knot - this function loops forever
typename Action = modal [Wild] (() -> ());
sig forever : modal [Wild] (() -> ())
fun forever() {
  var x = ~newCell[Action](fun () {()});
  ~put[Action](x, fun () {~get[Action](x)()});
  ~get[Action](x)()
}


