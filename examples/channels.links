typename Channel (a::Any) = (modal [Wild] (() -> a), modal [Wild] ((a) -> ()));

sig newChannel : forall a::Type(Unl,Any,Abs). modal [Wild] (() -> Channel(a))
fun newChannel() {
  var p =
    spawn {
      sig step : modal [Wild, Receive([|Value:a|Read:Process(a)|])]
        ((List(a), List(Process(a))) -> ())
      fun step(vs, readers) {
        receive {
          case Value(v) ->
            var (v :: vs) = vs ++ [v];
            switch (readers) {
              case [] -> step (v :: vs, readers)
              case (r :: readers) -> r ! v; step (vs, readers)
            }
          case Read(r) ->
            var (r :: readers) = readers ++ [r];
            switch (vs) {
              case [] -> step (vs, r :: readers)
              case (v :: vs) -> r ! v; step (vs, readers)
            }
        }
      }
      step([], [])
    };

  sig write : modal [Wild] ((a) -> ())
  fun write(v) {
    p ! Value(v)
  }

  sig read : modal [Wild] (() -> a)
  fun read() {
    spawnWait {
      p ! Read(~self[a]());
      receive { case v -> v }
    }
  }

  (read, write)
}

sig get : forall a. modal [Wild] ((Channel(a)) -> a)
fun get ((read, _)) { read() }

sig put : forall a. modal [Wild] ((Channel(a), a) -> ())
fun put((_, write), v) { write(v) }
