# From "Extensible Programming with First-Class Cases"
# Matthias Blume et al
# ICFP 2006


sig add_A : forall r::Row(Any,Any).
  (([|A- |r|]) -> String) -> ([|A:()|r|]) -> String
fun add_A(f) (e) {
  switch (e) {
    case A -> "A"
    case -A as x -> f(x)
  }
}

sig add_B : forall r::Row(Any,Any).
  (([|B- |r|]) -> String) -> ([|B:()|r|]) -> String
fun add_B(f) (e) {
  switch (e) {
    case B -> "B"
    case -B as x -> f(x)
  }
}


sig add_C : forall r::Row(Any,Any).
  (([|C- |r|]) -> String) -> ([|C:()|r|]) -> String
fun add_C(f) (e) {
  switch (e) {
    case C -> "C"
    case -C as x -> f(x)
  }
}

sig defaultCase : forall rho::Row.
  (([|rho|]) -> String) -> ([|rho|]) -> String
fun defaultCase(f:(([|rho|]) -> String)) {
  f
}

sig nocases : forall a::Any. ([||]) -> a
fun nocases(e:[||]) {
  switch (e) { }      # unreachable
}


sig sub_A : forall a,rho::Row,b::Any.
  (([|A:a|rho|]) -> b) -> ([|A- |rho|]) -> b
fun sub_A(f)(e) {
  f(e : [|A:a|rho|] <- [|A- |rho|])
}

var f = add_A(add_B(add_C(nocases)));

(f(A), f(B), f(C))


