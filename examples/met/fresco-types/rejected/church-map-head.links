# The element type of the nested Church fold cannot be inferred.

typename Church(a) = forall b. b -> (a -> b -> b) -> b;

sig churchMap : forall a, b. (a -> b) -> Church(a) -> Church(b)
fun churchMap(f)(xs) {
  fun(z)(step) { xs(z)(fun(x)(acc) { step(f(x))(acc) }) }
}

sig churchHead : forall a. Church(a) -> a
fun churchHead(xs) {
  var Just(x) = xs(Nothing)(fun(x)(_) { Just(x) });
  x
}

sig churchSingle : forall a. a -> Church(a)
fun churchSingle(x) { fun(z)(step) { step(x)(z) } }

typename Id = forall a. [] (a -> a);

sig ident : forall a. [] (a -> a)
fun ident(x) { x }

sig churchIds : Church(Id)
var churchIds = fun(z)(step) { step(~ident)(step(~ident)(z)) };

churchMap(churchHead)(churchSingle(churchIds))
