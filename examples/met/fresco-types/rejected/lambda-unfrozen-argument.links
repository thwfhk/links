# The lambda needs an argument with a retained forall.

sig app : forall a, b. (a -> b) -> a -> b
fun app(f)(x) { f(x) }

typename Id = forall a. [] (a -> a);

sig poly : Id -> (Int, Bool)
fun poly(f) { (f(42), f(true)) }

sig ident : forall a. [] (a -> a)
fun ident(x) { x }

(fun(f) { app(poly)(f) })(ident)
