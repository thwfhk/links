# SMTP 4 - At least one recipient

open import FrescoPrelude;

typename Address = String;
typename Accept = String;
typename Message = String;
typename Error = String;


mutual {
  typename SMTPServer =
    [&|MAIL:?Address.
            [+|REJECT:!Error.SMTPServer,
               ACCEPT:!Accept.SMTPFirstRecipient|+],
       QUIT:EndBang|&];

  typename SMTPFirstRecipient =
    [&|RCPT:?Address.
            [+|REJECT:!Error.SMTPFirstRecipient,
               ACCEPT:!Accept.SMTPRecipients|+]|&];

  typename SMTPRecipients =
    [&|RCPT:?Address.
            [+|REJECT:!Error.SMTPRecipients,
               ACCEPT:!Accept.SMTPRecipients|+],
       DATA:?Message.!Accept.SMTPServer|&];
}

# Returns true, if the given String is a valid e-mail address.
sig isValid : modal [Wild] ((String) -> Bool)
fun isValid(address) {
  address =~ /.[a-z0-9]+.@.[a-z]+.[a-z]+/ # Regex to match 1+characters/numbers @ 1+characters . 1+characters
}

mutual {
  sig mailServer : modal [Wild] ((SMTPServer) -> EndBang)
  fun mailServer(s) {
    outer(s)
  }

  sig outer : modal [Wild] ((SMTPServer) -> EndBang)
  fun outer(s) {
    offer(s) {
      case MAIL(s) ->
        var (address, s) = receive(s);
        println("S: received address as FROM: " ^^ address);
        if (isValid(address)) {
          var s = send("250 OK", select ACCEPT s);
          rcptLoop(s)
        }
        else {
          var s = send("Invalid e-mail.", select REJECT s);
          outer(s)
        }
      case QUIT(s) ->
        s
    }
  }

  sig rcptLoop : modal [Wild] ((SMTPFirstRecipient) -> EndBang)
  fun rcptLoop(s) {
    offer(s) {
      case RCPT(s) ->
        var (recipient, s) = receive(s);
        println("S: received address as TO: " ^^ recipient);
        if (isValid(recipient)) {
          var s = send("250 OK", select ACCEPT s);
          inner(s)
        }
        else {
          var s = send("S: Invalid e-mail.", select REJECT s);
          rcptLoop(s)
        }
    }
  }


  sig inner : modal [Wild] ((SMTPRecipients) -> EndBang)
  fun inner(s) {
    offer(s) {
      case RCPT(s) ->
        var (recipient, s) = receive(s);
        println("S: received address as TO: " ^^ recipient);
        if (isValid(recipient)) {
          var s = send("250 OK", select ACCEPT s);
          inner(s)
        }
        else {
          var s = send("S: Invalid e-mail.", select REJECT s);
          inner(s)
        }
      case DATA(s) ->
        var (message, s) = receive(s);
        println("S: received message: " ^^ message);
        var s = send("250 OK", s);
        outer(s)
    }
  }
}

mutual {
  sig mailClient : modal [Wild] ((~SMTPServer) -> ())
  fun mailClient(c) {
    outerClient(c)
  }


  sig outerClient : modal [Wild] ((~SMTPServer) -> ())
  fun outerClient(c) {
    var c = send("starlight@domain.com", select MAIL c);
    offer (c) {
      case REJECT(c) ->
        var (error, c) = receive(c);
        println("C: client sent MAIL, server replied: " ^^ error);
        outerClient(c)

      case ACCEPT(c) ->
        var (reply, c) = receive(c);
        println("C: client sent MAIL, server replied: " ^^ reply);
        rcptLoopClient(c)
    }
  }

  sig innerClient : modal [Wild] ((~SMTPRecipients, Bool) -> ())
  fun innerClient(c, addRcpt) {
    # Either one more recipient or data
    if (addRcpt) {
      addRecipient(c)
    }
    else {
      addData(c)
    }
  }

  sig addData : modal [Wild] ((~SMTPRecipients) -> ())
  fun addData(c) {
    var c = send("Hello to bravest warriors!", select DATA c);
    var (reply, c) = receive(c);
    println("C: client sent DATA, server replied: " ^^ reply);
    var c = select QUIT c;
    wait(c);
    ()
  }

  sig addRecipient : modal [Wild] ((~SMTPRecipients) -> ())
  fun addRecipient(c) {
    var c = send("pink@cloud", select RCPT c);
    offer (c) {
      case REJECT(c) ->
        var (error, c) = receive(c);
        println(error);
        innerClient(c, false)
      case ACCEPT(c) ->
        var (reply, c) = receive(c);
        println("C: client sent RCPT, server replied: " ^^ reply);
        innerClient(c, false)
    }
  }

  sig rcptLoopClient : modal [Wild] ((~SMTPFirstRecipient) -> ())
  fun rcptLoopClient(c) {
    var c = send("friend@galaxy.com", select RCPT c);
    offer(c) {
      case REJECT(c) ->
        var (error, c) = receive(c);
        rcptLoopClient(c)
      case ACCEPT(c) ->
        var (reply, c) = receive(c);
        println("C: client sent RCPT, server replied: " ^^ reply);
        innerClient(c, true)
    }
  }
}

sig main : modal [Wild] (() -> ())
fun main() {
  mailClient(forkSync(mailServer))
}

main()
