fun completions(pre) {
  var wordlist = table "wordlist" with (
    word : String,
    type : String,
    meaning : String
  ) from (database "dictionary");

  debug("pre: " ^^ pre);

  if (pre == "") []
  else {
    query [10] {
      for (w <-- wordlist)
       where (w.word =~ /^{pre}.*/)
       orderby (w.word)
        [w]
    }
  }
}

completions("a")
